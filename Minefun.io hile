            this.ofsetY = 0;
            this._surukleHareket = (e) => {
                if (this.surukleme && this.ui) {
                    this.ui.style.left = (e.clientX - this.ofsetX) + "px";
                    this.ui.style.top = (e.clientY - this.ofsetY) + "px";
                }
            };
