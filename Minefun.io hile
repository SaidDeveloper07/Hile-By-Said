            document.body.style.setProperty("--nv-accent-solid", this.ayarlar["Vurgu Rengi 1"]);
            let g = this.ayarlar["Vurgu Rengi 1"];
            if (g.includes("rgba")) { let l = g.lastIndexOf(','); g = g.substring(0, g.lastIndexOf(',') + 1) + '0.4)'; } else { g = g.replace(")", ",0.4)"); }
            document.body.style.setProperty("--nv-accent-glow", g);
            document.body.style.setProperty("--button-color", "rgba(255,255,255,0.06)");
            document.body.style.setProperty("--hover-color", `${MOR.neon}33`);
            document.body.style.setProperty("--header-bg", this.ayarlar["Başlık Rengi"]);
            document.body.style.setProperty("--panel-bg", this.ayarlar["Panel Rengi"]);
            document.body.style.setProperty("--nv-text", this.ayarlar["Metin Rengi"]);
        }
        acildi() {
            if (document.pointerLockElement) document.exitPointerLock();
            if (this.guiYuklendi) {
                this.gosterGUI();
                this.animasyonGuncelle();
            } else {
                this.arkaplanKur();
                this.panellerOlustur();
                this.olaylariKur();
                this.guiYuklendi = true;
                this.animasyonGuncelle();
            }
            let kural = oyunYardim.cssKuraliBul(".pause-cont");
            if (kural) kural.style.display = "none";
            this.canvasDuzenle();
        }
        canvasDuzenle() {
            let canvas = document.querySelector("#game");
            if (canvas) canvas.dispatchEvent(new Event("resize", { bubbles: true }));
        }
        arkaplanKur() {
            this.bulanikArkaplan = document.createElement("div");
            this.bulanikArkaplan.className = "nv-overlay";
            this.bulanikArkaplan.style.cssText = `
                position: fixed;
                left: 0;
                top: 0;
                z-index: 999;
                width: 100%;
                height: 100%;
                backdrop-filter: blur(8px) saturate(1.2);
                -webkit-backdrop-filter: blur(8px) saturate(1.2);
                background: rgba(0,0,0,0.25);
                animation: saidFadeIn 0.3s ease;
                display: none;
            `;
            document.body.appendChild(this.bulanikArkaplan);
        }
        panellerOlustur() {
            let kategoriler = [
                { baslik: "Combat", konum: { top: "100px", left: "100px" } },
                { baslik: "Movement", konum: { top: "100px", left: "305px" } },
                { baslik: "Visual", konum: { top: "100px", left: "510px" } },
                { baslik: "Misc", konum: { top: "100px", left: "715px" } },
                { baslik: "Menus", konum: { top: "100px", left: "920px" } },
                { baslik: "Fun", konum: { top: "100px", left: "1125px" } },
                { baslik: "World", konum: { top: "100px", left: "1330px" } },
                { baslik: "AntiBan", konum: { top: "100px", left: "1330px" } }
            ];
            this.paneller.forEach(p => { if (p.panel && p.panel.parentNode) p.panel.parentNode.removeChild(p.panel); });
            this.paneller = [];
            kategoriler.forEach(k => { this.paneller.push(new Panel(k.baslik, k.konum)); });
            let harita = {};
            Object.values(moduller).forEach(mod => {
                if (!harita[mod.kategori]) harita[mod.kategori] = [];
                harita[mod.kategori].push(mod);
            });
            Object.entries(harita).forEach(([isim, modlar]) => {
                let panel = this.paneller.find(p => p.kategori === isim);
                if (panel) {
                    modlar.sort((a, b) => b.isim.length - a.isim.length);
                    modlar.forEach(mod => panel.butonEkle(mod));
                }
            });
        }
        olaylariKur() {
            olaylar.on("modul.guncelle", (modul) => {
                let panel = this.paneller.find(p => p.kategori === modul.kategori);
                if (!panel) return;
                let buton = panel.butonlar.find(b => {
                    let ad = b.querySelector('.said-buton-adi');
                    return ad && ad.textContent === modul.isim;
                });
                if (buton) {
                    buton.classList.toggle("aktif", modul.aktif);
                    let durum = buton.querySelector('.said-durum');
                    if (durum) {
                        durum.style.background = modul.aktif ? MOR.neon : 'rgba(255,255,255,0.15)';
                        durum.style.boxShadow = modul.aktif ? `0 0 10px ${MOR.neon}66` : 'none';
                    }
                    let gosterge = buton.querySelector('.said-gosterge');
                    if (gosterge) {
                        gosterge.style.background = modul.aktif ? MOR.neon : 'rgba(255,255,255,0.1)';
                        gosterge.style.boxShadow = modul.aktif ? `0 0 8px ${MOR.neon}66` : 'none';
                        gosterge.style.height = modul.aktif ? '20px' : '16px';
                    }
                    let ad = buton.querySelector('.said-buton-adi');
                    if (ad) {
                        ad.style.color = modul.aktif ? '#ffffff' : MOR.acik;
                        ad.style.textShadow = modul.aktif ? `0 0 8px ${MOR.neon}66` : 'none';
                    }
                    buton.style.background = modul.aktif ?
                        `linear-gradient(135deg, ${MOR.orta}44 0%, ${MOR.koyu}66 100%)` :
                        'rgba(255,255,255,0.03)';
                    buton.style.borderColor = modul.aktif ? `${MOR.neon}44` : 'transparent';
                }
            });
        }
        gosterGUI() {
            this.paneller.forEach(p => p.goster());
            if (this.bulanikArkaplan) this.bulanikArkaplan.style.display = "block";
        }
        kapandi() {
            this.paneller.forEach(p => p.gizle());
            if (this.bulanikArkaplan) this.bulanikArkaplan.style.display = "none";
            let kural = oyunYardim.cssKuraliBul(".pause-cont");
            if (kural) kural.style.display = "";
            let duraklama = document.getElementsByClassName("pause-cont")[0];
            if (duraklama) duraklama.style.display = "none";
            this.canvasDuzenle();
            let canvas = document.querySelector("#game");
            if (canvas) canvas.click();
        }
        ayarGuncellendi() {
            this.renkleriGuncelle();
            this.animasyonGuncelle();
        }
    }

