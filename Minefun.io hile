            this._tusBas = (e) => { if (this.tusHaritasi[e.code]) this.tusDegistir(this.tusHaritasi[e.code], true); };
            this._tusBirak = (e) => { if (this.tusHaritasi[e.code]) this.tusDegistir(this.tusHaritasi[e.code], false); };
            this._fareBas = (e) => {
                let zaman = Date.now();
                if (e.button === 0) { this.tusDegistir("lmb", true);
                    this.tikL.push(zaman); }
                if (e.button === 2) { this.tusDegistir("rmb", true);
                    this.tikR.push(zaman); }
            };
            this._fareBirak = (e) => {
                if (e.button === 0) this.tusDegistir("lmb", false);
                if (e.button === 2) this.tusDegistir("rmb", false);
            };
