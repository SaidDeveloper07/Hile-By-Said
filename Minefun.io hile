    // --- AntiBan (Türkçe) ---
    class ModAntiBan extends Modul {
        constructor() {
            super("AntiBan", "AntiBan", {
                "Otomatik Kapat": true,
                "Sekme Koruma": true,
                "Konsol Gizle": true,
                "Yumuşak Dönüş": true,
                "Rastgele Gecikme": true,
                "Sapma MS (±)": 25,
                "Personel Algılama": true,
                "GUI Gizle": true
            });
            this._personelKelimeler = ["admin", "mod", "staff", "helper", "support", "gm", "owner", "dev", "operator", "op", "spectator"];
            this._supheliOyuncular = [];
            this._sonTarama = 0;
            this._bulanik = false;
            this._taramaAraligi = null;
            this._konsolTemizlik = null;
            this._modulZamanlayicilar = {};
            this._blurFonk = () => { this._bulanik = true; if (this.ayarlar["Sekme Koruma"] && this.aktif) this.sekmeBulanik(); };
            this._focusFonk = () => { this._bulanik = false; if (this.ayarlar["Sekme Koruma"] && this.aktif) this.sekmeOdak(); };
        }
        acildi() {
            if (this.ayarlar["Personel Algılama"]) {
                this._taramaAraligi = setInterval(() => this.personelTara(), 3000);
                this.personelTara();
            }
            if (this.ayarlar["Konsol Gizle"]) {
                this._eskiKonsol = { log: console.log, warn: console.warn, error: console.error, info: console.info };
                const self = this;
                const filtre = (args) => {
                    let str = Array.from(args).join(' ').toLowerCase();
                    return str.includes('neonviper') || str.includes('said') || str.includes('hack') || str.includes('cheat') || str.includes('module') || str.includes('killaura') || str.includes('aimbot');
                };
                console.log = function() { if (!filtre(arguments)) self._eskiKonsol.log.apply(console, arguments); };
                console.warn = function() { if (!filtre(arguments)) self._eskiKonsol.warn.apply(console, arguments); };
                console.error = function() { if (!filtre(arguments)) self._eskiKonsol.error.apply(console, arguments); };
                console.info = function() { if (!filtre(arguments)) self._eskiKonsol.info.apply(console, arguments); };
                this._konsolTemizlik = setInterval(() => { try { console.clear(); } catch (e) {} }, 30000);
            }
            if (this.ayarlar["Sekme Koruma"]) {
                window.addEventListener("blur", this._blurFonk);
                window.addEventListener("focus", this._focusFonk);
            }
            if (this.ayarlar["Rastgele Gecikme"]) {
                let killaura = moduller["Killaura"];
                if (killaura && killaura.ayarlar && killaura.ayarlar["Gecikme"]) {
                    this._modulZamanlayicilar.killaura = killaura.ayarlar["Gecikme"];
                    const sapma = parseInt(this.ayarlar["Sapma MS (±)"]) || 25;
                    Object.defineProperty(killaura.ayarlar, "Gecikme", {
                        get: () => {
                            let taban = this._modulZamanlayicilar.killaura;
                            return taban + Math.floor(Math.random() * sapma * 2 - sapma);
                        },
                        set: (val) => { this._modulZamanlayicilar.killaura = val; },
                        configurable: true
                    });
                }
            }
            if (this.ayarlar["Yumuşak Dönüş"]) {
                let aimbot = moduller["Aimbot"];
                if (aimbot && aimbot.hedefeBak) {
                    const yumusaklik = 0.35 + Math.random() * 0.3;
                    aimbot.hedefeBak = function() {
                        let me = baglayici.oyunDunyasi.player;
                        let oyuncular = baglayici.oyunDunyasi.server.players;
                        if (!me || !oyuncular) return;
                        let hedef = aimbot.enYakinDusman(me, oyuncular);
                        if (hedef) {
                            let hPos = hedef.model.position, mPos = me.position;
                            let fark = { x: hPos.x - mPos.x, z: hPos.z - mPos.z };
                            let yaw = Math.atan2(fark.x, fark.z);
                            let yOfset = parseFloat(aimbot.ayarlar["Y Ofset"] || "-0.7");
                            let yFark = hPos.y + yOfset - mPos.y;
                            let yatay = Math.hypot(fark.x, fark.z);
                            let pitch = Math.atan2(yFark, yatay);
                            pitch = Math.max(Math.min(pitch, Math.PI / 2), -Math.PI / 2);
                            let yeniYaw = (yaw + Math.PI) % (2 * Math.PI);
                            if (window._sonYaw !== undefined) {
                                let farkYaw = yeniYaw - window._sonYaw;
                                if (farkYaw > Math.PI) farkYaw -= 2 * Math.PI;
                                if (farkYaw < -Math.PI) farkYaw += 2 * Math.PI;
                                yeniYaw = window._sonYaw + farkYaw * yumusaklik;
                            }
                            if (window._sonPitch !== undefined) {
                                pitch = window._sonPitch + (pitch - window._sonPitch) * yumusaklik;
                            }
                            window._sonYaw = yeniYaw;
                            window._sonPitch = pitch;
                            me.rotation.y = yeniYaw;
                            me.rotation.x = pitch;
                        }
                    };
                }
            }
            bildirimGoster("🛡️ AntiBan aktif", true);
        }
        personelTara() {
            this._sonTarama = Date.now();
            if (!baglayici?.oyunDunyasi?.server?.oyuncular) return;
            let oyuncular = baglayici.oyunDunyasi.server.oyuncular;
            oyuncular.forEach((p, id) => {
                if (!p || !p.name) return;
                let isim = p.name.toLowerCase();
                let personel = this._personelKelimeler.some(k => isim.includes(k) || isim.replace(/[^a-z0-9]/g, '').includes(k));
                if (personel && !this._supheliOyuncular.includes(id)) {
                    this._supheliOyuncular.push(id);
                    bildirimGoster(`⚠️ Personel tespit edildi: ${p.name}`, false, true);
                    if (this.ayarlar["Otomatik Kapat"]) this.savasModulleriniKapat();
                    if (this.ayarlar["GUI Gizle"]) this.GUIGizle();
                }
            });
        }
        sekmeBulanik() {
            if (this._bulanik) {
                this.savasModulleriniKapat();
                bildirimGoster("⚠️ Sekme değişti - modüller kapatıldı", false, true);
            }
        }
        sekmeOdak() { bildirimGoster("✅ Sekmeye dönüldü - manuel açın", true); }
        savasModulleriniKapat() {
            ["Killaura", "Aimbot", "Rangeclick", "GunModifier", "Fly", "Speed", "NoClip", "Timer"].forEach(isim => {
                let mod = moduller[isim];
                if (mod && mod.aktif) try { mod.kapat(); } catch (e) {}
            });
        }
        GUIGizle() {
            let gui = moduller["ClickGUI"];
            if (gui && gui.aktif) try { gui.kapat(); } catch (e) {}
        }
        kapandi() {
            if (this._eskiKonsol?.log) {
                console.log = this._eskiKonsol.log;
                console.warn = this._eskiKonsol.warn;
                console.error = this._eskiKonsol.error;
                console.info = this._eskiKonsol.info;
                this._eskiKonsol = {};
            }
            if (this._taramaAraligi) clearInterval(this._taramaAraligi);
            if (this._konsolTemizlik) clearInterval(this._konsolTemizlik);
            window.removeEventListener("blur", this._blurFonk);
            window.removeEventListener("focus", this._focusFonk);
            if (this._modulZamanlayicilar.killaura) {
                let k = moduller["Killaura"];
                if (k && k.ayarlar) {
                    delete k.ayarlar.Gecikme;
                    k.ayarlar.Gecikme = this._modulZamanlayicilar.killaura;
                }
            }
            this._supheliOyuncular = [];
            this._bulanik = false;
            window._sonYaw = undefined;
            window._sonPitch = undefined;
        }
    }

