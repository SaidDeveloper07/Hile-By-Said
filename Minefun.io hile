// ==/UserScript==

(() => {
    // =============================================
    // 1. SAID BİLGİLERİ VE SABİTLER
    // =============================================
    const SAID = 'Said';
    const SAID_GITHUB = 'https://github.com/SaidDeveloper07';
    const SURUM = '3.0.0 - MOR SAID';
    let saidLogSayaci = 0;

    function saidLog(mesaj, tip = 'bilgi') {
        const renkler = {
            bilgi: '#9B30FF',
            basari: '#00FF00',
            uyari: '#FFA500',
            hata: '#FF0000'
        };
        console.log(`%c[${SAID}] ${mesaj}`, `color: ${renkler[tip] || '#9B30FF'}; font-weight: bold;`);
        saidLogSayaci++;
    }

    // =============================================
    // 2. MOR RENK PALETİ
    // =============================================
    const MOR = {
        koyu: '#1A0A2E',
        orta: '#4B0082',
        parlak: '#8B00FF',
        neon: '#BF00FF',
        acik: '#D8BFD8',
        morGri: '#6A5ACD',
        morPembe: '#DA70D6',
        morLavanta: '#E6E6FA',
        menekse: '#9400D3',
        morKoyu: '#2B0F3A'
    };

    // =============================================
    // 3. OLAYLAR SİSTEMİ (Event Bus)
    // =============================================
    var olaylar = {
        dinleyiciler: {},
        aktifTuslar: new Set,
        on: function(olay, fonk) {
            (this.dinleyiciler[olay] || (this.dinleyiciler[olay] = [])).push(fonk);
        },
        kaldir: function(olay, fonk) {
            if (this.dinleyiciler[olay]) {
                this.dinleyiciler[olay] = this.dinleyiciler[olay].filter(f => f !== fonk);
            }
        },
        emit: function(olay, veri) {
            if (this.dinleyiciler[olay]) {
                this.dinleyiciler[olay].forEach(f => f(veri));
            }
        },
        tusTakip: function(olay, tusKodu, tus) {
            if (olay === "keydown") this.tusBas(tus);
            if (olay === "keydown" && !this.aktifTuslar.has(tusKodu)) {
                this.aktifTuslar.add(tusKodu);
                this.emit("tusBas", { tus: tusKodu, kod: tus });
            }
            if (olay === "keyup" && this.aktifTuslar.has(tusKodu)) {
                this.aktifTuslar.delete(tusKodu);
                this.emit("tusBirak", { tus: tusKodu, kod: tus });
            }
        }
    };

    // =============================================
    // 4. KALICI SAID DAMGASI (DAİRE İÇİNDE)
    // =============================================
    var saidDairesi = document.createElement("div");
    saidDairesi.id = "said-permanent-badge";
    saidDairesi.innerHTML = `<span style="font-size:14px;font-weight:900;">${SAID}</span>`;
    saidDairesi.style.cssText = `
        position: fixed;
        bottom: 20px;
        left: 20px;
        z-index: 9999999;
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background: ${MOR.orta};
        color: ${MOR.acik};
        font-family: 'Product Sans', 'Segoe UI', sans-serif;
        font-size: 13px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid ${MOR.neon};
        box-shadow: 0 0 30px ${MOR.neon}66, inset 0 0 20px ${MOR.neon}33;
        pointer-events: none;
        user-select: none;
        transition: all 0.3s ease;
        text-shadow: 0 0 10px ${MOR.neon};
        letter-spacing: 1px;
        transform: scale(1);
    `;
    // Daireye tıklanınca menüyü aç/kapa
    saidDairesi.style.pointerEvents = 'auto';
    saidDairesi.style.cursor = 'pointer';

    var badgeGoster = true;
    saidDairesi.addEventListener('click', () => {
        const menu = document.getElementById('said-menu');
        if (menu) {
            const durum = menu.style.display === 'none' || !menu.style.display;
            menu.style.display = durum ? 'block' : 'none';
            saidLog(durum ? 'Menü açıldı' : 'Menü kapatıldı');
        }
    });

    // Badge'i sayfaya ekle
    function badgeEkle() {
        if (document.body && !document.getElementById("said-permanent-badge")) {
            document.body.appendChild(saidDairesi);
            saidLog('Said damgası eklendi');
        }
    }

    var badgeGözlemci = new MutationObserver(() => {
        if (document.body && !document.getElementById("said-permanent-badge")) {
            badgeEkle();
        }
    });
    badgeGözlemci.observe(document.documentElement, { childList: true, subtree: true });

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(badgeEkle, 500);
    } else {
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(badgeEkle, 500);
        });
    }

    // =============================================
    // 5. BİLDİRİM SİSTEMİ (MOR)
    // =============================================
    var bildirimKapsayici = null;
    var bildirimId = 0;

    function bildirimGoster(mesaj, basari = true, uyari = false) {
        if (!bildirimKapsayici) {
            bildirimKapsayici = document.createElement("div");
            bildirimKapsayici.style.cssText = `
                position: fixed;
                bottom: 80px;
                right: 20px;
                z-index: 10000;
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 8px;
                pointer-events: none;
            `;
            document.body.appendChild(bildirimKapsayici);
        }
        let el = document.createElement("div");
        el.className = "said-bildirim";
        el.id = "said-bildirim-" + (bildirimId++);
        let renk = basari ? MOR.neon : uyari ? '#FFA500' : '#FF5555';
        let ikon = basari ? '✓' : uyari ? '⚠' : '✕';
        el.style.cssText = `
            background: linear-gradient(135deg, ${MOR.koyu}dd 0%, ${MOR.orta}bb 100%);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid ${MOR.neon}44;
            color: ${MOR.acik};
            padding: 10px 18px 10px 14px;
            border-radius: 10px;
            font-family: 'Product Sans', 'Segoe UI', sans-serif;
            font-size: 13.5px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.45), inset 0 1px 0 ${MOR.neon}22;
            transform: translateX(120%);
            transition: all 0.35s cubic-bezier(0.2,0.9,0.4,1.1);
            pointer-events: none;
            max-width: 300px;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid ${renk};
        `;
        el.innerHTML = `
            <span style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:${renk}33;color:${renk};font-size:13px;font-weight:bold;flex-shrink:0;">${ikon}</span>
            <span style="color:#e8e8f0;font-weight:400;">${mesaj}</span>
        `;
        bildirimKapsayici.appendChild(el);
        setTimeout(() => { el.style.transform = "translateX(0)" }, 10);
        let hepsi = bildirimKapsayici.querySelectorAll('.said-bildirim');
        if (hepsi.length > 12) {
            for (let i = 0; i < hepsi.length - 12; i++) {
                let eski = hepsi[i];
                if (eski && eski.parentNode) eski.parentNode.removeChild(eski);
            }
        }
    }

    // =============================================
    // 6. TEMEL MODÜL SINIFI
    // =============================================
    class Modul {
        constructor(isim, kategori, ayarlar = {}, tus = null) {
            this.isim = isim;
            this.kategori = kategori;
            this.ayarlar = ayarlar || {};
            this.tus = tus || null;
            this.beklemede = false;
            this.aktif = false;
        }
        ac() { this.aktif = true; olaylar.emit("modul.guncelle", this); if (this.acildi) this.acildi(); }
        kapat() { this.aktif = false; olaylar.emit("modul.guncelle", this); if (this.kapandi) this.kapandi(); }
        degistir() {
            if (this.aktif) { this.kapat(); bildirimGoster(this.isim + " kapatıldı", false); }
            else { this.ac(); bildirimGoster(this.isim + " açıldı", true); }
        }
        cizim() { if (this.aktif && this.cizimYap) this.cizimYap(); }
        ayarGuncelle() { if (this.aktif && this.ayarGuncellendi) this.ayarGuncellendi(); }
    }

    // =============================================
    // 7. OYUN BAĞLAYICISI (hooks)
    // =============================================
    var baglayici = {
        get magazalar() {
            if (this._magazalar) return this._magazalar;
            let e = app._vnode.component.appContext.provides;
            let t = e[Object.getOwnPropertySymbols(e).find(i => e[i]._s)];
            return this._magazalar = t._s;
        },
        get oyunDunyasi() {
            return this.magazalar.get("gameState").gameWorld;
        }
    };

    // =============================================
    // 8. YARDIMCI MATEMATİK
    // =============================================
    var yardim = {
        normalizeVektor(e) {
            let t = e.x * e.x + e.y * e.y + e.z * e.z;
            if (t > 0) { let i = 1 / Math.sqrt(t); return [e.x * i, e.y * i, e.z * i]; }
            return e;
        },
        mesafe(e, t) {
            let i = t.x - e.x, n = t.y - e.y, a = t.z - e.z;
            return i * i + n * n + a * a;
        },
        mesafeKok(e, t) { return Math.sqrt(this.mesafe(e, t)); },
        mesafeHesapla(e, t) { return Math.hypot(t.x - e.x, t.y - e.y, t.z - e.z); },
        mesafeHesaplaDizi(e, t) { return Math.hypot(t[0] - e[0], t[1] - e[1], t[2] - e[2]); }
    };

    // =============================================
    // 9. OYUN YARDIMCILARI
    // =============================================
    var oyunYardim = {
        enYakinOyuncu() {
            let me = baglayici.oyunDunyasi.player.position;
            let oyuncular = baglayici.oyunDunyasi.server.players;
            let liste = [];
            oyuncular.forEach((p, id) => {
                let mes = yardim.mesafe(me, {
                    x: p._model.position.x,
                    y: p._model.position.y,
                    z: p._model.position.z
                });
                p.id = id;
                liste.push({ oyuncu: p, mesafe: mes });
            });
            liste.sort((a, b) => a.mesafe - b.mesafe);
            return liste.map(a => a.oyuncu)[0];
        },
        hexToRgb(e) {
            let t = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(e);
            return t ? { r: parseInt(t[1], 16), g: parseInt(t[2], 16), b: parseInt(t[3], 16) } : null;
        },
        cssKuraliBul(e) {
            for (let t of document.styleSheets)
                for (let i of t.cssRules || [])
                    if (i.selectorText?.includes(e)) return i;
            return null;
        }
    };

    // =============================================
    // 10. PAKET SİSTEMİ
    // =============================================
    var paket = {
        sunucuya: {
            ZAMAN_BILGISI: 1,
            YENIDEN_DOG: 4,
            HASAR_AL: 27,
            PARKOUR_YENIDEN_DOG: 1004,
            ONE_BLOCK_YENIDEN_DOG: 1552,
            BED_WARS_YENIDEN_DOG: 1600,
            SANDBOX_YENIDEN_DOG: 1700
        },
        istemciye: {
            YURUYUS_MODU: 41,
            GORUNMEZ_MOD: 42
        },
        dinleyiciler: {},
        paketDinleyici(e, t) {
            Object.values(this.dinleyiciler).forEach(i => {
                let n = i(e, t);
                if (n != null) t = n;
            });
            baglayici.oyunDunyasi.server.msgsToSend.push(e, t);
        },
        baslat() {
            olaylar.on("cizim", () => {
                if (baglayici?.oyunDunyasi?.server?.sendData &&
                    baglayici.oyunDunyasi.server.sendData !== this.paketDinleyici) {
                    this._eskiGonder = baglayici.oyunDunyasi.server.sendData;
                    baglayici.oyunDunyasi.server.sendData = this.paketDinleyici.bind(this);
                }
            });
        }
    };

    // =============================================
    // 11. MENÜ (GUI) SİSTEMİ - MOR
    // =============================================
    class Arayuz {
        constructor(modul, kap) {
            this.modul = modul;
            this.kap = kap;
            this.bilesenler = [];
            this.hazir = false;
            this.acik = false;
        }
        hazirla() {
            if (this.hazir || !this.modul?.ayarlar) return;
            Object.keys(this.modul.ayarlar).forEach(key => {
                let deger = this.modul.ayarlar[key];
                let tip = typeof deger;
                let eslesme = key.match(/\((\d+)-(\d+)\)/);
                if (Array.isArray(deger)) this.modEkle(key);
                else if (eslesme) this.kaydiriciEkle(key, parseInt(eslesme[1]), parseInt(eslesme[2]));
                else if (key.toLowerCase().includes("renk")) this.renkSeciciEkle(key);
                else if (tip === "boolean" || deger === "true" || deger === "false") this.isaretEkle(key);
                else this.sayiGirisiEkle(key);
            });
            this.tusEkle();
            this.bilesenler.forEach(e => e.style.display = "none");
            this.hazir = true;
        }
        degistir() {
            this.acik = !this.acik;
            this.bilesenler.forEach(e => {
                e.style.display = this.acik ? "flex" : "none";
                this.kap.style.marginBottom = this.acik ? "5px" : "0px";
            });
        }
        modEkle(key) {
            let div = document.createElement("div");
            div.className = "said-ayar-kap";
            let etiket = document.createElement("span");
            etiket.className = "said-ayar-etiket";
            etiket.textContent = key;
            let goster = document.createElement("div");
            goster.textContent = this.modul.ayarlar[key][0];
            goster.style.cssText = `
                background: ${MOR.orta};
                color: ${MOR.acik};
                padding: 4px 10px;
                border-radius: 4px;
                cursor: pointer;
                font-size: 12px;
                font-family: monospace;
                text-align: center;
                min-width: 55px;
                user-select: none;
                margin: 4px 8px;
                transition: 0.2s;
                border: 1px solid ${MOR.neon}55;
            `;
            goster.addEventListener("click", () => {
                let dizi = this.modul.ayarlar[key];
                dizi.push(dizi.shift());
                goster.textContent = dizi[0];
                olaylar.emit("ayar.guncelle", this.modul);
            });
            goster.addEventListener("mouseenter", () => goster.style.background = MOR.parlak);
            goster.addEventListener("mouseleave", () => goster.style.background = MOR.orta);
            div.appendChild(etiket);
            div.appendChild(goster);
            this.kap.appendChild(div);
            this.bilesenler.push(div);
        }
        kaydiriciEkle(key, min, max) {
            let div = document.createElement("div");
            div.className = "said-ayar-kap";
            let etiket = document.createElement("span");
            etiket.className = "said-ayar-etiket";
            etiket.textContent = key.replace(/\(\d+-\d+\)/, "").trim();
            let sag = document.createElement("div");
            sag.style.display = "flex";
            sag.style.alignItems = "center";
            sag.style.gap = "6px";
            let degerGoster = document.createElement("span");
            degerGoster.style.color = MOR.acik;
            degerGoster.style.fontSize = "12px";
            degerGoster.style.fontFamily = "monospace";
            degerGoster.textContent = this.modul.ayarlar[key];
            let kaydirici = document.createElement("input");
            kaydirici.type = "range";
            kaydirici.min = min;
            kaydirici.max = max;
            kaydirici.value = this.modul.ayarlar[key];
            kaydirici.className = "said-kaydirici";
            kaydirici.style.width = "60px";
            kaydirici.style.accentColor = MOR.neon;
            kaydirici.addEventListener("input", e => {
                let val = Number(e.target.value);
                degerGoster.textContent = val;
                this.modul.ayarlar[key] = val;
                olaylar.emit("ayar.guncelle", this.modul);
            });
            sag.appendChild(kaydirici);
            sag.appendChild(degerGoster);
            div.appendChild(etiket);
            div.appendChild(sag);
            this.kap.appendChild(div);
            this.bilesenler.push(div);
        }
        sayiGirisiEkle(key) {
            let div = document.createElement("div");
            div.className = "said-ayar-kap";
            let etiket = document.createElement("span");
            etiket.className = "said-ayar-etiket";
            etiket.textContent = key;
            let input = document.createElement("input");
            input.type = "text";
            input.className = "said-sayi-input";
            input.value = this.modul.ayarlar[key];
            input.style.width = "35px";
            input.style.fontSize = "12px";
            input.style.background = MOR.koyu;
            input.style.color = MOR.acik;
            input.style.border = `1px solid ${MOR.neon}55`;
            input.style.borderRadius = "4px";
            input.style.textAlign = "center";
            let onceki = input.value;
            input.addEventListener("input", () => {
                let val = input.value.trim();
                if (!isNaN(val) && val !== "") {
                    onceki = val;
                    this.modul.ayarlar[key] = Number(val);
                    olaylar.emit("ayar.guncelle", this.modul);
                }
            });
            input.addEventListener("blur", () => {
                if (isNaN(input.value) || input.value.trim() === "") input.value = onceki;
            });
            div.appendChild(etiket);
            div.appendChild(input);
            this.kap.appendChild(div);
            this.bilesenler.push(div);
        }
        isaretEkle(key) {
            let div = document.createElement("div");
            div.className = "said-ayar-kap";
            let etiket = document.createElement("span");
            etiket.className = "said-ayar-etiket";
            etiket.textContent = key;
            let isaret = document.createElement("div");
            isaret.className = "said-isaret";
            isaret.style.width = "14px";
            isaret.style.height = "14px";
            isaret.style.borderRadius = "4px";
            isaret.style.background = MOR.koyu;
            isaret.style.border = `1px solid ${MOR.neon}55`;
            isaret.style.cursor = "pointer";
            isaret.style.margin = "7px";
            let durum = this.modul.ayarlar[key] === true || this.modul.ayarlar[key] === "true";
            if (durum) {
                isaret.style.background = MOR.neon;
                isaret.style.boxShadow = `0 0 12px ${MOR.neon}66`;
            }
            isaret.addEventListener("click", () => {
                let yeni = !isaret.classList.contains("aktif");
                isaret.classList.toggle("aktif", yeni);
                isaret.style.background = yeni ? MOR.neon : MOR.koyu;
                isaret.style.boxShadow = yeni ? `0 0 12px ${MOR.neon}66` : 'none';
                this.modul.ayarlar[key] = yeni;
                olaylar.emit("ayar.guncelle", this.modul);
            });
            div.appendChild(etiket);
            div.appendChild(isaret);
            this.kap.appendChild(div);
            this.bilesenler.push(div);
        }
        renkSeciciEkle(key) {
            let div = document.createElement("div");
            div.className = "said-ayar-kap";
            let etiket = document.createElement("span");
            etiket.className = "said-ayar-etiket";
            etiket.textContent = key;
            let renkKutusu = document.createElement("div");
            renkKutusu.style.width = "14px";
            renkKutusu.style.height = "14px";
            renkKutusu.style.borderRadius = "4px";
            renkKutusu.style.background = this.modul.ayarlar[key];
            renkKutusu.style.border = `1px solid ${MOR.neon}55`;
            renkKutusu.style.cursor = "pointer";
            renkKutusu.style.margin = "7px";
            let gizliInput = document.createElement("input");
            gizliInput.type = "color";
            gizliInput.style.position = "absolute";
            gizliInput.style.opacity = "0";
            gizliInput.style.width = "0";
            gizliInput.style.height = "0";
            gizliInput.value = this.modul.ayarlar[key];
            gizliInput.addEventListener("input", e => {
                renkKutusu.style.background = e.target.value;
                this.modul.ayarlar[key] = e.target.value;
                olaylar.emit("ayar.guncelle", this.modul);
            });
            renkKutusu.addEventListener("click", () => gizliInput.click());
            renkKutusu.appendChild(gizliInput);
            div.appendChild(etiket);
            div.appendChild(renkKutusu);
            this.kap.appendChild(div);
            this.bilesenler.push(div);
        }
        tusEkle() {
            let div = document.createElement("div");
            div.className = "said-ayar-kap";
            let etiket = document.createElement("span");
            etiket.className = "said-ayar-etiket";
            etiket.textContent = "Tuş";
            let goster = document.createElement("div");
            goster.className = "said-tus-goster";
            goster.textContent = this.modul.tus || "Yok";
            goster.style.cssText = `
                background: ${MOR.orta};
                padding: 2px 8px;
                border-radius: 4px;
                cursor: pointer;
                font-family: monospace;
                font-size: 11px;
                color: ${MOR.acik};
                border: 1px solid ${MOR.neon}55;
                transition: 0.2s;
            `;
            goster.addEventListener("click", () => {
                goster.textContent = "bekle...";
                let dinleyici = e => {
                    e.stopPropagation();
                    e.preventDefault();
                    let kod = e.code;
                    if (kod === "Escape") this.modul.tus = null;
                    else this.modul.tus = kod;
                    goster.textContent = this.modul.tus || "Yok";
                    document.removeEventListener("keydown", dinleyici);
                    this.modul.beklemede = false;
                };
                document.addEventListener("keydown", dinleyici);
                this.modul.beklemede = true;
            });
            div.appendChild(etiket);
            div.appendChild(goster);
            this.kap.appendChild(div);
            this.bilesenler.push(div);
        }
    }

    // =============================================
    // 12. PANEL SİSTEMİ (MOR)
    // =============================================
    class Panel {
        constructor(kategori, konum = { top: "200px", left: "200px" }) {
            this.kategori = kategori;
            this.panel = document.createElement("div");
            this.panel.className = "said-panel";
            this.panel.style.cssText = `
