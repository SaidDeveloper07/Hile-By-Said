    class ModKillaura extends Modul {
        constructor() {
            super("Killaura", "Combat", {
                "Y Ofset": 1.62,
                "Menzil": 10,
                "Gecikme": 50,
                "FOV": 30
            });
            this.sonCalisma = null;
        }
        cizimYap() {
            let simdi = Date.now();
            if (baglayici?.oyunDunyasi?.player && simdi - this.sonCalisma >= this.ayarlar.Gecikme) {
                this.sonCalisma = simdi;
                this.deneOldur();
            }
        }
        deneOldur() {
            let menzil = this.ayarlar.Menzil,
                yOfset = this.ayarlar["Y Ofset"],
                mFOV = this.ayarlar.FOV || 30;
            let me = baglayici.oyunDunyasi.player;
            let mePos = { x: me.position.x, y: me.position.y + yOfset, z: me.position.z };
            let bakis = { x: 0, y: 0, z: 0 };
            if (me.getLookVector) bakis = me.getLookVector();
            else if (me.rotation) {
                let y = me.rotation.y,
                    p = me.rotation.x;
                bakis.x = -Math.sin(y) * Math.cos(p);
                bakis.y = -Math.sin(p);
                bakis.z = -Math.cos(y) * Math.cos(p);
            }
            let uzunluk = Math.sqrt(bakis.x * bakis.x + bakis.y * bakis.y + bakis.z * bakis.z);
            if (uzunluk !== 0) { bakis.x /= uzunluk;
                bakis.y /= uzunluk;
                bakis.z /= uzunluk; }
            let hedef = oyunYardim.enYakinOyuncu();
            if (!hedef) return;
            let hPos = hedef._model.position;
            let fark = { x: hPos.x - mePos.x, y: hPos.y - mePos.y, z: hPos.z - mePos.z };
            let mesafe = Math.sqrt(fark.x * fark.x + fark.y * fark.y + fark.z * fark.z);
            if (mesafe !== 0) { fark.x /= mesafe;
                fark.y /= mesafe;
                fark.z /= mesafe; }
            let nokta = bakis.x * fark.x + bakis.y * fark.y + bakis.z * fark.z;
            let aci = Math.acos(Math.max(-1, Math.min(1, nokta))) * (180 / Math.PI);
            if (mesafe < menzil && aci <= mFOV) {
                baglayici.oyunDunyasi.server.sendData(13, [
                    baglayici.oyunDunyasi.time.localServerTimeMs,
                    mePos.x, mePos.y, mePos.z,
                    fark.x, fark.y, fark.z,
                    mesafe, hedef.id
                ]);
            }
        }
    }

    class ModAimbot extends Modul {
        constructor() {
            super("Aimbot", "Combat", {
                "Hedefle": "true",
                "Ateşle": "true",
                "Y Ofset": -0.7
            });
            this.sonCalisma = null;
        }
        enYakinDusman(me, oyuncular) {
            let enYakin = null,
                enMesafe = Infinity;
            oyuncular.forEach(p => {
                if (p?.model?.position && p.isAlive) {
                    let mes = yardim.mesafeHesapla(me.position, p.model.position);
                    if (mes < enMesafe) { enMesafe = mes;
                        enYakin = p; }
                }
            });
            return enYakin;
        }
        hedefeBak() {
            let me = baglayici.oyunDunyasi.player;
            let oyuncular = baglayici.oyunDunyasi.server.players;
            if (!me || !oyuncular) return;
            let hedef = this.enYakinDusman(me, oyuncular);
            if (hedef) {
                let hPos = hedef.model.position,
                    mPos = me.position;
                let fark = { x: hPos.x - mPos.x, z: hPos.z - mPos.z };
                let yaw = Math.atan2(fark.x, fark.z);
                let yOfset = parseFloat(this.ayarlar["Y Ofset"] || "-0.7");
                let yFark = hPos.y + yOfset - mPos.y;
                let yatay = Math.hypot(fark.x, fark.z);
                let pitch = Math.atan2(yFark, yatay);
                pitch = Math.max(Math.min(pitch, Math.PI / 2), -Math.PI / 2);
                let yeniYaw = (yaw + Math.PI) % (2 * Math.PI);
                me.rotation.y = yeniYaw;
                me.rotation.x = pitch;
            }
        }
        cizimYap() {
            if (baglayici?.oyunDunyasi?.server) {
                if (this.ayarlar["Hedefle"] === "true" && baglayici.oyunDunyasi.player.inputs.rightMB) this.hedefeBak();
                else if (this.ayarlar["Ateşle"] === "true" && baglayici.oyunDunyasi.player.inputs.leftMB) this.hedefeBak();
                else if (this.ayarlar["Ateşle"] !== "true" && this.ayarlar["Hedefle"] !== "true") this.hedefeBak();
            }
        }
    }

    // --- Diğer kısa modüller ---
    class ModNoFall extends Modul {
        constructor() { super("DusmeYok", "Movement"); }
        acildi() {
            paket.dinleyiciler.NoFall = function(e, t) {
                if (e == paket.sunucuya.ZAMAN_BILGISI && t && t.lp) {
                    let v = t.lp[3];
                    if (v > 0) t.lp[3] *= 0.01;
                    else t.lp[3] = -0.01;
                }
            };
        }
        kapandi() { delete paket.dinleyiciler.NoFall; }
    }

    class ModNoClip extends Modul {
        constructor() { super("DuvardanGec", "Movement"); }
        get fizikSistemi() {
            return baglayici.oyunDunyasi.systemsManager.activeSystems.find(e => e?.playerPhysicsSystem).playerPhysicsSystem;
        }
        cizimYap() {
            if (baglayici?.oyunDunyasi?.player) {
                this._eski = this._eski || this.fizikSistemi.resolveBlockCollision;
                if (this.fizikSistemi.resolveBlockCollision == this._eski)
                    this.fizikSistemi.resolveBlockCollision = () => {};
            }
        }
        kapandi() {
            if (this.fizikSistemi) this.fizikSistemi.resolveBlockCollision = this._eski;
        }
    }

    class ModTimer extends Modul {
        constructor() { super("Zamanlayıcı", "Movement", { Çarpan: 5 }); this.aralik = null; }
        acildi() {
            if (this.aralik) clearInterval(this.aralik);
            this.aralik = setInterval(() => {
                let zaman = baglayici.oyunDunyasi.time;
                zaman.elapsedTimeMs += 20 * this.ayarlar.Çarpan;
            }, 20);
        }
        kapandi() { if (this.aralik) clearInterval(this.aralik); }
    }

    class ModHighJump extends Modul {
        constructor() { super("YuksekZiplama", "Movement", { "Zıplama Yüksekliği": 9.1 }); }
        cizimYap() {
            if (baglayici?.oyunDunyasi?.player?.velocity)
                baglayici.oyunDunyasi.player.velocity.jumpSpeed = parseFloat(this.ayarlar["Zıplama Yüksekliği"]);
        }
        kapandi() {
            if (baglayici?.oyunDunyasi?.player?.velocity)
                baglayici.oyunDunyasi.player.velocity.jumpSpeed = 8.285714285714286;
        }
    }

    // =============================================
    // 15. MODÜL YÖNETİCİSİ
    // =============================================
    var moduller = {};

    function modulEkle(...siniflar) {
        for (let sinif of siniflar) {
            let mod = new sinif();
            moduller[mod.isim] = mod;
        }
    }

    function tusBas(kod) {
        for (let isim in moduller) {
            let mod = moduller[isim];
            if (mod.beklemede) {
                mod.tus = kod === "Escape" ? null : kod;
                mod.beklemede = false;
            } else if (mod.tus === kod) {
                mod.degistir();
            }
        }
    }

    function modulYoneticisiBaslat() {
        modulEkle(
            ModArraylist, ModClickGUI, ModNoFog, ModTracers, ModFullbright,
            ModSpeed, ModFly, ModNoFall, ModNoClip, ModTimer, ModHighJump,
            ModKillaura, ModAimbot,
            ModKeystrokes,
            ModAntiBan
        );

        // Varsayılan tuşlar
        let varsayilanTuslar = {
            "Killaura": "Semicolon",
            "Fly": "Slash",
            "Timer": "Quote",
            "Aimbot": "Semicolon",
            "Hız": "Backslash"
        };
        for (let isim in varsayilanTuslar) {
            if (moduller[isim]) moduller[isim].tus = varsayilanTuslar[isim];
        }

        olaylar.on("cizim", () => {
            for (let isim in moduller) {
                let mod = moduller[isim];
                if (mod.aktif && mod.cizimYap) mod.cizimYap();
            }
        });
        olaylar.on("tusBas", e => { tusBas(e.tus); });
        olaylar.on("ayar.guncelle", () => {
            for (let isim in moduller) {
                let mod = moduller[isim];
                if (mod.aktif && mod.ayarGuncellendi) mod.ayarGuncellendi();
            }
        });

        // Hemen açılacak modüller
        ["DiziListesi", "TamParlaklık", "SisYok"].forEach(isim => {
            let mod = moduller[isim];
            if (mod) mod.ac();
        });

        setTimeout(() => {
            ["Hız", "YuksekZiplama"].forEach(isim => {
                let mod = moduller[isim];
                if (mod) mod.ac();
            });
        }, 2500);

        saidLog('Modül yöneticisi başlatıldı');
    }

    // =============================================
    // 16. ANA SINIF
    // =============================================
    class SaidClient {
        constructor() {
            this.surum = "3.0.0";
            this.baslat();
        }
        baslat() {
            setInterval(() => { olaylar.emit("cizim"); }, 1000 / 60);
            window.addEventListener("keydown", e => {
                olaylar.emit("tusBas", { tus: e.code, kod: e });
            }, { capture: true });
            modulYoneticisiBaslat();
            paket.baslat();
            this.paketler = paket;
            this.modulYoneticisi = moduller;
            this.baglayici = baglayici;
            saidLog(`✅ ${SAID} Client v${this.surum} başlatıldı!`);
            saidLog(`📌 GitHub: ${SAID_GITHUB}`);
            saidLog(`🟣 Mor tema aktif - Daire içinde ${SAID} damgası`);
            bildirimGoster(`🟣 ${SAID} Client v${this.surum} başlatıldı`, true);
        }
    }

    // =============================================
    // 17. BAŞLATICI
    // =============================================
    function baslat() {
        window.SaidClient = new SaidClient();
        // Konsol komutları
        window.said = {
            surum: '3.0.0',
            gelistirici: SAID,
            github: SAID_GITHUB,
            moduller: moduller,
            ayarlar: () => {
                console.log(`%c${SAID} - Mevcut modüller:`, `color: ${MOR.neon}; font-size:16px;`);
                Object.values(moduller).forEach(m => {
                    console.log(`  ${m.isim} (${m.kategori}): ${m.aktif ? '🟢 Açık' : '🔴 Kapalı'}`);
                });
            },
            ac: (isim) => { let m = moduller[isim]; if (m) m.ac();
                else saidLog(`${isim} bulunamadı`, 'hata'); },
            kapat: (isim) => { let m = moduller[isim]; if (m) m.kapat();
                else saidLog(`${isim} bulunamadı`, 'hata'); },
            durum: () => {
                let acik = Object.values(moduller).filter(m => m.aktif).length;
                let toplam = Object.values(moduller).length;
                saidLog(`📊 ${acik}/${toplam} modül aktif`);
            }
        };
        saidLog('💡 Konsol: window.said komutları mevcut');
    }

    if (document.readyState === "complete" || document.readyState === "interactive") {
        baslat();
    } else {
        document.addEventListener("DOMContentLoaded", () => {
            setTimeout(baslat, 1000);
        });
    }

})();
