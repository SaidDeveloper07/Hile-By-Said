    class ModTracers extends Modul {
        constructor() {
            super("Cizgiler", "Visual", {
                "Kalınlık (1-10)": 2,
                "Çizgi Rengi": MOR.neon,
                "Oyuncuları Göster": true,
                "Botları Göster": true
            });
            this.canvas = null;
            this.ctx = null;
            this.animId = null;
            this.boyutFonk = this.boyutlandir.bind(this);
        }
        canvasHazirla() {
            if (this.canvas) return;
            this.canvas = document.createElement("canvas");
            this.canvas.style.cssText = "position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9997;pointer-events:none;";
            document.body.appendChild(this.canvas);
            this.ctx = this.canvas.getContext("2d");
            this.boyutlandir();
            window.addEventListener("resize", this.boyutFonk);
        }
        boyutlandir() {
            if (!this.canvas) return;
            this.canvas.width = window.innerWidth;
            this.canvas.height = window.innerHeight;
        }
        acildi() {
            this.canvasHazirla();
            let ciz = () => {
                if (!this.aktif || !this.ctx) return;
                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
                let me = baglayici?.oyunDunyasi?.player;
                let oyuncular = baglayici?.oyunDunyasi?.server?.players;
                if (me && oyuncular) {
                    this.ctx.lineWidth = this.ayarlar["Kalınlık (1-10)"] || 2;
                    this.ctx.strokeStyle = this.ayarlar["Çizgi Rengi"] || MOR.neon;
                    let cx = this.canvas.width / 2,
                        cy = this.canvas.height / 2;
                    oyuncular.forEach(p => {
                        if (!p || p === me || (p.id !== undefined && me.id !== undefined && p.id === me.id) || !p.isAlive || !p.model) return;
                        let bot = p.name === "Zombie" || p.name === "Skeleton" || !p.name;
                        if (bot && !this.ayarlar["Botları Göster"]) return;
                        if (!bot && !this.ayarlar["Oyuncuları Göster"]) return;
                        let mp = me.position,
                            ep = p.model.position;
                        let dx = ep.x - mp.x,
                            dy = (ep.y + 0.8) - (mp.y + 1.6),
                            dz = ep.z - mp.z;
                        let yR = me.rotation.y,
                            cY = Math.cos(yR),
                            sY = Math.sin(yR);
                        let x1 = dx * cY - dz * sY,
                            z1 = dx * sY + dz * cY;
                        let xR = me.rotation.x,
                            cX = Math.cos(xR),
                            sX = Math.sin(xR);
                        let y2 = dy * cX - z1 * sX,
                            z2 = dy * sX + z1 * cX,
                            x2 = x1;
                        if (z2 < 0) {
                            let depth = -z2,
                                fS = this.canvas.height;
                            let sx = cx + (x2 / depth) * fS,
                                sy = cy - (y2 / depth) * fS;
                            this.ctx.beginPath();
                            this.ctx.moveTo(cx, cy);
                            this.ctx.lineTo(sx, sy);
                            this.ctx.stroke();
                        }
                    });
                }
                this.animId = requestAnimationFrame(ciz);
            };
            ciz();
        }
        kapandi() {
            if (this.animId) cancelAnimationFrame(this.animId);
            if (this.canvas) {
                window.removeEventListener("resize", this.boyutFonk);
                this.canvas.remove();
                this.canvas = null;
                this.ctx = null;
            }
        }
    }

