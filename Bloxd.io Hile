  class SaidTicker {
    constructor() {
      this.oyunda = false;
      this._sonZaman = 0;
      this._tikZaman = 0;
      this._tikAraligi = 1000;
      this._calisiyor = false;
      this._rafId = null;
    }
 
    baslat() {
      if (this._calisiyor) return;
      this._calisiyor = true;
      this._tik(performance.now());
    }
 
    durdur() {
      this._calisiyor = false;
      if (this._rafId) {
        cancelAnimationFrame(this._rafId);
        this._rafId = null;
      }
    }
 
    _tik(zaman) {
      if (!this._calisiyor) return;
      this._rafId = requestAnimationFrame((t) => this._tik(t));
 
      const simdiOyunda = SaidGameConnectorInstance.oyundaMi();
      const lobby = SaidGameConnectorInstance.lobiMi();
      
      // Durum güncelleme
      if (simdiOyunda !== this.oyunda) {
        this.oyunda = simdiOyunda;
        this._durumGuncelle(simdiOyunda, lobby);
      }
      
      if (!simdiOyunda && !lobby) {
        // Oyun bağlantısı yoksa bekle
        return;
      }
      
      // Render döngüsü
      const dt = this._sonZaman ? (zaman - this._sonZaman) / 1000 : 0;
      this._sonZaman = zaman;
      SaidClientInstance.render(zaman);
      
      // Periyodik tik
      if (zaman - this._tikZaman > this._tikAraligi) {
        this._tikZaman = zaman;
        SaidClientInstance.tik(zaman);
        
        // Oyun içi bilgileri güncelle
        if (simdiOyunda) {
          this._oyunBilgisiGuncelle();
        }
      }
    }
 
    _durumGuncelle(simdiOyunda, lobby) {
      const dot = document.getElementById('st-dot');
      const txt = document.getElementById('st-txt');
      if (!dot || !txt) return;
      
      if (simdiOyunda) {
        dot.className = 'dot green';
        txt.innerText = `✅ Oyunda (${SaidGame.oyuncuSayisi()} oyuncu)`;
      } else if (lobby) {
        dot.className = 'dot yellow';
        txt.innerText = '🟡 Lobi';
      } else if (SaidGameConnectorInstance.enjekteEdildi) {
        dot.className = 'dot yellow';
        txt.innerText = '⏳ Enjekte edildi, oyun bekleniyor...';
      } else {
        dot.className = 'dot red';
        txt.innerText = '⏳ Oyun bekleniyor...';
      }
    }
 
    _oyunBilgisiGuncelle() {
      // Oyuncu sayısını güncelle
      const txt = document.getElementById('st-txt');
      if (txt && this.oyunda) {
        const sayi = SaidGame.oyuncuSayisi();
        if (sayi > 0) {
          txt.innerText = `✅ Oyunda (${sayi} oyuncu)`;
        }
      }
    }
  }
 
