  class SaidGameConnector {
    constructor() {
      this._noa = null;
      this._enjekteEdildi = false;
      this._baglantiDenemeleri = 0;
      this._maxDeneme = 50;
      this._enjekteCallback = null;
    }
 
    get noa() { return this._noa; }
    get enjekteEdildi() { return this._enjekteEdildi; }
 
    enjekteEt(callback = null) {
      if (this._enjekteEdildi) return;
      this._enjekteCallback = callback;
      
      let yakalandi = false;
      const orijinalCall = Function.prototype.call;
      
      defineProperty(Function.prototype, 'call', {
        enumerable: false,
        configurable: true,
        writable: true,
        value: function (thisArg, ...args) {
          if (!yakalandi) {
            const c = args[0];
            if (c && c.entities && c.bloxd) {
              yakalandi = true;
              this._noa = c;
              this._enjekteEdildi = true;
              console.log(
                "%c[Click Helper PRO - Said]%c Enjekte başarılı! 🚀",
                "background: linear-gradient(90deg, #7C3AED, #8B5CF6); color: #fff; font-weight: bold; padding: 4px 10px; border-radius: 4px; font-size: 13px;",
                "color: #A78BFA; font-weight: bold; margin-left: 8px; font-size: 13px;"
              );
              defineProperty(Function.prototype, 'call', { value: orijinalCall });
              if (this._enjekteCallback) this._enjekteCallback();
              this._enjeksiyonSonrasi();
            }
          }
          return orijinalCall.apply(this, [thisArg, ...args]);
        }
      });
    }
 
    _enjeksiyonSonrasi() {
      const btn = document.getElementById('ch-enjekte');
      if (btn) {
        btn.style.pointerEvents = 'none';
        btn.style.opacity = '0.8';
        btn.innerHTML = '<i class="fa-solid fa-circle-check" style="color:#A78BFA;"></i>';
      }
    }
 
    oyundaMi() {
      return !!(this._noa?.bloxd?.client?.msgHandler);
    }
 
    lobiMi() {
      return !!(this._noa && !this.oyundaMi());
    }
 
    durum(id, bilesen) {
      return SaidUtils.dene(() => this._noa.entities.getState(id, bilesen));
    }
 
    konum(id = 1) {
      return this.durum(id, 'position')?.position ?? null;
    }
 
    hayattaMi(id = 1) {
      return this.durum(id, 'genericLifeformState')?.isAlive ?? true;
    }
 
    oyuncuIdleri() {
      return SaidUtils.dene(() => values(this._noa?.bloxd?.getPlayerIds?.() ?? {}), []);
    }
 
    hayattaOlanOyuncular() {
      return this.oyuncuIdleri().filter(id => id !== 1 && this.hayattaMi(id));
    }
 
    tumOyuncular() {
      return this.oyuncuIdleri().filter(id => id !== 1);
    }
 
    oyuncuSayisi() {
      return this.oyuncuIdleri().length - 1;
    }
 
    hayattaOlanOyuncuSayisi() {
      return this.hayattaOlanOyuncular().length;
    }
 
    tutulanEsya(id = 1) {
      if (!this._noa) return null;
      let cached = this._tutulanCache;
      if (!cached) {
        const comp = Object.values(this._noa.entities.components).find(c => 
          Object.values(c).some(v => v && typeof v == "object" && "fistItem" in v)
        );
        if (!comp) return null;
        cached = id => this._noa.entities.getState(id, comp.name);
        this._tutulanCache = cached;
      }
      return SaidUtils.dene(() => cached(id));
    }
 
    _tutulanCache = null;
 
    esyaTipi(id = 1) {
      const item = this.tutulanEsya(id)?._standardItem;
      return item?.typeObj?.constructor?.name || null;
    }
 
    esyaBlokMu(id = 1) {
      return this.esyaTipi(id) === 'Block';
    }
 
    esyaAletMi(id = 1) {
      return this.esyaTipi(id) === 'Tool';
    }
 
    esyaYemekMi(id = 1) {
      return this.esyaTipi(id) === 'Food';
    }
 
    saldir(id, options = {}) {
      const varsayilan = { geriTepme: 0.6, cekme: false, cekmeGucu: 1, salla: true };
      const opts = { ...varsayilan, ...options };
      
      SaidUtils.dene(() => {
        const yumruk = this.tutulanEsya()?.fistItem;
        if (!yumruk) return;
 
        const proto = Object.getPrototypeOf(yumruk);
        const saldiriFn = Object.getOwnPropertyNames(proto)
          .map(k => yumruk[k])
          .find(f => typeof f === 'function' && f.length === 3 && f.toString().includes('canAttack'));
        if (typeof saldiriFn !== 'function') return;
 
        const hedefKonum = this.konum(id);
        const kendiKonum = this.konum();
        if (!hedefKonum || !kendiKonum) return;
 
        const dx = hedefKonum[0] - kendiKonum[0];
        const dy = hedefKonum[1] - kendiKonum[1] + 1;
        const dz = hedefKonum[2] - kendiKonum[2];
        const mesafe = Math.hypot(dx, dy, dz) || 1;
        const kuvvet = opts.geriTepme * opts.cekmegucu * (opts.cekmemi? -1 : 1);
 
        const yon = [dx / mesafe * kuvvet, dy / mesafe * kuvvet, dz / mesafe * kuvvet];
        saldiriFn.call(yumruk, yon, String(id), 'BodyMesh');
        if (opts.salla) this.salla();
      });
    }
 
    salla(zamanDamgasi = Date.now(), istemciSalla = true, sunucuSalla = true) {
      SaidUtils.dene(() => {
        const tutulan = this.tutulanEsya();
        if (!tutulan) return;
        const esya = tutulan?._standardItem;
        if (istemciSalla && typeof esya?.trySwingBlock === 'function') {
          esya.trySwingBlock(zamanDamgasi);
        }
        if (sunucuSalla) {
          this.durum(1, 'moveState')?.setArmsAreSwinging?.(true);
        }
      });
    }
 
    girdiGonder(eylem, basili, zaman = null) {
      SaidUtils.dene(() => {
        const inp = this._noa?.inputs;
        if (!inp) return;
        const kova = basili ? inp.down : inp.up;
        if (typeof kova.emit === 'function') {
          kova.emit(eylem, {
            timeStamp: zaman || performance.now(),
            preventDefault: () => {},
            stopPropagation: () => {}
          });
        }
      });
    }
 
    girdiTikla(eylem) {
      this.girdiGonder(eylem, true);
      setTimeout(() => this.girdiGonder(eylem, false), 20);
    }
 
    isinAyarla(etkin) {
      SaidUtils.dene(() => {
        if (!this._noa) return;
        const renderer = values(this._noa)[12];
        const inceMeshlar = values(renderer ?? {}).find(v => v?.thinMeshes)?.thinMeshes;
        if (!Array.isArray(inceMeshlar)) return;
        for (const giris of inceMeshlar) {
          const mesh = giris?.meshVariations?.__DEFAULT__?.mesh;
          if (mesh && typeof mesh.renderingGroupId === 'number') {
            mesh.renderingGroupId = etkin ? 2 : 0;
          }
        }
      });
    }
 
    isinRenkAyarla(renk) {
      SaidUtils.dene(() => {
        if (!this._noa) return;
        const renderer = values(this._noa)[12];
        const inceMeshlar = values(renderer ?? {}).find(v => v?.thinMeshes)?.thinMeshes;
        if (!Array.isArray(inceMeshlar)) return;
        for (const giris of inceMeshlar) {
          const mesh = giris?.meshVariations?.__DEFAULT__?.mesh;
          if (mesh && typeof mesh.material === 'object') {
            const mat = mesh.material;
            if (mat.diffuseColor) {
              mat.diffuseColor.r = renk[0] || 1;
              mat.diffuseColor.g = renk[1] || 0;
              mat.diffuseColor.b = renk[2] || 0;
            }
          }
        }
      });
    }
 
    atesEt() {
      this.girdiTikla('primary-fire');
    }
 
    sagTikla() {
      this.girdiTikla('alt-fire');
    }
 
    zipla() {
      this.girdiGonder('jump', true);
      setTimeout(() => this.girdiGonder('jump', false), 50);
    }
 
    yuru(yon) {
      const state = this._noa?.inputs?.state;
      if (!state) return;
      state.forward = yon.ileri || false;
      state.backward = yon.geri || false;
      state.left = yon.sol || false;
      state.right = yon.sag || false;
    }
 
    yurumeyiDurdur() {
      const state = this._noa?.inputs?.state;
      if (!state) return;
      state.forward = false;
      state.backward = false;
      state.left = false;
      state.right = false;
    }
  }
 
