  class SaidClient {
    constructor() {
      this.moduller = {};
      this.kisayollar = { menu: 'ShiftRight' };
      this._baslatildi = false;
      this._zaman = 0;
    }
 
    modulEkle(mod) {
      this.moduller[mod.isim] = mod;
    }
 
    modulBul(isim) {
      return this.moduller[isim] || null;
    }
 
    modulAc(isim) {
      const mod = this.modulBul(isim);
      if (mod) mod.acKapa(true);
      return mod;
    }
 
    modulKapa(isim) {
      const mod = this.modulBul(isim);
      if (mod) mod.acKapa(false);
      return mod;
    }
 
    modulDurum(isim) {
      const mod = this.modulBul(isim);
      return mod ? mod.etkin : false;
    }
 
    tumModuller() {
      return values(this.moduller);
    }
 
    aktifModuller() {
      return this.tumModuller().filter(m => m.etkin);
    }
 
    kategoriModulleri(kategori) {
      return this.tumModuller().filter(m => m.kategori === kategori);
    }
 
    kisayolAta(modIsim, tus) {
      this.kisayollar[modIsim] = tus;
      SaidStorage.debounced();
    }
 
    kisayolAl(modIsim) {
      return this.kisayollar[modIsim] || null;
    }
 
    kisayolKaldir(modIsim) {
      delete this.kisayollar[modIsim];
      SaidStorage.debounced();
    }
 
    baslat() {
      if (this._baslatildi) return;
      this._baslatildi = true;
      this._zaman = performance.now();
    }
 
    render(zaman) {
      const dt = this._zaman ? (zaman - this._zaman) / 1000 : 0;
      this._zaman = zaman;
      for (const mod of this.tumModuller()) {
        mod.render(zaman, dt);
      }
    }
 
    tik(zaman) {
      for (const mod of this.tumModuller()) {
        mod.tik(zaman);
      }
    }
  }
 
