            '• Modülleri tıklayarak aç/kapat\n' +
            '• Kısayol tuşlarına tıklayarak değiştir\n\n' +
            '🎯 Özellikler:\n' +
            '• Kill Aura - Otomatik saldırı\n' +
            '• Aimbot - Otomatik nişan alma\n' +
            '• Sol/Sağ Tıklayıcı - Otomatik tıklama\n' +
            '• BHOP - Gelişmiş zıplama\n' +
            '• Hız / Uçuş - Hareket hileleri\n' +
            '• Işın / ESP - Görsel yardımcılar\n' +
            '• Anti-Ban - Tespit koruması\n' +
            '• Ve daha fazlası...\n\n' +
            '❤️ GitHub: https://github.com/SaidDeveloper07'
          );
        });
      }
 
      // Küçült
      let kucuk = false;
      const kucult = document.getElementById('ch-kucult');
      if (kucult) {
        kucult.addEventListener('click', () => {
          kucuk = !kucuk;
          kok.classList.toggle('mini', kucuk);
        });
      }
    }
 
    _suruklemeyiBagla(kok) {
      const baslik = document.getElementById('ch-hdr');
      if (!baslik) return;
      
      baslik.addEventListener('mousedown', (e) => {
        if (e.target !== baslik && !e.target.closest('#ch-title') && !e.target.closest('.ch-hbtn')) {
          return;
        }
        if (e.target.closest('.ch-hbtn')) return;
        
        e.preventDefault();
        const rect = kok.getBoundingClientRect();
        const ofsetX = e.clientX - rect.left;
        const ofsetY = e.clientY - rect.top;
 
        const hareket = (ev) => {
          const maxX = window.innerWidth - rect.width;
          const maxY = window.innerHeight - rect.height;
          const newX = Math.min(Math.max(ev.clientX - ofsetX, 0), maxX);
          const newY = Math.min(Math.max(ev.clientY - ofsetY, 0), maxY);
          kok.style.left = `${newX}px`;
          kok.style.top = `${newY}px`;
          kok.style.right = 'unset';
        };
        
        const birak = () => {
          document.removeEventListener('mousemove', hareket);
          document.removeEventListener('mouseup', birak);
          baslik.style.cursor = 'grab';
        };
        
        document.addEventListener('mousemove', hareket);
        document.addEventListener('mouseup', birak);
        baslik.style.cursor = 'grabbing';
      });
    }
  }
 
