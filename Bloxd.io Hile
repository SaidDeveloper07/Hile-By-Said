  class SaidModule {
    constructor(isim, kategori, tanim = {}) {
      this.isim = isim;
      this.kategori = kategori;
      this.ayarlar = tanim.ayarlar ?? {};
      this.kisayol = tanim.kisayol ?? null;
      this.govdeVar = tanim.govdeVar ?? (Object.keys(this.ayarlar).length > 0);
      this.etkin = false;
      this.zamanlayici = null;
      this._acilista = tanim.acilista ?? null;
      this._kapanista = tanim.kapanista ?? null;
      this._renderda = tanim.renderda ?? null;
      this._update = tanim.update ?? null;
      this._tik = tanim.tik ?? null;
      this._ozelGosterge = tanim.ozelGosterge ?? null;
 
      for (const [anahtar, schema] of entries(this.ayarlar)) {
        this[anahtar] = schema.varsayilan;
      }
 
      this._id = this._slugOlustur(isim);
      SaidClient.moduller[isim] = this;
    }
 
    _slugOlustur(str) {
      return str.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    }
 
    id() { return this._id; }
 
    acKapa(zorla) {
      const sonraki = zorla ?? !this.etkin;
      if (sonraki === this.etkin) return this.etkin;
      this.etkin = sonraki;
      if (sonraki) {
        if (this._acilista) this._acilista.call(this);
      } else {
        if (this._kapanista) this._kapanista.call(this);
      }
      SaidStorage.debounced();
      return this.etkin;
    }
 
    render(zaman, dt) {
      if (this.etkin) {
        if (this._renderda) this._renderda.call(this, zaman, dt);
        if (this._update) this._update.call(this, dt);
      }
    }
 
    tik(zaman) {
      if (this.etkin && this._tik) {
        this._tik.call(this, zaman);
      }
    }
 
    ayarAl(anahtar) {
      return this[anahtar];
    }
 
    ayarAta(anahtar, deger) {
      this[anahtar] = deger;
      SaidStorage.debounced();
    }
  }
 
