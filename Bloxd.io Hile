          display: none;
          flex-direction: column;
          gap: 8px;
          padding: 2px 0;
        }
        
        .ch-tab-panel.active { display: flex; }
        
        #ch-body {
          padding: 10px 10px 8px 10px;
          display: flex;
          flex-direction: column;
          gap: 7px;
          max-height: calc(100vh - 140px);
          overflow-y: auto;
          overflow-x: hidden;
        }
        
        #ch-body::-webkit-scrollbar { width: 4px; }
        #ch-body::-webkit-scrollbar-track { background: transparent; }
        #ch-body::-webkit-scrollbar-thumb {
          background: var(--ch-accent-1);
          border-radius: 4px;
        }
        
        /* Modül Bölümleri */
        .ch-sec {
          display: flex;
          flex-direction: column;
          background: var(--ch-panel);
          border-radius: 10px;
          border: 1px solid var(--ch-panel-border);
          overflow: hidden;
          transition: all 0.3s ease;
        }
        
        .ch-sec:hover {
          border-color: var(--ch-accent-1);
          box-shadow: 0 0 20px rgba(124, 58, 237, 0.05);
        }
        
        .ch-sec-hdr {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 9px 12px;
          cursor: pointer;
          transition: all 0.25s ease;
        }
        
        .ch-sec-hdr:hover {
          background: rgba(139, 92, 246, 0.06);
        }
        
        .ch-lbl {
          font-size: 10px;
          font-weight: 700;
          color: var(--ch-text-dim2);
          text-transform: uppercase;
          letter-spacing: 0.9px;
          transition: color 0.25s ease;
        }
        
        .ch-sec.expanded .ch-lbl {
          color: var(--ch-text);
        }
        
        .ch-sec-arrow {
          width: 20px;
          height: 20px;
          display: flex;
          align-items: center;
          justify-content: center;
          color: var(--ch-text-dim2);
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          flex-shrink: 0;
          font-size: 10px;
        }
        
        .ch-sec.expanded .ch-sec-arrow {
          transform: rotate(180deg);
          color: var(--ch-accent-2);
        }
        
        .ch-sec-body {
          display: grid;
          grid-template-rows: 0fr;
          opacity: 0;
          transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                      opacity 0.25s ease,
                      padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          padding: 0 12px;
        }
        
        .ch-sec-body > div {
          overflow: hidden;
          min-height: 0;
        }
        
        .ch-sec.expanded .ch-sec-body {
          grid-template-rows: 1fr;
          opacity: 1;
          padding: 2px 12px 12px;
        }
        
        .ch-sec-toprow {
          padding: 8px 12px;
          border-top: 1px solid rgba(255,255,255,0.03);
        }
        
        .ch-sec-hdr + .ch-sec-toprow {
          border-top: 1px solid rgba(255,255,255,0.03);
        }
        
        /* Modül Satırları */
        .mod-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 3px 0;
        }
        
        .mod-left {
          display: flex;
          align-items: center;
          gap: 10px;
          flex: 1;
        }
        
        .mod-name {
          font-size: 12px;
          font-weight: 600;
          color: var(--ch-text);
        }
        
        /* Toggle Butonu */
        .tg {
          width: 36px;
          height: 20px;
          background: var(--ch-off);
          border-radius: 10px;
          position: relative;
          cursor: pointer;
          transition: all 0.3s ease;
          flex-shrink: 0;
        }
        
        .tg::after {
          content: '';
          width: 16px;
          height: 16px;
          background: #9B8AB5;
          border-radius: 50%;
          position: absolute;
          top: 2px;
          left: 2px;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          box-shadow: 0 1px 4px rgba(0,0,0,0.2);
        }
        
        .tg:hover::after {
          background: #B8A6D0;
        }
        
        .tg.on {
          background: linear-gradient(90deg, var(--ch-accent-1), var(--ch-accent-2));
          box-shadow: 0 0 15px rgba(124, 58, 237, 0.4);
        }
        
        .tg.on::after {
          left: 18px;
          background: #fff;
          box-shadow: 0 1px 6px rgba(0,0,0,0.3);
        }
        
        .tg.on:hover::after {
          background: #fff;
        }
        
        /* Klavye Kısayol */
        .kb {
          background: rgba(0,0,0,0.3);
          border: 1px solid rgba(139, 92, 246, 0.15);
          color: var(--ch-text-dim);
          font-size: 9px;
          font-weight: 700;
          padding: 3px 8px;
          border-radius: 6px;
          cursor: pointer;
          transition: all 0.25s ease;
          display: flex;
          align-items: center;
          gap: 5px;
          font-family: 'Montserrat', monospace;
          letter-spacing: 0.3px;
          min-width: 32px;
          justify-content: center;
        }
        
        .kb:hover {
          background: rgba(139, 92, 246, 0.15);
          border-color: var(--ch-accent-1);
          color: var(--ch-text);
          box-shadow: 0 0 12px rgba(139, 92, 246, 0.1);
        }
        
        .kb.listening {
          border-color: var(--ch-accent-3);
          color: #fff;
          background: rgba(139, 92, 246, 0.2);
          animation: kbpulse 0.9s ease infinite;
          box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
        }
        
        @keyframes kbpulse {
          0%, 100% { opacity: 1; }
          50% { opacity: 0.6; }
