      "Renk Yeşil": { tip: "kaydirici", min: 0, max: 1, adim: 0.01, varsayilan: 1 },
      "Renk Mavi": { tip: "kaydirici", min: 0, max: 1, adim: 0.01, varsayilan: 0 },
      "Yazı Boyutu": { tip: "kaydirici", min: 10, max: 30, adim: 1, varsayilan: 14 }
    },
    acilista() {
      this._espler = [];
      this._canvas = null;
      this._ctx = null;
      this._olusturCanvas();
    },
    kapanista() {
      if (this._canvas) {
        this._canvas.remove();
        this._canvas = null;
        this._ctx = null;
      }
    },
    _olusturCanvas() {
      if (this._canvas) return;
      this._canvas = document.createElement('canvas');
      this._canvas.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 99998;
        background: transparent;
      `;
      document.body.appendChild(this._canvas);
      this._ctx = this._canvas.getContext('2d');
      this._canvas.width = window.innerWidth;
      this._canvas.height = window.innerHeight;
      window.addEventListener('resize', () => {
        if (this._canvas) {
          this._canvas.width = window.innerWidth;
          this._canvas.height = window.innerHeight;
        }
      });
    },
    renderda() {
      if (!this._canvas || !this._ctx) return;
      
      const ctx = this._ctx;
      ctx.clearRect(0, 0, this._canvas.width, this._canvas.height);
      
      const kendiKonum = SaidGame.konum();
      if (!kendiKonum) return;
      
      const kamera = SaidGameConnectorInstance._noa?.camera;
      if (!kamera) return;
      
      const menzilKare = this.Menzil * this.Menzil;
      const renk = `rgba(${this["Renk Kırmızı"] * 255}, ${this["Renk Yeşil"] * 255}, ${this["Renk Mavi"] * 255}, 0.8)`;
      const boyut = this["Yazı Boyutu"] || 14;
      
      ctx.font = `${boyut}px Arial`;
      ctx.textAlign = 'center';
      
      for (const id of SaidGame.tumOyuncular()) {
        const konum = SaidGame.konum(id);
        if (!konum) continue;
        
        const mesafeKare = SaidMath.mesafeKare3D(konum, kendiKonum);
        if (mesafeKare > menzilKare) continue;
        
        // 3D'den 2D'ye projeksiyon
        const dx = konum[0] - kendiKonum[0];
        const dy = konum[1] - kendiKonum[1] + 1.5;
        const dz = konum[2] - kendiKonum[2];
        
        // Dünya koordinatlarını ekran koordinatlarına çevir
        const yaw = kamera.heading;
        const pitch = kamera.pitch;
        const fov = 60 * PI / 180;
        
        // Basit projeksiyon
        const cosYaw = Math.cos(yaw);
        const sinYaw = Math.sin(yaw);
        const cosPitch = Math.cos(pitch);
        const sinPitch = Math.sin(pitch);
        
        const x = dx * cosYaw + dz * sinYaw;
        const y = dx * sinYaw * sinPitch - dy * cosPitch + dz * cosYaw * sinPitch;
        const z = dx * sinYaw * cosPitch + dy * sinPitch + dz * cosYaw * cosPitch;
        
        if (z > 0) {
          const scale = 1 / (z * 0.1 + 1);
          const screenX = this._canvas.width / 2 + x * scale * (this._canvas.width / 2) / Math.tan(fov / 2);
          const screenY = this._canvas.height / 2 - y * scale * (this._canvas.width / 2) / Math.tan(fov / 2);
          
          if (screenX > 0 && screenX < this._canvas.width && screenY > 0 && screenY < this._canvas.height) {
            ctx.fillStyle = renk;
            
            let metin = '';
            if (this["İsim Göster"]) {
              const isim = SaidUtils.dene(() => SaidGameConnectorInstance._noa?.bloxd?.getPlayerName?.(id) || `Player ${id}`);
              metin += isim + ' ';
            }
            if (this["Can Göster"]) {
              const can = SaidUtils.dene(() => SaidGame.durum(id, 'genericLifeformState')?.health ?? 20);
              metina += `❤️${can} `;
            }
            if (this["Mesafe Göster"]) {
              const mesafe = Math.sqrt(mesafeKare);
              metina += `${Math.round(mesafe)}m`;
            }
            
            ctx.fillText(metin, screenX, screenY);
            
            // Çizgi ile gösterme
            ctx.beginPath();
            ctx.arc(screenX, screenY - 20, 5, 0, 2 * PI);
            ctx.fillStyle = renk;
            ctx.fill();
          }
        }
      }
    }
  });
 
