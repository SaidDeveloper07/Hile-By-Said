// @description  Kill Aura, Otomatik Tıklama, Aimbot, Görsel Ayarlar - Said tarafından düzenlendi
// @author       Said
 
// @match        *://*.bloxd.io/*
// @match        *://*.bloxd.com/*
// @match        *://*.bloxd.dev/*
// @match        *://*.bloxdhop.io/*
