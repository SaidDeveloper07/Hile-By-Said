        const cookies = document.cookie.split(';');
        let bilgi = 'Çerezler:\n';
        cookies.forEach(c => bilgi += `- ${c.trim()}\n`);
        return bilgi;
      } catch (e) {
        return 'Hesap bilgisi alınamadı.';
      }
    }
  }
 
