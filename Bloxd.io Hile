      `;
      return css;
    }
  };
 
  // UI Oluşturucu - Said'in mor menüsü
  const UIOlusturucu = {
    acKapaOlustur(mod) {
      const kisayolAnahtar = mod.isim;
      const kod = istemci.kisayollar[kisayolAnahtar];
      const varMi = !!kod;
      return `
        <div class="mod-row" id="satir-${mod.id()}" data-mod="${mod.isim}">
          <div class="mod-left">
            <div class="tg${mod.etkin ? ' on' : ''}" id="tg-${mod.id()}"></div>
            <span class="mod-name">${mod.isim}</span>
          </div>
          <div class="mod-right">
            <div class="kb" id="bagla-${mod.id()}" data-eylem="${kisayolAnahtar}">
              <i class="fa-solid fa-keyboard" style="font-size:8px;opacity:0.6;"></i>
              <span class="kb-text">${varMi ? UIYardim.kisayolGoster(kod) : '—'}</span>
              <span class="kb-x" data-ayir="${kisayolAnahtar}" style="${varMi ? '' : 'display:none'}">✕</span>
            </div>
          </div>
        </div>`;
    },
 
    mantiksalOlustur(mod, anahtar, schema) {
      const deger = mod[anahtar];
      return `
        <div class="mod-row" onclick="event.stopPropagation()" style="margin-top: 7px; padding: 0;" data-mantiksal="${mod.isim}::${anahtar}">
          <span class="sl-label" style="width: auto; flex: 1;">${anahtar}</span>
          <div class="tg${deger ? ' on' : ''}" id="bool-${mod.id()}-${slug(anahtar)}"></div>
        </div>`;
    },
 
    kaydiriciOlustur(mod, anahtar, schema) {
      const deger = mod[anahtar];
      return `<div class="sl-row" data-kaydirici="${mod.isim}::${anahtar}">
        <span class="sl-label">${anahtar}</span>
        <input type="range" id="sl-${mod.id()}-${slug(anahtar)}" min="${schema.min}" max="${schema.max}" adim="${schema.adim}" value="${deger}">
        <input type="text" class="sl-val-inp" id="sl-${mod.id()}-${slug(anahtar)}-v" value="${deger}">
      </div>`;
    },
 
    ayarGovdesiOlustur(mod) {
      let html = '';
      let sonGrup = null;
      for (const [anahtar, schema] of entries(mod.ayarlar)) {
        if (schema.grup && schema.grup !== sonGrup) {
          html += sonGrup ? `<div class="ch-divider"></div>` : '';
          html += `<div class="ch-group-lbl">${schema.grup}</div>`;
        } else if (!schema.grup && sonGrup) {
          html += `<div class="ch-divider"></div>`;
        }
        sonGrup = schema.grup ?? null;
        
        if (schema.tip === "mantiksal") {
          html += this.mantiksalOlustur(mod, anahtar, schema);
        } else {
          html += this.kaydiriciOlustur(mod, anahtar, schema);
        }
      }
      return html;
    },
 
    modulBolumuOlustur(mod, genisletilmis = false) {
      const govde = mod.govdeVar ? this.ayarGovdesiOlustur(mod) : '';
      const govdeVarMi = !!govde;
      return `
        <div class="ch-sec${genisletilmis && govdeVarMi ? ' expanded' : ''}" id="sec-${mod.id()}">
          <div class="ch-sec-hdr" ${govdeVarMi ? `data-sec-toggle="${mod.id()}"` : 'style="cursor:default;"'}>
            <span class="ch-lbl">${mod.isim}</span>
            ${govdeVarMi ? `<div class="ch-sec-arrow"><i class="fa-solid fa-chevron-down"></i></div>` : ''}
          </div>
          <div class="ch-sec-toprow">${this.acKapaOlustur(mod)}</div>
          ${govdeVarMi ? `<div class="ch-sec-body"><div>${govde}</div></div>` : ''}
        </div>`;
    },
 
    kategorilereAyir() {
      const sira = [];
      const kategoriyeGore = {};
      for (const mod of values(istemci.moduller)) {
        if (!kategoriyeGore[mod.kategori]) { kategoriyeGore[mod.kategori] = []; sira.push(mod.kategori); }
        kategoriyeGore[mod.kategori].push(mod);
      }
      return { sira, kategoriyeGore };
    },
 
    kategoriIkon(kat) {
      return ({ Savaş: 'fa-crosshairs', Hareket: 'fa-person-running', Görseller: 'fa-eye', Yardımcı: 'fa-toolbox' })[kat] ?? 'fa-cube';
    },
 
    olustur() {
      const mevcut = document.getElementById('ch-root');
      if (mevcut) return mevcut;
 
      document.head.appendChild(UIYardim.stilOlustur());
 
      const { sira, kategoriyeGore } = this.kategorilereAyir();
 
      const sekmelerHtml = sira.map((kat, i) => `
        <button class="ch-tab${i === 0 ? ' active' : ''}" data-sekme="${slug(kat)}">
          <i class="fa-solid ${this.kategoriIkon(kat)}"></i>${kat}
        </button>`).join('');
 
      const panellerHtml = sira.map((kat, i) => `
        <div class="ch-tab-panel${i === 0 ? ' active' : ''}" data-panel="${slug(kat)}">
          ${kategoriyeGore[kat].map(mod => this.modulBolumuOlustur(mod)).join('')}
        </div>`).join('');
 
      const kok = document.createElement('div');
      kok.id = 'ch-root';
      kok.innerHTML = `
        <div id="ch-hdr">
          <span id="ch-title">CLICK HELPER <span style="color: #A78BFA;">SAİD</span> <span>v2.0</span></span>
          <div style="display:flex;gap:5px;">
            <button class="ch-hbtn" id="ch-yeni-hesap" title="Yeni Hesap"><i class="fa-solid fa-user-plus"></i></button>
            <button class="ch-hbtn" id="ch-enjekte" title="Enjekte Et"><i class="fa-solid fa-syringe"></i></button>
            <button class="ch-hbtn" id="ch-kucult" title="Küçült">—</button>
          </div>
        </div>
        <div id="ch-tabs">${sekmelerHtml}</div>
        <div id="ch-body">${panellerHtml}</div>
        <div id="ch-status">
          <span><span class="dot red" id="st-dot"></span><span id="st-txt">Oyun bekleniyor</span></span>
          <span style="opacity:0.6; color: #A78BFA;">SAĞ SHIFT = MENÜ</span>
        </div>
      `;
 
      UIYardim.guvenliEkle(kok);
      return kok;
    }
  };
 
  // Girdi İşleyici - Said'in kontrol sistemi
  const GirdiIsleyici = {
    dinlemeBaglanti: null,
 
    baslat(kok) {
      this._sekmeleriBagla(kok);
      this._bolumleriBagla(kok);
      this._acKapalariBagla(kok);
      this._kaydiricilariBagla(kok);
      this._mantiksalBagla(kok);
      this._kisayolYakalamayiBagla(kok);
      this._globalTusBagla(kok);
      this._butonlariBagla(kok);
      this._suruklemeyiBagla(kok);
    },
 
    _sekmeleriBagla(kok) {
      const sekmeler = kok.querySelectorAll('.ch-tab');
      const paneller = kok.querySelectorAll('.ch-tab-panel');
      sekmeler.forEach(sekme => sekme.addEventListener('click', () => {
        sekmeler.forEach(s => s.classList.remove('active'));
        paneller.forEach(p => p.classList.remove('active'));
        sekme.classList.add('active');
        kok.querySelector(`.ch-tab-panel[data-panel="${sekme.dataset.sekme}"]`)?.classList.add('active');
      }));
    },
 
    _bolumleriBagla(kok) {
      kok.querySelectorAll('[data-sec-toggle]').forEach(baslik => {
        baslik.addEventListener('click', () => document.getElementById(`sec-${baslik.dataset.secToggle}`)?.classList.toggle('expanded'));
      });
    },
 
    _acKapalariBagla(kok) {
      kok.querySelectorAll('.ch-sec-toprow .mod-row').forEach(satir => {
        const mod = istemci.moduller[satir.dataset.mod];
        if (!mod) return;
        const tg = document.getElementById(`tg-${mod.id()}`);
        satir.addEventListener('click', e => {
          if (e.target.closest('.kb') || e.target.classList.contains('kb-x')) return;
          tg.classList.toggle('on', mod.acKapa());
          Depolama.yavaslatilmis();
        });
      });
    },
 
    _kaydiricilariBagla(kok) {
      kok.querySelectorAll('[data-kaydirici]').forEach(satir => {
        const [modIsim, anahtar] = satir.dataset.kaydirici.split('::');
        const mod = istemci.moduller[modIsim];
        const taban = `sl-${mod.id()}-${slug(anahtar)}`;
        const aralik = document.getElementById(taban);
        const sayi = document.getElementById(`${taban}-v`);
        if (!aralik || !sayi) return;
 
        const uygula = (hamDeger, metinGeldi) => {
          if (metinGeldi && (hamDeger === '' || hamDeger === '-' || hamDeger.endsWith('.'))) return;
          const v = parseFloat(hamDeger);
          if (Number.isNaN(v)) return;
          aralik.value = v;
          if (!metinGeldi) sayi.value = v;
          mod[anahtar] = v;
          if (anahtar === "Max CPS" && mod["Min CPS"] > v) {
            mod["Min CPS"] = v;
            const minAralik = document.getElementById(`sl-${mod.id()}-min-cps`);
            const minSayi = document.getElementById(`sl-${mod.id()}-min-cps-v`);
            if (minAralik) minAralik.value = v;
            if (minSayi) minSayi.value = v;
          }
          else if (anahtar === "Min CPS" && mod["Max CPS"] < v) {
            mod["Max CPS"] = v;
            const maxAralik = document.getElementById(`sl-${mod.id()}-max-cps`);
            const maxSayi = document.getElementById(`sl-${mod.id()}-max-cps-v`);
            if (maxAralik) maxAralik.value = v;
            if (maxSayi) maxSayi.value = v;
          }
          Depolama.yavaslatilmis();
        };
 
        aralik.addEventListener('input', e => uygula(e.target.value, false));
        sayi.addEventListener('input', e => uygula(e.target.value, true));
        sayi.addEventListener('blur', e => {
          const v = parseFloat(e.target.value);
          e.target.value = Number.isNaN(v) ? aralik.value : v;
          if (!Number.isNaN(v)) uygula(e.target.value, false);
        });
        sayi.addEventListener('keydown', e => e.stopPropagation(), true);
      });
    },
	
    _mantiksalBagla(kok) {
      kok.querySelectorAll('[data-mantiksal]').forEach(satir => {
        const [modIsim, anahtar] = satir.dataset.mantiksal.split('::');
        const mod = istemci.moduller[modIsim];
        const tg = document.getElementById(`bool-${mod.id()}-${slug(anahtar)}`);
        if (!tg) return;
 
        satir.addEventListener('click', () => {
          const yeniDeger = !mod[anahtar];
          mod[anahtar] = yeniDeger;
          tg.classList.toggle('on', yeniDeger);
          Depolama.yavaslatilmis();
        });
      });
    },
 
    _kisayolYakalamayiBagla(kok) {
      kok.addEventListener('click', e => {
        const ayirEl = e.target.closest('[data-ayir]');
        if (ayirEl) {
          e.stopPropagation();
          this._kisayolAyarla(ayirEl.dataset.ayir, '');
          return;
        }
        const kbEl = e.target.closest('.kb');
        const eylem = kbEl?.dataset.eylem;
        if (!eylem) return;
 
        if (this.dinlemeBaglanti) this._kisayolGorunumSifirla(this.dinlemeBaglanti);
        this.dinlemeBaglanti = eylem;
        kbEl.classList.add('listening');
        kbEl.querySelector('.kb-text').innerText = '…';
      });
    },
 
    _kisayolGorunumSifirla(eylem) {
      const el = document.getElementById(`bagla-${istemci.moduller[eylem]?.id() ?? eylem}`);
      if (!el) return;
      el.classList.remove('listening');
      el.querySelector('.kb-text').innerText = UIYardim.kisayolGoster(istemci.kisayollar[eylem]) || '—';
    },
 
    _kisayolAyarla(eylem, kod) {
      istemci.kisayollar[eylem] = kod;
      const el = document.getElementById(`bagla-${istemci.moduller[eylem]?.id() ?? eylem}`);
      if (el) {
        el.querySelector('.kb-text').innerText = kod ? UIYardim.kisayolGoster(kod) : '—';
        el.classList.remove('listening');
        const x = el.querySelector('.kb-x');
        if (x) x.style.display = kod ? '' : 'none';
      }
      Depolama.yavaslatilmis();
    },
 
    _globalTusBagla(kok) {
      let gorunur = true;
      document.addEventListener('keydown', e => {
        if (e.repeat) return;
 
        if (this.dinlemeBaglanti) {
          e.preventDefault(); e.stopPropagation();
          if (e.code === 'Escape') this._kisayolGorunumSifirla(this.dinlemeBaglanti);
          else if (e.code === 'Backspace') this._kisayolAyarla(this.dinlemeBaglanti, '');
          else this._kisayolAyarla(this.dinlemeBaglanti, e.code);
          this.dinlemeBaglanti = null;
          return;
        }
 
        if (e.code === istemci.kisayollar.menu) {
          gorunur = !gorunur;
          kok.classList.toggle('hidden', !gorunur);
          return;
        }
 
        if (document.activeElement?.tagName === 'INPUT') return;
 
        for (const mod of values(istemci.moduller)) {
          if (istemci.kisayollar[mod.isim] === e.code) {
            const tg = document.getElementById(`tg-${mod.id()}`);
            if (tg) tg.classList.toggle('on', mod.acKapa());
          }
        }
      }, true);
    },
 
    _butonlariBagla(kok) {
      document.getElementById('ch-yeni-hesap').addEventListener('click', () => {
        if (confirm('Yeni bir hesap oluşturmak için çerezler ve depolama temizlenecek. Devam etmek istediğine emin misin?')) HesapModulu.temizleVeYenidenYukle();
      });
      document.getElementById('ch-enjekte').addEventListener('click', () => { if (!baglanti.enjekteEdildi) baglanti.baslat(); });
 
      let kucuk = false;
      document.getElementById('ch-kucult').addEventListener('click', () => kok.classList.toggle('mini', kucuk = !kucuk));
    },
 
    _suruklemeyiBagla(kok) {
      const baslik = document.getElementById('ch-hdr');
      baslik.addEventListener('mousedown', e => {
        if (e.target !== baslik && !e.target.closest('#ch-title')) return;
        e.preventDefault();
        const dikdortgen = kok.getBoundingClientRect();
        const ofsetX = e.clientX - dikdortgen.left, ofsetY = e.clientY - dikdortgen.top;
 
        const hareket = ev => {
          const maxX = window.innerWidth - dikdortgen.width, maxY = window.innerHeight - dikdortgen.height;
          kok.style.left = `${matematik.sinirla(ev.clientX - ofsetX, 0, maxX)}px`;
          kok.style.top = `${matematik.sinirla(ev.clientY - ofsetY, 0, maxY)}px`;
          kok.style.right = 'unset';
        };
        const birak = () => {
          document.removeEventListener('mousemove', hareket);
          document.removeEventListener('mouseup', birak);
          baslik.style.cursor = 'grab';
        };
        document.addEventListener('mousemove', hareket);
        document.addEventListener('mouseup', birak);
        baslik.style.cursor = 'grabbing';
      });
    }
  };
 
  // Zamanlayıcı - Said'in render sistemi
  const zamanlayici = {
    oyunda: false,
    _sonZaman: 0,
 
    baslat() { requestAnimationFrame(zaman => this.tik(zaman)); },
 
    tik(zaman) {
      requestAnimationFrame(zaman => this.tik(zaman));
 
      const simdiOyunda = oyun.oyundaMi();
      if (simdiOyunda !== this.oyunda) {
        this.oyunda = simdiOyunda;
        const nokta = document.getElementById('st-dot');
        const yazi = document.getElementById('st-txt');
        if (nokta && yazi) {
          if (this.oyunda) { nokta.className = 'dot green'; yazi.innerText = 'Enjekte Edildi (Oyunda)'; }
          else if (baglanti.noa) { nokta.className = 'dot green'; yazi.innerText = 'Enjekte Edildi (Lobi)'; }
          else { nokta.className = 'dot red'; yazi.innerText = 'Oyun bekleniyor'; }
        }
      }
      if (!this.oyunda) return;
 
      const dt = this._sonZaman ? (zaman - this._sonZaman) / 1000 : 0;
      this._sonZaman = zaman;
      for (const mod of values(istemci.moduller)) mod.render(zaman, dt);
    }
  };
 
  let uiOlusturuldu = false;
  function baslatUI() {
    if (uiOlusturuldu) return;
    uiOlusturuldu = true;
    const kok = UIOlusturucu.olustur();
    GirdiIsleyici.baslat(kok);
  }
 
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', baslatUI);
  else baslatUI();
 
  console.log(
    "%c[Click Helper - Said]%c Bu script tespit edilebilir, asla ana hesabında kullanma!",
    "background: linear-gradient(90deg, #7C3AED, #8B5CF6); color: #fff; font-weight: bold; padding: 3px 8px; border-radius: 4px;",
    "color: #ff6688; font-weight: bold; margin-left: 6px;"
  );
 
  let baslatildi = false;
  const poll = setInterval(() => {
    if (!uiOlusturuldu) baslatUI();
    if (window.noa && !baslatildi) {
      baslatildi = true;
      baglanti.noa = window.noa;
      baglanti.enjekteEdildi = true;
      baglanti.enjeksiyonSonrasi();
      zamanlayici.baslat();
      clearInterval(poll);
    }
  }, 500);
})();
