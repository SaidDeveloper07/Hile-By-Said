    function toggleKillAura() {
        if (!window.bloxdToggles.killAura) {
            window.bloxdToggles.killAura = setInterval(() => {
                try {
                    const player = getPlayer();
                    if (!player) return;
                    // Yakındaki oyuncuları bul ve saldır
                    const players = document.querySelectorAll('[class*="player"], [class*="Player"]');
                    const pos = player.position || { x: 0, y: 0, z: 0 };
                    players.forEach(p => {
                        if (p === player) return;
                        const pPos = p.position || { x: 0, y: 0, z: 0 };
                        const dist = Math.sqrt(
                            Math.pow(pos.x - pPos.x, 2) +
                            Math.pow(pos.y - pPos.y, 2) +
                            Math.pow(pos.z - pPos.z, 2)
                        );
                        if (dist < 10) {
                            if (p.hit) p.hit();
                            if (p.damage) p.damage(999);
                            if (p.health !== undefined) p.health = 0;
                        }
                    });
