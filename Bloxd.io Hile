// @grant        none
// ==/UserScript==
 
(() => {
  'use strict';
 
  const { defineProperty, keys, values, entries, assign } = Object;
  const { hypot, atan2, sin, cos, abs, max, min, random, PI } = Math;
  const __call = (() => {}).call;
 
  // Said'in yardımcı fonksiyonları
  const yardim = {
    dene: (fn, varsayilan = null) => { try { return fn(); } catch { return varsayilan; } },
    _cache: Object.create(null),
    önbellek(key, deger) {
      if (deger === undefined) return this._cache[key];
      return (this._cache[key] = deger);
    },
    önbellekTemizle() { this._cache = Object.create(null); }
  };
 
  const matematik = {
    mesafeKare(a, b) {
      const dx = a[0] - b[0], dy = a[1] - b[1], dz = a[2] - b[2];
      return dx * dx + dy * dy + dz * dz;
    },
    sinirla: (v, alt, ust) => v < alt ? alt : v > ust ? ust : v,
    aciFarki: (a, b) => atan2(sin(a - b), cos(a - b))
  };
 
  // Oyun bağlantıları - Said'in geliştirdiği sistem
  const baglanti = {
    noa: null,
    enjekteEdildi: false,
 
    baslat() {
      if (this.enjekteEdildi) return;
      let yakalandi = false;
      defineProperty(Function.prototype, 'call', {
        enumerable: false,
        configurable: true,
        writable: true,
        value: function (thisArg, ...args) {
          if (!yakalandi) {
            const c = args[0];
            if (c && c.entities && c.bloxd) {
              yakalandi = true;
              window.noa = c;
              baglanti.noa = c;
              baglanti.enjekteEdildi = true;
              console.log(
                "%c[Click Helper - Said]%c Başarıyla enjekte edildi!",
                "background: linear-gradient(90deg, #8B5CF6, #A78BFA); color: #fff; font-weight: bold; padding: 3px 8px; border-radius: 4px;",
                "color: #50FA7B; font-weight: bold; margin-left: 6px;"
              );
              defineProperty(Function.prototype, 'call', { value: __call });
              baglanti.enjeksiyonSonrasi();
            }
          }
          return __call.apply(this, [thisArg, ...args]);
        }
      });
    },
 
    enjeksiyonSonrasi() {
      const enjekteButon = document.getElementById('ch-enjekte');
      if (enjekteButon) {
        enjekteButon.style.pointerEvents = 'none';
        enjekteButon.style.opacity = '0.8';
        enjekteButon.innerHTML = '<i class="fa-solid fa-circle-check" style="color:#A78BFA;"></i>';
      }
    }
  };
 
  // Oyun verileri - Said'in optimizasyonları
  const oyun = {
    _tutulanÖnbellek: null,
 
    oyundaMi() {
      return !!(baglanti.noa?.bloxd?.client?.msgHandler);
    },
 
    durum(id, bilesen) {
      return yardim.dene(() => baglanti.noa.entities.getState(id, bilesen));
    },
 
    konum(id = 1) {
      return this.durum(id, 'position')?.position ?? null;
    },
 
    hayattaMi(id = 1) {
      return this.durum(id, 'genericLifeformState')?.isAlive ?? true;
    },
 
    oyuncuIdleri() {
      return yardim.dene(() => values(baglanti.noa?.bloxd?.getPlayerIds?.() ?? {}), []);
    },
	
    hayattaOlanOyuncular() {
      return this.oyuncuIdleri().filter(id => id !== 1 && this.hayattaMi(id));
    },
 
    tutulanEsya(id = 1) {
      if (!baglanti.noa) return null;
      if (!this._tutulanÖnbellek) {
        const comp = Object.values(baglanti.noa.entities.components).find(c => Object.values(c).some(v => v && typeof v == "object" && "fistItem" in v));
        if (!comp) return null;
        this._tutulanÖnbellek = id => baglanti.noa.entities.getState(id, comp.name);
      }
      return yardim.dene(() => this._tutulanÖnbellek(id));
    },
 
    saldir(id, { geriTepme = 0.6, cekme = false, cekmeGucu = 1, salla = true } = {}) {
      yardim.dene(() => {
        const yumrukEsya = this.tutulanEsya()?.fistItem;
        if (!yumrukEsya) return;
 
        const proto = Object.getPrototypeOf(yumrukEsya);
        const saldiriFn = Object.getOwnPropertyNames(proto)
          .map(k => yumrukEsya[k])
          .find(f => typeof f === 'function' && f.length === 3 && f.toString().includes('canAttack'));
        if (typeof saldiriFn !== 'function') return;
 
        const hedefKonum = this.konum(id);
        const kendiKonum = this.konum();
        if (!hedefKonum || !kendiKonum) return;
 
        const dx = hedefKonum[0] - kendiKonum[0];
        const dy = hedefKonum[1] - kendiKonum[1] + 1;
        const dz = hedefKonum[2] - kendiKonum[2];
        const mesafe = hypot(dx, dy, dz) || 1;
        const kuvvet = geriTepme * cekmeGucu * (cekme ? -1 : 1);
 
        const yon = [dx / mesafe * kuvvet, dy / mesafe * kuvvet, dz / mesafe * kuvvet];
        saldiriFn.call(yumrukEsya, yon, String(id), 'BodyMesh');
        if (salla) this.salla();
      });
    },
 
    salla(zamanDamgasi = Date.now(), istemciSalla = true, sunucuSalla = true) {
      yardim.dene(() => {
        const tutulan = this.tutulanEsya();
        if (!tutulan) return;
        const esya = tutulan?._standardItem;
        if (istemciSalla && typeof esya?.trySwingBlock === 'function') esya.trySwingBlock(zamanDamgasi);
        if (sunucuSalla) this.durum(1, 'moveState')?.setArmsAreSwinging?.(true);
      });
    },
 
    girdiGonder(eylem, basili) {
      yardim.dene(() => {
        const inp = baglanti.noa?.inputs;
        if (!inp) return;
        const kova = basili ? inp.down : inp.up;
        if (typeof kova.emit === 'function') {
          kova.emit(eylem, {
            timeStamp: performance.now(),
            preventDefault: () => {},
            stopPropagation: () => {}
          });
        }
      });
    },
	
    girdiGonderTikla(eylem) {
      this.girdiGonder(eylem, true);
      setTimeout(() => this.girdiGonder(eylem, false), 20);
    },
 
    isinAyarla(etkin) {
      yardim.dene(() => {
        if (!baglanti.noa) return;
        const renderer = values(baglanti.noa)[12];
        const inceMeshlar = values(renderer ?? {}).find(v => v?.thinMeshes)?.thinMeshes;
        if (!Array.isArray(inceMeshlar)) return;
        for (const giris of inceMeshlar) {
          const mesh = giris?.meshVariations?.__DEFAULT__?.mesh;
          if (mesh && typeof mesh.renderingGroupId === 'number') mesh.renderingGroupId = etkin ? 2 : 0;
        }
      });
    },
  };
 
  // Modül sistemi - Said'in yapısı
  class Modul {
    constructor(isim, kategori, tanim = {}) {
      this.isim = isim;
      this.kategori = kategori;
      this.ayarlar = tanim.ayarlar ?? {};
      this.kisayol = tanim.kisayol ?? null;
      this.govdeVar = tanim.govdeVar ?? (keys(this.ayarlar).length > 0);
      this.etkin = false;
      this.zamanlayici = null;
 
      this._acilista = tanim.acilista ?? null;
      this._kapanista = tanim.kapanista ?? null;
      this._renderda = tanim.renderda ?? null;
 
      for (const [anahtar, schema] of entries(this.ayarlar)) this[anahtar] = schema.varsayilan;
 
      istemci.moduller[isim] = this;
    }
 
    acKapa(zorla) {
      const sonraki = zorla ?? !this.etkin;
      if (sonraki === this.etkin) return this.etkin;
      this.etkin = sonraki;
      if (sonraki) this._acilista?.call(this);
      else this._kapanista?.call(this);
      return this.etkin;
    }
 
    render(zaman, dt) {
      if (this.etkin) this._renderda?.call(this, zaman, dt);
    }
 
    id() { return slug(this.isim); }
  }
 
  const slug = isim => isim.toLowerCase().replace(/[^a-z0-9]+/g, '-');
 
  // İstemci merkezi - Said'in yönetim sistemi
  const istemci = {
    moduller: {},
    kisayollar: { menu: 'ShiftRight' }
  };
 
  // Depolama - Said'in kaydetme sistemi
  const Depolama = {
    ANAHTAR: 'clickHelper-cfg-said',
 
    yukle() {
      const kaydedilmis = yardim.dene(() => JSON.parse(localStorage.getItem(this.ANAHTAR)), null) ?? {};
      if (kaydedilmis.kisayollar) assign(istemci.kisayollar, kaydedilmis.kisayollar);
      const modDurumu = kaydedilmis.moduller ?? {};
      for (const mod of values(istemci.moduller)) {
        const s = modDurumu[mod.isim];
        if (!s) continue;
        if (typeof s.etkin === 'boolean') mod.etkin = s.etkin;
        if (s.ayarlar) for (const [k, v] of entries(s.ayarlar)) if (k in mod.ayarlar) mod[k] = v;
      }
    },
 
    kaydet() {
      const moduller = {};
      for (const mod of values(istemci.moduller)) {
        const ayarlar = {};
        for (const anahtar of keys(mod.ayarlar)) ayarlar[anahtar] = mod[anahtar];
        moduller[mod.isim] = { etkin: mod.etkin, ayarlar };
      }
      localStorage.setItem(this.ANAHTAR, JSON.stringify({ kisayollar: istemci.kisayollar, moduller }));
    },
 
    yavaslatilmis: (() => {
      let t;
      return () => { clearTimeout(t); t = setTimeout(() => Depolama.kaydet(), 300); };
    })()
  };
 
  // Modüller - Said tarafından geliştirildi
  istemci.moduller["Kill Aura"] = new Modul("Kill Aura", "Savaş", {
    ayarlar: {
      "Gecikme": { tip: "kaydirici", min: 0, max: 1000, adim: 5, varsayilan: 50 },
      "Menzil": { tip: "kaydirici", min: 1, max: 20, adim: 0.1, varsayilan: 6.8 },
      "Geri Tepme Gücü": { tip: "kaydirici", min: 0, max: 5, adim: 0.1, varsayilan: 0.6 },
      "Çekme Modu": { tip: "mantiksal", varsayilan: false },
      "Çekme Gücü": { tip: "kaydirici", min: 0.1, max: 2, adim: 0.1, varsayilan: 1 },
      "Salla": { tip: "mantiksal", varsayilan: true }
    },
    acilista() { this._son = 0; },
    renderda() {
      const simdi = Date.now();
      if (simdi - this._son < this.Gecikme) return;
      const kendiKonum = oyun.konum();
      if (!kendiKonum) return;
      this._son = simdi;
      const menzilKare = this.Menzil * this.Menzil;
      for (const id of oyun.hayattaOlanOyuncular()) {
        const konum = oyun.konum(id);
        if (konum && matematik.mesafeKare(konum, kendiKonum) <= menzilKare) {
          oyun.saldir(id, {
            geriTepme: this["Geri Tepme Gücü"],
            cekme: this["Çekme Modu"],
            cekmeGucu: this["Çekme Gücü"],
            salla: this["Salla"]
          });
        }
      }
    }
  });
 
  istemci.moduller["Aimbot"] = new Modul("Aimbot", "Savaş", {
    ayarlar: {
      "Menzil": { tip: "kaydirici", min: 5, max: 100, adim: 1, varsayilan: 20 },
      "Yumuşaklık": { tip: "kaydirici", min: 0.01, max: 1, adim: 0.01, varsayilan: 0.8 },
      "Gecikme": { tip: "kaydirici", min: 0, max: 500, adim: 5, varsayilan: 5 },
      "Görüş Alanı": { tip: "kaydirici", min: 1, max: 180, adim: 1, varsayilan: 150 }
    },
    acilista() { this._son = 0; },
    renderda() {
      const simdi = Date.now();
      if (simdi - this._son < this.Gecikme) return;
      const kendiKonum = oyun.konum();
      const kamera = baglanti.noa?.camera;
      if (!kendiKonum || !kamera) return;
 
      const fovRad = this["Görüş Alanı"] * (PI / 180);
      let enIyi = null, enIyiMesafeKare = this.Menzil * this.Menzil;
 
      for (const id of oyun.hayattaOlanOyuncular()) {
        const konum = oyun.konum(id);
        if (!konum) continue;
        const mesafeKare = matematik.mesafeKare(konum, kendiKonum);
        if (mesafeKare >= enIyiMesafeKare) continue;
        const yaw = atan2(konum[0] - kendiKonum[0], konum[2] - kendiKonum[2]);
        if (abs(matematik.aciFarki(yaw, kamera.heading)) <= fovRad / 2) {
          enIyiMesafeKare = mesafeKare;
          enIyi = konum;
        }
      }
      if (!enIyi) return;
 
      const dx = enIyi[0] - kendiKonum[0], dz = enIyi[2] - kendiKonum[2];
      const dy = enIyi[1] - kendiKonum[1];
      const yaw = atan2(dx, dz);
      const pitch = -atan2(dy, hypot(dx, dz));
 
      kamera.heading += matematik.aciFarki(yaw, kamera.heading) * this["Yumuşaklık"];
      kamera.pitch += (matematik.sinirla(pitch, -1.57, 1.57) - kamera.pitch) * this["Yumuşaklık"];
      this._son = simdi;
    }
  });
 
  const tiklayiciOlustur = (isim, eylem) => new Modul(isim, "Savaş", {
    ayarlar: {
      "Min CPS": { tip: "kaydirici", min: 1, max: 200, adim: 1, varsayilan: 17 },
      "Max CPS": { tip: "kaydirici", min: 1, max: 200, adim: 1, varsayilan: 20 }
    },
    acilista() {
      const tikla = () => {
        if (!this.etkin) return;
        oyun.girdiGonderTikla(eylem);
 
        const cpsMax = max(1, this["Max CPS"]);
        const cpsMin = min(cpsMax, this["Min CPS"]);
 
        const gecikme = 1000 / (cpsMin + random() * (cpsMax - cpsMin));
        this.zamanlayici = setTimeout(tikla, max(5, gecikme));
      };
      tikla();
    },
    kapanista() { clearTimeout(this.zamanlayici); }
  });
  tiklayiciOlustur("Sol Tıklayıcı", "primary-fire");
  tiklayiciOlustur("Sağ Tıklayıcı", "alt-fire");
 
  istemci.moduller["BHOP"] = new Modul("BHOP", "Hareket", {
    ayarlar: {
      Şans: { tip: "kaydirici", min: 1, max: 100, adim: 1, varsayilan: 100 }
    },
  
    renderda() {
      const durum = baglanti.noa?.inputs?.state;
      const hareket = oyun.durum(1, "movement");
  
      if (!durum || !hareket) return;
  
      const hareketEdiyor = durum.forward || durum.backward || durum.left || durum.right;
      const yerdeMi = yardim.dene(() => hareket.isOnGround());
  
      oyun.girdiGonder(
        "jump",
        !!(yerdeMi && hareketEdiyor && Math.random() * 100 <= this.Şans)
      );
    }
  });
 
  istemci.moduller["Işın"] = new Modul("Işın", "Görseller", {
    acilista() { oyun.isinAyarla(true); },
    kapanista() { oyun.isinAyarla(false); }
  });
 
  istemci.moduller["Görünüm Modeli"] = new Modul("Görünüm Modeli", "Görseller", {
    ayarlar: {
      "Poz X": { tip: "kaydirici", min: -3, max: 3, adim: 0.05, varsayilan: 0, grup: "Konum" },
      "Poz Y": { tip: "kaydirici", min: -3, max: 3, adim: 0.05, varsayilan: 0, grup: "Konum" },
      "Poz Z": { tip: "kaydirici", min: -3, max: 3, adim: 0.05, varsayilan: 0, grup: "Konum" },
      "Dönüş X": { tip: "kaydirici", min: -3.14, max: 3.14, adim: 0.01, varsayilan: 0, grup: "Dönüş" },
      "Dönüş Y": { tip: "kaydirici", min: -3.14, max: 3.14, adim: 0.01, varsayilan: 0, grup: "Dönüş" },
      "Dönüş Z": { tip: "kaydirici", min: -3.14, max: 3.14, adim: 0.01, varsayilan: 0, grup: "Dönüş" },
      "Aleti Döndür": { tip: "mantiksal", grup: "Döndürme" },
      "Döndür X": { tip: "kaydirici", min: -10, max: 10, adim: 0.1, varsayilan: 0, grup: "Döndürme" },
      "Döndür Y": { tip: "kaydirici", min: -10, max: 10, adim: 0.1, varsayilan: 2, grup: "Döndürme" },
      "Döndür Z": { tip: "kaydirici", min: -10, max: 10, adim: 0.1, varsayilan: 0, grup: "Döndürme" }
    },
    acilista() {
      this._sonZaman = 0;
      this._aci = { x: 0, y: 0, z: 0 };
    },
    renderda(zaman) {
      const esya = oyun.tutulanEsya()?._standardItem;
      if (!esya) return;
      const dt = this._sonZaman ? (zaman - this._sonZaman) / 1000 : 0;
      this._sonZaman = zaman;
 
      const aletMi = esya?.typeObj?.constructor?.name === "Tool";
      if (aletMi && this["Aleti Döndür"]) {
        this._aci.x += this["Döndür X"] * dt;
        this._aci.y += this["Döndür Y"] * dt;
        this._aci.z += this["Döndür Z"] * dt;
      }
 
      if (esya.firstPersonPosOffset) {
        esya.firstPersonPosOffset.x = this["Poz X"];
        esya.firstPersonPosOffset.y = this["Poz Y"];
        esya.firstPersonPosOffset.z = this["Poz Z"];
      }
      if (esya.firstPersonRotation && aletMi) {
        esya.firstPersonRotation.x = this["Dönüş X"] + this._aci.x;
        esya.firstPersonRotation.y = this["Dönüş Y"] + this._aci.y;
        esya.firstPersonRotation.z = this["Dönüş Z"] + this._aci.z;
      }
    }
  });
 
  // Hesap modülü - Said'in geliştirmesi
  const HesapModulu = {
    temizleVeYenidenYukle() {
      document.cookie.split(';').forEach(c => {
        const n = c.split('=')[0].trim();
        [`path=/`, `path=/;domain=${location.hostname}`, `path=/;domain=.${location.hostname}`]
          .forEach(p => document.cookie = `${n}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;${p}`);
      });
      if (window.indexedDB?.databases) {
        window.indexedDB.databases().then(dbs => dbs.forEach(db => db.name && indexedDB.deleteDatabase(db.name))).catch(() => {});
      }
      localStorage.clear();
      sessionStorage.clear();
      location.reload();
    }
  };
 
  Depolama.yukle();
 
  // UI Yardımcıları - Said'in mor tasarımı
  const UIYardim = {
    kisayolGoster(kod) {
      if (!kod) return '—';
      const harita = {
        Key: '', Digit: '', ShiftRight: 'RS', ShiftLeft: 'LS', ControlLeft: 'LC', ControlRight: 'RC',
        AltLeft: 'LA', AltRight: 'RA', Backquote: '`', Backslash: '\\', BracketLeft: '[', BracketRight: ']',
        Semicolon: ';', Quote: "'", Comma: ',', Period: '.', Slash: '/', Minus: '-', Equal: '=',
        Space: 'SPC', Tab: 'TAB', CapsLock: 'CAPS', Enter: 'ENT', Escape: 'ESC', Arrow: ''
      };
      let cikti = kod;
      for (const [k, v] of entries(harita)) cikti = cikti.replace(k, v);
      return cikti;
    },
 
    guvenliEkle(el) {
      if (document.body) return document.body.appendChild(el);
      const observer = new MutationObserver(() => {
        if (document.body) { observer.disconnect(); document.body.appendChild(el); }
      });
      observer.observe(document.documentElement, { childList: true });
    },
 
    stilOlustur() {
      const css = document.createElement('style');
      css.textContent = `
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500;600;700;800;900&display=swap');
        @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css');
        #ch-root, #ch-root * { box-sizing: border-box; }
        :root {
          --ch-bg: rgba(20, 10, 40, 0.96);
          --ch-panel: rgba(40, 20, 60, 0.88);
          --ch-panel-hover: rgba(50, 30, 70, 0.92);
          --ch-panel-border: rgba(139, 92, 246, 0.25);
          --ch-accent-1: #8B5CF6;
          --ch-accent-2: #A78BFA;
          --ch-accent-3: #7C3AED;
          --ch-text: #E9D5FF;
          --ch-text-dim: #A78BFA;
          --ch-on: #A78BFA;
          --ch-off: rgba(60, 40, 80, 0.7);
          --ch-danger: #ff4d6d;
          --ch-success: #4ce6a8;
        }
        #ch-root { position: fixed; top: 20px; left: 20px; width: 300px; background: var(--ch-bg); border: 2px solid var(--ch-accent-1); border-radius: 12px; font-family: 'Montserrat', sans-serif; font-size: 11px; color: var(--ch-text); z-index: 99999; box-shadow: 0 16px 40px rgba(139, 92, 246, 0.3), 0 0 30px rgba(139, 92, 246, 0.15); user-select: none; transition: opacity 0.3s ease, transform 0.3s ease; backdrop-filter: blur(16px) saturate(1.2); transform-origin: center center; }
        #ch-root.hidden { opacity: 0; pointer-events: none; transform: scale(0.92); }
