  class SaidUtils {
    static dene(fn, varsayilan = null) {
      try { return fn(); } catch { return varsayilan; }
    }
 
    static _cache = Object.create(null);
 
    static önbellek(key, deger) {
      if (deger === undefined) return this._cache[key];
      return (this._cache[key] = deger);
    }
 
    static önbellekTemizle() {
      this._cache = Object.create(null);
    }
 
    static rastgeleAralik(min, max) {
      return min + random() * (max - min);
    }
 
    static rastgeleTamAralik(min, max) {
      return floor(this.rastgeleAralik(min, max + 1));
    }
 
    static gecikme(ms) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }
 
    static saniyeZaman() {
      return Date.now() / 1000;
    }
 
    static performansZaman() {
      return performance.now();
    }
 
    static benzersizId() {
      return Date.now().toString(36) + Math.random().toString(36).substr(2, 5);
    }
 
    static stringHash(str) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) {
        const char = str.charCodeAt(i);
        hash = ((hash << 5) - hash) + char;
        hash = hash & hash;
      }
      return hash.toString(36);
    }
 
    static boyutKontrol(obj) {
      return obj ? Object.keys(obj).length : 0;
    }
 
    static derinKopya(obj) {
      return JSON.parse(JSON.stringify(obj));
    }
 
    static birlesimDerin(target, source) {
      for (const [key, val] of entries(source)) {
        if (val && typeof val === 'object' && !Array.isArray(val)) {
          target[key] = target[key] || {};
          this.birlesimDerin(target[key], val);
        } else {
          target[key] = val;
        }
      }
      return target;
    }
 
    static sayiSinirla(val, min, max) {
      return Math.min(Math.max(val, min), max);
    }
 
    static sayiYuvarla(val, basamak = 2) {
      const faktor = Math.pow(10, basamak);
      return Math.round(val * faktor) / faktor;
    }
 
    static metinKes(str, uzunluk = 50) {
      return str.length > uzunluk ? str.substring(0, uzunluk) + '...' : str;
    }
 
    static metinIlkBuyuk(str) {
      return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
    }
 
    static diziKarisik(dizi) {
      for (let i = dizi.length - 1; i > 0; i--) {
        const j = floor(random() * (i + 1));
        [dizi[i], dizi[j]] = [dizi[j], dizi[i]];
      }
      return dizi;
    }
 
    static diziTekrarsiz(dizi) {
      return [...new Set(dizi)];
    }
 
    static diziOrtalama(dizi) {
      return dizi.reduce((a, b) => a + b, 0) / dizi.length;
    }
 
    static diziMax(dizi) {
