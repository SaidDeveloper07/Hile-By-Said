      const kendiKonum = SaidGame.konum();
      const kamera = SaidGameConnectorInstance._noa?.camera;
      if (!kendiKonum || !kamera) return;
 
      const fovRad = this["Görüş Alanı"] * (PI / 180);
      let enIyi = null;
      let enIyiMesafeKare = this.Menzil * this.Menzil;
      let enIyiId = null;
 
      const hedefler = this["Sadece Oyuncular"] ? SaidGame.hayattaOlanOyuncular() : SaidGame.tumOyuncular();
      
      for (const id of hedefler) {
        const konum = SaidGame.konum(id);
        if (!konum) continue;
        const mesafeKare = SaidMath.mesafeKare3D(konum, kendiKonum);
        if (mesafeKare >= enIyiMesafeKare || mesafeKare < 1) continue;
        
        const dx = konum[0] - kendiKonum[0];
        const dz = konum[2] - kendiKonum[2];
        const aci = Math.atan2(dx, dz);
        const fark = Math.abs(SaidMath.aciFarki(aci, kamera.heading));
        
