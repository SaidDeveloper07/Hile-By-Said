    function toggleAutoCollect() {
        if (!window.bloxdToggles.autoCollect) {
            window.bloxdToggles.autoCollect = setInterval(() => {
                try {
                    const items = document.querySelectorAll('[class*="item"], [class*="Item"], [class*="drop"]');
                    const player = getPlayer();
                    if (!player) return;
                    const pos = player.position || { x: 0, y: 0, z: 0 };
                    items.forEach(item => {
                        const itemPos = item.position || { x: 0, y: 0, z: 0 };
                        const dist = Math.sqrt(
                            Math.pow(pos.x - itemPos.x, 2) +
                            Math.pow(pos.y - itemPos.y, 2) +
                            Math.pow(pos.z - itemPos.z, 2)
                        );
                        if (dist < 5) {
                            if (item.collect) item.collect();
                            if (item.pickup) item.pickup();
                            item.remove();
                        }
                    });
                } catch (e) {}
            }, 50);
            return true;
        } else {
            clearInterval(window.bloxdToggles.autoCollect);
            window.bloxdToggles.autoCollect = false;
            return false;
