  class SaidUIBuilder {
    static acKapaOlustur(mod) {
      const kisayolAnahtar = mod.isim;
      const kod = SaidClientInstance.kisayollar[kisayolAnahtar];
      const varMi = !!kod;
      return `
        <div class="mod-row" id="satir-${mod.id()}" data-mod="${mod.isim}">
          <div class="mod-left">
            <div class="tg${mod.etkin ? ' on' : ''}" id="tg-${mod.id()}"></div>
            <span class="mod-name">${mod.isim}</span>
          </div>
          <div class="mod-right">
            <div class="kb" id="bagla-${mod.id()}" data-eylem="${kisayolAnahtar}">
              <i class="fa-solid fa-keyboard" style="font-size:8px;opacity:0.6;"></i>
              <span class="kb-text">${varMi ? SaidUI.kisayolGoster(kod) : '—'}</span>
              <span class="kb-x" data-ayir="${kisayolAnahtar}" style="${varMi ? '' : 'display:none'}">✕</span>
            </div>
          </div>
        </div>`;
    }
 
    static mantiksalOlustur(mod, anahtar, schema) {
      const deger = mod[anahtar];
      return `
        <div class="mod-row" style="margin-top: 7px; padding: 0;" data-mantiksal="${mod.isim}::${anahtar}">
          <span class="sl-label" style="width: auto; flex: 1;">${anahtar}</span>
          <div class="tg${deger ? ' on' : ''}" id="bool-${mod.id()}-${slug(anahtar)}"></div>
        </div>`;
    }
 
    static kaydiriciOlustur(mod, anahtar, schema) {
      const deger = mod[anahtar];
      const tip = schema.tip || "kaydirici";
      
      if (tip === "secenek") {
        const secenekler = schema.secenekler || [];
        const secim = deger || secenekler[0] || "";
        return `
          <div class="sl-row" data-kaydirici="${mod.isim}::${anahtar}" style="flex-wrap: wrap; gap: 6px;">
            <span class="sl-label" style="width: auto; min-width: 44px;">${anahtar}</span>
            <select class="sl-val-inp" style="flex: 1; min-width: 80px; height: 24px; font-size: 10px !important;" data-secim="${mod.isim}::${anahtar}">
              ${secenekler.map(s => `<option value="${s}" ${s === secim ? 'selected' : ''}>${s}</option>`).join('')}
            </select>
          </div>`;
      }
      
      if (tip === "metin") {
        return `
          <div class="sl-row" data-kaydirici="${mod.isim}::${anahtar}" style="flex-wrap: wrap; gap: 6px;">
            <span class="sl-label" style="width: auto; min-width: 44px;">${anahtar}</span>
            <input type="text" class="sl-val-inp" style="flex: 1; min-width: 80px; height: 24px; font-size: 10px !important; text-align: left; padding: 0 8px !important;" value="${deger || ''}" data-metin="${mod.isim}::${anahtar}">
          </div>`;
      }
      
      return `<div class="sl-row" data-kaydirici="${mod.isim}::${anahtar}">
        <span class="sl-label">${anahtar}</span>
        <input type="range" id="sl-${mod.id()}-${slug(anahtar)}" min="${schema.min}" max="${schema.max}" step="${schema.adim}" value="${deger}">
        <input type="text" class="sl-val-inp" id="sl-${mod.id()}-${slug(anahtar)}-v" value="${deger}">
      </div>`;
    }
 
    static ayarGovdesiOlustur(mod) {
      let html = '';
      let sonGrup = null;
      for (const [anahtar, schema] of entries(mod.ayarlar)) {
        if (schema.grup && schema.grup !== sonGrup) {
          html += sonGrup ? `<div class="ch-divider"></div>` : '';
          html += `<div class="ch-group-lbl">${schema.grup}</div>`;
        } else if (!schema.grup && sonGrup) {
          html += `<div class="ch-divider"></div>`;
        }
        sonGrup = schema.grup ?? null;
        
        if (schema.tip === "mantiksal") {
          html += this.mantiksalOlustur(mod, anahtar, schema);
        } else {
          html += this.kaydiriciOlustur(mod, anahtar, schema);
        }
      }
      return html;
    }
 
    static modulBolumuOlustur(mod, genisletilmis = false) {
      const govde = mod.govdeVar ? this.ayarGovdesiOlustur(mod) : '';
      const govdeVarMi = !!govde;
      return `
        <div class="ch-sec${genisletilmis && govdeVarMi ? ' expanded' : ''}" id="sec-${mod.id()}" style="--ch-delay: ${Object.values(SaidClientInstance.moduller).indexOf(mod)}">
          <div class="ch-sec-hdr" ${govdeVarMi ? `data-sec-toggle="${mod.id()}"` : 'style="cursor:default;"'}>
            <span class="ch-lbl">${mod.isim}</span>
            ${govdeVarMi ? `<div class="ch-sec-arrow"><i class="fa-solid fa-chevron-down"></i></div>` : ''}
          </div>
          <div class="ch-sec-toprow">${this.acKapaOlustur(mod)}</div>
          ${govdeVarMi ? `<div class="ch-sec-body"><div>${govde}</div></div>` : ''}
        </div>`;
    }
 
    static kategorilereAyir() {
      const sira = [];
      const kategoriyeGore = {};
      for (const mod of SaidClientInstance.tumModuller()) {
        if (!kategoriyeGore[mod.kategori]) {
          kategoriyeGore[mod.kategori] = [];
          sira.push(mod.kategori);
        }
        kategoriyeGore[mod.kategori].push(mod);
      }
      return { sira, kategoriyeGore };
    }
 
    static kategoriIkon(kat) {
      const ikonlar = {
        'Savaş': 'fa-crosshairs',
        'Hareket': 'fa-person-running',
        'Görseller': 'fa-eye',
        'Yardımcı': 'fa-toolbox',
        'İnşaat': 'fa-hammer',
        'Koruma': 'fa-shield-halved'
      };
      return ikonlar[kat] || 'fa-cube';
    }
 
    static olustur() {
      const mevcut = document.getElementById('ch-root');
      if (mevcut) return mevcut;
 
      document.head.appendChild(SaidUI.stilOlustur());
 
      const { sira, kategoriyeGore } = this.kategorilereAyir();
 
      const sekmelerHtml = sira.map((kat, i) => `
        <button class="ch-tab${i === 0 ? ' active' : ''}" data-sekme="${slug(kat)}">
          <i class="fa-solid ${this.kategoriIkon(kat)}"></i>${kat}
        </button>`).join('');
 
      const panellerHtml = sira.map((kat, i) => `
        <div class="ch-tab-panel${i === 0 ? ' active' : ''}" data-panel="${slug(kat)}">
          ${kategoriyeGore[kat].map(mod => this.modulBolumuOlustur(mod)).join('')}
        </div>`).join('');
 
      const kok = document.createElement('div');
      kok.id = 'ch-root';
      kok.innerHTML = `
        <div id="ch-hdr">
          <span id="ch-title">
            CLICK HELPER 
            <span class="said-badge">SAİD</span>
            <span class="version-badge">v3.0</span>
          </span>
          <div style="display:flex;gap:4px;">
            <button class="ch-hbtn" id="ch-yardim" title="Yardım"><i class="fa-solid fa-question"></i></button>
