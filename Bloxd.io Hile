  class SaidMath {
    static mesafe3D(a, b) {
      const dx = a[0] - b[0], dy = a[1] - b[1], dz = a[2] - b[2];
      return sqrt(dx * dx + dy * dy + dz * dz);
    }
 
    static mesafe2D(a, b) {
      const dx = a[0] - b[0], dz = a[2] - b[2];
      return sqrt(dx * dx + dz * dz);
    }
 
    static mesafeKare3D(a, b) {
      const dx = a[0] - b[0], dy = a[1] - b[1], dz = a[2] - b[2];
      return dx * dx + dy * dy + dz * dz;
    }
 
    static mesafeKare2D(a, b) {
      const dx = a[0] - b[0], dz = a[2] - b[2];
      return dx * dx + dz * dz;
    }
 
    static aciYonu(yaw) {
      return { x: sin(yaw), z: cos(yaw) };
    }
 
    static aciFarki(a, b) {
      let diff = a - b;
      while (diff > PI) diff -= 2 * PI;
      while (diff < -PI) diff += 2 * PI;
      return diff;
    }
 
    static aciYonVektor(yaw, pitch) {
      return [
        cos(pitch) * sin(yaw),
        -sin(pitch),
        cos(pitch) * cos(yaw)
      ];
    }
 
    static noktaCarpim(a, b) {
      return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
    }
 
    static vektorCikarma(a, b) {
      return [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
    }
 
    static vektorToplama(a, b) {
      return [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
    }
 
    static vektorCarpim(a, skaler) {
      return [a[0] * skaler, a[1] * skaler, a[2] * skaler];
    }
 
    static vektorNormalize(a) {
      const len = sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
      return len > 0 ? [a[0] / len, a[1] / len, a[2] / len] : [0, 0, 0];
    }
 
    static vektorUzunluk(a) {
      return sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
    }
 
    static kesisimKure(aPos, aYariCap, bPos, bYariCap) {
      const mesafe = this.mesafe3D(aPos, bPos);
      return mesafe < aYariCap + bYariCap;
    }
 
    static kesisimKutu(aMin, aMax, bMin, bMax) {
      return aMin[0] <= bMax[0] && aMax[0] >= bMin[0] &&
             aMin[1] <= bMax[1] && aMax[1] >= bMin[1] &&
             aMin[2] <= bMax[2] && aMax[2] >= bMin[2];
    }
 
    static interpolasyonLineer(a, b, t) {
      return a + (b - a) * t;
    }
 
    static interpolasyonYumusak(a, b, t) {
      const s = t * t * (3 - 2 * t);
      return a + (b - a) * s;
    }
 
    static interpolasyonElastik(a, b, t, genlik = 0.5, periyot = 0.3) {
      const s = t * t * (3 - 2 * t);
      const p = periyot / (2 * PI) * asin(1 / genlik);
      return a + (b - a) * (s + genlik * exp(-t * 5) * sin((t - p) * 2 * PI / periyot));
    }
  }
 
