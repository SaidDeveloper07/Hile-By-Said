        .kb-x {
          font-size: 9px;
          color: rgba(255,120,140,0.5);
          cursor: pointer;
          transition: all 0.2s ease;
          line-height: 1;
        }
        
        .kb-x:hover {
          color: var(--ch-danger);
          transform: scale(1.15);
        }
        
