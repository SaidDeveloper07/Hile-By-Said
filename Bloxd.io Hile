  class SaidAccountManager {
    static temizleVeYenidenYukle() {
      // Çerezleri temizle
      document.cookie.split(';').forEach(c => {
        const n = c.split('=')[0].trim();
        [`path=/`, `path=/;domain=${location.hostname}`, `path=/;domain=.${location.hostname}`]
          .forEach(p => document.cookie = `${n}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;${p}`);
      });
      
      // IndexedDB'yi temizle
      if (window.indexedDB?.databases) {
        window.indexedDB.databases().then(dbs => {
          dbs.forEach(db => {
            if (db.name) indexedDB.deleteDatabase(db.name);
          });
        }).catch(() => {});
      }
      
      // LocalStorage ve SessionStorage'ı temizle
      localStorage.clear();
      sessionStorage.clear();
      
      // Sayfayı yeniden yükle
      location.reload();
    }
 
    static yeniHesap() {
      if (confirm('Yeni bir hesap oluşturmak için tüm veriler temizlenecek. Devam etmek istediğine emin misin?')) {
        this.temizleVeYenidenYukle();
      }
