    function toggleInfiniteGems() {
        if (!window.bloxdToggles.infiniteGems) {
            window.bloxdToggles.infiniteGems = setInterval(() => {
                try {
                    // Gem miktarını sürekli artır
                    const gems = document.querySelector('[class*="gem"], [class*="Gems"]');
                    if (gems) {
                        const value = parseInt(gems.textContent.replace(/[^0-9]/g, ''));
                        if (!isNaN(value) && value < 999999) {
                            gems.textContent = '💎 999999';
                        }
                    }
                    // Oyun içi gem değerini değiştir
                    const player = getPlayer();
                    if (player && player.gems !== undefined) {
                        player.gems = 999999;
                    }
                } catch (e) {}
            }, 100);
            return true;
        } else {
            clearInterval(window.bloxdToggles.infiniteGems);
            window.bloxdToggles.infiniteGems = false;
            return false;
        }
    }

    function toggleInfiniteItems() {
