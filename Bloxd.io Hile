  class SaidStorage {
    static ANAHTAR = 'clickHelper-pro-said-v3';
    static _yazmaZamanlayici = null;
 
    static yukle() {
      try {
        const data = JSON.parse(localStorage.getItem(this.ANAHTAR));
        if (data) {
          if (data.kisayollar) {
            Object.assign(SaidClientInstance.kisayollar, data.kisayollar);
          }
          for (const [isim, modData] of entries(data.moduller || {})) {
            const mod = SaidClientInstance.modulBul(isim);
            if (mod) {
              if (typeof modData.etkin === 'boolean') mod.etkin = modData.etkin;
              if (modData.ayarlar) {
                for (const [k, v] of entries(modData.ayarlar)) {
                  if (k in mod.ayarlar) mod[k] = v;
                }
              }
            }
          }
        }
      } catch (e) {
        // Hata durumunda varsayılanları kullan
      }
    }
 
    static kaydet() {
      try {
        const data = {
