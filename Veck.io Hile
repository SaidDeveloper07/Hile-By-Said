    // ============================================
    // MENÜ KAPATMA
    // ============================================
    
    document.getElementById('kapat-btn').addEventListener('click', function() {
        document.getElementById('said-veck-menu').style.display = 'none';
    });

    // ============================================
    // KLAVYE KISAYOLLARI
    // ============================================
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'F12' || (e.key === 'E' && !e.ctrlKey && !e.altKey)) {
            const target = e.target;
            if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) return;
            const menu = document.getElementById('said-veck-menu');
            menu.style.display = menu.style.display === 'none' ? '' : 'none';
        }
    });

    // ============================================
    // HİLE DURUMLARI
    // ============================================
    
    let espAktif = false;
    let aimbotAktif = false;
    let flyAktif = false;
    let bulletTrackAktif = false;
    let magicBulletAktif = false;
    
    let espInterval = null;
    let aimbotInterval = null;
    let flyInterval = null;
    let bulletInterval = null;
    let magicInterval = null;
    
    let hedefOyuncu = null;
    let espCizimleri = [];
    let bulletIzleri = [];
    let hedefPozisyonu = null;

    // ============================================
    // OYUNCU BULMA FONKSİYONU
    // ============================================
    
    function oyuncuBul() {
        try {
            if (window.game && window.game.players) return window.game.players;
            if (window.players) return window.players;
            if (window.entities) return window.entities;
            
            const keys = Object.keys(window);
            for (const key of keys) {
                const val = window[key];
                if (val && typeof val === 'object') {
                    if (val.length > 0 && val[0] && val[0].x !== undefined && val[0].y !== undefined) {
                        return val;
                    }
                    if (val.x !== undefined && val.y !== undefined && val.name) {
                        return val;
                    }
                }
            }
            return null;
        } catch(e) { return null; }
    }

    // ============================================
    // OYUNCU POZİSYONU BULMA
    // ============================================
    
    function oyuncuPozisyonu(oyuncu) {
        try {
            if (oyuncu.x !== undefined && oyuncu.y !== undefined) return { x: oyuncu.x, y: oyuncu.y };
            if (oyuncu.position) return { x: oyuncu.position.x, y: oyuncu.position.y };
            if (oyuncu.body && oyuncu.body.position) return { x: oyuncu.body.position.x, y: oyuncu.body.position.y };
            if (oyuncu.sprite && oyuncu.sprite.x !== undefined) return { x: oyuncu.sprite.x, y: oyuncu.sprite.y };
            if (oyuncu.x === undefined && oyuncu[0] && oyuncu[0].x !== undefined) {
                return { x: oyuncu[0].x, y: oyuncu[0].y };
            }
            return null;
        } catch(e) { return null; }
    }

    // ============================================
    // BENİM POZİSYONUM
    // ============================================
    
    function benimPozisyonum() {
        try {
            if (window.player && window.player.x !== undefined) return { x: window.player.x, y: window.player.y };
            if (window.game && window.game.player) return { x: window.game.player.x, y: window.game.player.y };
            if (window.me && window.me.x !== undefined) return { x: window.me.x, y: window.me.y };
            return { x: 0, y: 0 };
        } catch(e) { return { x: 0, y: 0 }; }
    }

    // ============================================
    // OYUNCUYU EKRANA ÇEVİRME (World to Screen)
    // ============================================
    
    function worldToScreen(worldX, worldY) {
        try {
            const canvas = document.querySelector('canvas');
            if (!canvas) return { x: worldX, y: worldY };
            
            const rect = canvas.getBoundingClientRect();
            let cameraX = 0, cameraY = 0, zoom = 1;
            
            if (window.camera) {
                cameraX = window.camera.x || 0;
                cameraY = window.camera.y || 0;
                zoom = window.camera.zoom || 1;
            }
            if (window.game && window.game.camera) {
                cameraX = window.game.camera.x || 0;
                cameraY = window.game.camera.y || 0;
                zoom = window.game.camera.zoom || 1;
            }
            if (window.scene && window.scene.cameras) {
                const cam = window.scene.cameras.main || window.scene.cameras.default;
                if (cam) {
                    cameraX = cam.scrollX || 0;
                    cameraY = cam.scrollY || 0;
                    zoom = cam.zoom || 1;
                }
            }
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            return {
                x: (worldX - cameraX) * zoom + centerX + rect.left,
                y: (worldY - cameraY) * zoom + centerY + rect.top
            };
        } catch(e) {
            return { x: worldX, y: worldY };
        }
    }

    // ============================================
    // MESAFE HESAPLA
    // ============================================
    
    function mesafeHesapla(pos1, pos2) {
        if (!pos1 || !pos2) return 0;
        const dx = pos1.x - pos2.x;
        const dy = pos1.y - pos2.y;
        return Math.sqrt(dx*dx + dy*dy);
    }

    // ============================================
    // ESP - OYUNCULARI GÖSTER (Box + İsim + Mesafe)
    // ============================================
    
    function espCalistir() {
        espCizimleri.forEach(el => el.remove());
        espCizimleri = [];

        if (!espAktif) return;

        try {
            const players = oyuncuBul();
            if (!players) return;

            const ben = benimPozisyonum();
            if (!ben) return;

            const oyuncuListesi = Array.isArray(players) ? players : Object.values(players);
            let oyuncuSayisi = 0;

            for (const oyuncu of oyuncuListesi) {
                if (!oyuncu) continue;
                if (oyuncu === window.player || oyuncu === window.game?.player) continue;
                if (oyuncu === window.me) continue;
                if (oyuncu.isPlayer === false) continue;
                if (oyuncu.type && oyuncu.type === 'bullet') continue;
                
                const pos = oyuncuPozisyonu(oyuncu);
                if (!pos) continue;
                
                const distance = mesafeHesapla(ben, pos);
                if (distance > 2000) continue;
                
                const screenPos = worldToScreen(pos.x, pos.y);
                if (!screenPos) continue;
                
                if (screenPos.x < -200 || screenPos.x > window.innerWidth + 200) continue;
                if (screenPos.y < -200 || screenPos.y > window.innerHeight + 200) continue;
                
                oyuncuSayisi++;
                const isim = oyuncu.name || oyuncu.username || oyuncu.displayName || `Oyuncu ${oyuncuSayisi}`;
                
                let hp = 100;
                if (oyuncu.hp !== undefined) hp = oyuncu.hp;
                else if (oyuncu.health !== undefined) hp = oyuncu.health;
                else if (oyuncu.life !== undefined) hp = oyuncu.life;
                else if (oyuncu.HP !== undefined) hp = oyuncu.HP;
                if (typeof hp === 'string') hp = parseInt(hp) || 100;
                
                const maxHp = oyuncu.maxHp || oyuncu.maxHealth || oyuncu.maxLife || 100;
                const hpOrani = Math.max(0, Math.min(1, hp / maxHp));
                
                const boxSize = Math.max(30, 60 - distance / 50);
                
                // ---- BOX (KUTU) - OYUNCUNUN ÜSTÜNDE ----
                const box = document.createElement('div');
                box.className = 'veck-esp-box';
                box.style.left = (screenPos.x - boxSize/2) + 'px';
                box.style.top = (screenPos.y - boxSize) + 'px';
                box.style.width = boxSize + 'px';
                box.style.height = boxSize + 'px';
                box.style.borderColor = hpOrani > 0.5 ? '#00ff88' : hpOrani > 0.25 ? '#ffaa00' : '#ff0044';
                box.style.boxShadow = `0 0 30px ${hpOrani > 0.5 ? 'rgba(0,255,136,0.3)' : 'rgba(255,0,68,0.3)'}`;
                document.body.appendChild(box);
                espCizimleri.push(box);

                // ---- İSİM - OYUNCUNUN ALTINDA ----
                const nameTag = document.createElement('div');
                nameTag.className = 'veck-esp-name';
                nameTag.textContent = isim;
                nameTag.style.left = (screenPos.x - nameTag.textContent.length * 4) + 'px';
                nameTag.style.top = (screenPos.y + boxSize/2 + 8) + 'px';
                nameTag.style.color = hpOrani > 0.5 ? '#00ff88' : '#ffaa00';
                document.body.appendChild(nameTag);
                espCizimleri.push(nameTag);

                // ---- MESAFE (METRE) - OYUNCUNUN ÜSTÜNDE ----
                const distanceText = document.createElement('div');
                distanceText.className = 'veck-esp-distance';
                const metre = (distance / 100).toFixed(1);
                distanceText.textContent = `📍 ${metre}m`;
                distanceText.style.left = (screenPos.x - 20) + 'px';
                distanceText.style.top = (screenPos.y - boxSize - 22) + 'px';
                document.body.appendChild(distanceText);
                espCizimleri.push(distanceText);

                // ---- CAN ÇUBUĞU - OYUNCUNUN ALTINDA ----
                const hpBar = document.createElement('div');
                hpBar.className = 'veck-esp-hp';
                hpBar.style.left = (screenPos.x - boxSize/2) + 'px';
                hpBar.style.top = (screenPos.y + boxSize/2 + 20) + 'px';
                hpBar.style.width = (boxSize * hpOrani) + 'px';
                hpBar.style.backgroundColor = hpOrani > 0.5 ? '#00ff88' : hpOrani > 0.25 ? '#ffaa00' : '#ff0044';
                document.body.appendChild(hpBar);
                espCizimleri.push(hpBar);

                // ---- KAFADA NOKTA ----
                const headDot = document.createElement('div');
                headDot.className = 'veck-esp-head';
                headDot.style.left = (screenPos.x - 4) + 'px';
                headDot.style.top = (screenPos.y - boxSize/2 - 4) + 'px';
                document.body.appendChild(headDot);
                espCizimleri.push(headDot);

                // ---- İSKELET (ÇİZGİLER) ----
                // Vücut çizgisi
                const bodyLine = document.createElement('div');
                bodyLine.className = 'veck-esp-skeleton';
                bodyLine.style.left = screenPos.x + 'px';
                bodyLine.style.top = (screenPos.y - boxSize/2) + 'px';
                bodyLine.style.height = boxSize + 'px';
                bodyLine.style.borderLeftColor = hpOrani > 0.5 ? 'rgba(0,255,136,0.3)' : 'rgba(255,0,68,0.3)';
                document.body.appendChild(bodyLine);
                espCizimleri.push(bodyLine);
            }
        } catch(e) {}
    }

    // ============================================
    // AIMBOT - OTOMATİK NİŞAN ALMA
    // ============================================
    
    function aimbotCalistir() {
        if (!aimbotAktif) return;

        try {
            const players = oyuncuBul();
            if (!players) return;

            const ben = benimPozisyonum();
            if (!ben) return;

            let enYakin = null;
            let enYakinMesafe = Infinity;
            const oyuncuListesi = Array.isArray(players) ? players : Object.values(players);

            for (const oyuncu of oyuncuListesi) {
                if (!oyuncu) continue;
                if (oyuncu === window.player || oyuncu === window.game?.player) continue;
                if (oyuncu === window.me) continue;
                if (oyuncu.isPlayer === false) continue;
                if (oyuncu.type && oyuncu.type === 'bullet') continue;
                
                const pos = oyuncuPozisyonu(oyuncu);
                if (!pos) continue;
                
                const mesafe = mesafeHesapla(ben, pos);
                if (mesafe < enYakinMesafe && mesafe < 1500) {
                    enYakinMesafe = mesafe;
                    enYakin = oyuncu;
                }
            }

            if (enYakin) {
                hedefOyuncu = enYakin;
                const pos = oyuncuPozisyonu(enYakin);
                if (pos) {
                    const screenPos = worldToScreen(pos.x, pos.y);
                    if (screenPos) {
                        const canvas = document.querySelector('canvas');
                        if (canvas) {
                            const rect = canvas.getBoundingClientRect();
                            const targetX = screenPos.x - rect.left;
                            const targetY = screenPos.y - rect.top;
                            
                            const event = new MouseEvent('mousemove', {
                                clientX: screenPos.x,
                                clientY: screenPos.y,
                                movementX: targetX - (rect.width/2),
                                movementY: targetY - (rect.height/2)
                            });
                            document.dispatchEvent(event);
                            
                            const clickEvent = new MouseEvent('click', {
                                clientX: screenPos.x,
                                clientY: screenPos.y
                            });
                            canvas.dispatchEvent(clickEvent);
                        }
                    }
                }
            }
        } catch(e) {}
    }

    // ============================================
    // UÇMA - YERÇEKİMİNİ KALDIR
    // ============================================
    
    function flyCalistir() {
        if (!flyAktif) return;

        try {
            if (window.physics) {
                if (window.physics.gravity) window.physics.gravity.y = 0;
                if (window.physics.world && window.physics.world.gravity) window.physics.world.gravity.y = 0;
            }
            if (window.game && window.game.physics) {
                if (window.game.physics.gravity) window.game.physics.gravity.y = 0;
            }
            if (window.scene && window.scene.physics) {
                if (window.scene.physics.world && window.scene.physics.world.gravity) {
                    window.scene.physics.world.gravity.y = 0;
                }
            }

            document.addEventListener('keydown', function flyHandler(e) {
                if (e.code === 'Space' && flyAktif) {
                    e.preventDefault();
                    e.stopPropagation();
                    const player = window.player || window.game?.player || window.me;
                    if (player) {
                        if (player.vy !== undefined) player.vy = -0.5;
                        if (player.velocity && player.velocity.y !== undefined) player.velocity.y = -0.5;
                        if (player.body) {
                            if (player.body.velocity) player.body.velocity.y = -0.5;
                            if (player.body.setVelocity) player.body.setVelocity(0, -0.5);
                            if (player.body.setGravity) player.body.setGravity(0, 0);
                        }
                    }
                }
            });

        } catch(e) {}
    }

    // ============================================
    // BULLET TRACK - MERMİ TAKİP
    // ============================================
    
    let oncekiMermiler = [];

    function bulletTrackCalistir() {
        if (!bulletTrackAktif) return;

        try {
            const canvas = document.querySelector('canvas');
            if (!canvas) return;

            // Mermileri bul (genellikle bullets, projectiles, shots diye geçer)
            let mermiler = [];
            if (window.bullets) mermiler = Array.isArray(window.bullets) ? window.bullets : Object.values(window.bullets);
            if (window.projectiles) mermiler = Array.isArray(window.projectiles) ? window.projectiles : Object.values(window.projectiles);
            if (window.game && window.game.bullets) mermiler = Array.isArray(window.game.bullets) ? window.game.bullets : Object.values(window.game.bullets);
            if (window.shots) mermiler = Array.isArray(window.shots) ? window.shots : Object.values(window.shots);

            if (!mermiler || mermiler.length === 0) {
                oncekiMermiler = [];
                return;
            }

            const ben = benimPozisyonum();
            if (!ben) return;

            for (const mermi of mermiler) {
                if (!mermi) continue;
                const pos = oyuncuPozisyonu(mermi);
                if (!pos) continue;
                
                // Mermi bana doğru mu geliyor?
                const mesafe = mesafeHesapla(ben, pos);
                if (mesafe > 800) continue;

                // Mermi yönünü bul
                let yon = null;
                if (mermi.velocity) yon = { x: mermi.velocity.x, y: mermi.velocity.y };
                if (mermi.direction) yon = { x: mermi.direction.x, y: mermi.direction.y };
                if (mermi.vx !== undefined && mermi.vy !== undefined) yon = { x: mermi.vx, y: mermi.vy };
                if (!yon) continue;

                // Mermi bana doğru mu?
                const hedefYon = { x: ben.x - pos.x, y: ben.y - pos.y };
                const hedefUzunluk = Math.sqrt(hedefYon.x*hedefYon.x + hedefYon.y*hedefYon.y);
                if (hedefUzunluk < 1) continue;
                
                const yonUzunluk = Math.sqrt(yon.x*yon.x + yon.y*yon.y);
                if (yonUzunluk < 0.1) continue;
                
                // Nokta çarpımı ile yön kontrolü
                const nokta = (yon.x/yonUzunluk * hedefYon.x/hedefUzunluk) + (yon.y/yonUzunluk * hedefYon.y/hedefUzunluk);
                if (nokta < 0.5) continue; // Bana doğru değil

                // Mermi izi çiz
                const screenPos = worldToScreen(pos.x, pos.y);
                if (!screenPos) continue;

                // Mermi izi (çizgi)
                const iz = document.createElement('div');
                iz.className = 'veck-bullet-track';
                const mermiYonu = Math.atan2(yon.y, yon.x) * 180 / Math.PI;
                iz.style.left = screenPos.x + 'px';
                iz.style.top = screenPos.y + 'px';
                iz.style.width = '40px';
                iz.style.transform = `rotate(${mermiYonu}deg)`;
                iz.style.transformOrigin = '0 0';
                iz.style.borderColor = '#ff00ff';
                document.body.appendChild(iz);
                
                setTimeout(() => iz.remove(), 300);
            }

            oncekiMermiler = mermiler;
        } catch(e) {}
    }

    // ============================================
    // MAGIC BULLET - BÜYÜLÜ MERMİ
    // ============================================
    
    function magicBulletCalistir() {
        if (!magicBulletAktif) return;

        try {
            // En yakın hedefi bul
            const players = oyuncuBul();
            if (!players) return;

            const ben = benimPozisyonum();
            if (!ben) return;

            let enYakin = null;
            let enYakinMesafe = Infinity;
            const oyuncuListesi = Array.isArray(players) ? players : Object.values(players);

            for (const oyuncu of oyuncuListesi) {
                if (!oyuncu) continue;
                if (oyuncu === window.player || oyuncu === window.game?.player) continue;
                if (oyuncu === window.me) continue;
                if (oyuncu.isPlayer === false) continue;
                if (oyuncu.type && oyuncu.type === 'bullet') continue;
                
                const pos = oyuncuPozisyonu(oyuncu);
                if (!pos) continue;
                
                const mesafe = mesafeHesapla(ben, pos);
                if (mesafe < enYakinMesafe && mesafe < 1000) {
                    enYakinMesafe = mesafe;
                    enYakin = oyuncu;
                }
            }

            if (!enYakin) return;

            const hedefPos = oyuncuPozisyonu(enYakin);
            if (!hedefPos) return;

            // Magic bullet efekti - hedefe giden ışın
            const canvas = document.querySelector('canvas');
            if (!canvas) return;

            const screenPos = worldToScreen(hedefPos.x, hedefPos.y);
            if (!screenPos) return;

            // Hedefte patlama efekti
            const patlama = document.createElement('div');
            patlama.className = 'veck-magic-bullet';
            patlama.style.left = (screenPos.x - 4) + 'px';
            patlama.style.top = (screenPos.y - 4) + 'px';
            patlama.style.width = '16px';
            patlama.style.height = '16px';
            patlama.style.background = '#ff00ff';
            patlama.style.boxShadow = '0 0 60px #ff00ff, 0 0 120px rgba(255,0,255,0.3)';
            document.body.appendChild(patlama);
            setTimeout(() => patlama.remove(), 500);

            // Hedefe hasar ver (oyun içinde)
            if (enYakin.receiveDamage) {
                enYakin.receiveDamage(100, 1);
            } else if (enYakin.hp !== undefined) {
                enYakin.hp -= 100;
            } else if (enYakin.health !== undefined) {
                enYakin.health -= 100;
            } else if (enYakin.life !== undefined) {
                enYakin.life -= 100;
            }

            // Magic bullet çizgisi (hedefe giden)
            const benScreen = worldToScreen(ben.x, ben.y);
            if (benScreen) {
                const line = document.createElement('div');
                line.style.cssText = `
                    position: fixed;
                    left: ${benScreen.x}px;
                    top: ${benScreen.y}px;
                    width: ${Math.sqrt(Math.pow(screenPos.x - benScreen.x, 2) + Math.pow(screenPos.y - benScreen.y, 2))}px;
                    height: 2px;
                    background: linear-gradient(90deg, #ff00ff, transparent);
                    pointer-events: none;
                    z-index: 9996;
                    transform: rotate(${Math.atan2(screenPos.y - benScreen.y, screenPos.x - benScreen.x)}rad);
                    transform-origin: 0 0;
                    box-shadow: 0 0 30px #ff00ff;
                    opacity: 0.6;
                `;
                document.body.appendChild(line);
                setTimeout(() => line.remove(), 300);
            }

            showNotification(`✨ Magic Bullet isabet! ${enYakin.name || 'Oyuncu'}`, 'success');
        } catch(e) {}
    }

