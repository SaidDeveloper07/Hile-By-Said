                const distance = mesafeHesapla(ben, pos);
                if (distance > 4000) continue;
                
                const screenPos = worldToScreen(pos.x, pos.y);
                if (!screenPos) continue;
                
                if (screenPos.x < -400 || screenPos.x > window.innerWidth + 400) continue;
                if (screenPos.y < -400 || screenPos.y > window.innerHeight + 400) continue;
                
