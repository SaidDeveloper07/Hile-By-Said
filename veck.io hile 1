    function oyuncuPozisyonu(oyuncu) {
        try {
            if (!oyuncu) return null;
            
            if (oyuncu.x !== undefined && oyuncu.y !== undefined) {
                return { x: parseFloat(oyuncu.x), y: parseFloat(oyuncu.y) };
            }
            if (oyuncu.position && oyuncu.position.x !== undefined) {
                return { x: parseFloat(oyuncu.position.x), y: parseFloat(oyuncu.position.y) };
            }
            if (oyuncu.body && oyuncu.body.position) {
                return { x: parseFloat(oyuncu.body.position.x), y: parseFloat(oyuncu.body.position.y) };
            }
            if (oyuncu.sprite && oyuncu.sprite.x !== undefined) {
                return { x: parseFloat(oyuncu.sprite.x), y: parseFloat(oyuncu.sprite.y) };
            }
            if (oyuncu.gameObject && oyuncu.gameObject.x !== undefined) {
                return { x: parseFloat(oyuncu.gameObject.x), y: parseFloat(oyuncu.gameObject.y) };
            }
            if (Array.isArray(oyuncu) && oyuncu.length > 0 && oyuncu[0].x !== undefined) {
                return { x: parseFloat(oyuncu[0].x), y: parseFloat(oyuncu[0].y) };
            }
            if (typeof oyuncu.getPosition === 'function') {
                const pos = oyuncu.getPosition();
                if (pos && pos.x !== undefined) return { x: parseFloat(pos.x), y: parseFloat(pos.y) };
            }
            return null;
        } catch(e) { return null; }
    }

