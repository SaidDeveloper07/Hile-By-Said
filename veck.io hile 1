    function oyuncuBul() {
        try {
            const kaynaklar = [
                window.game?.players,
                window.players,
                window.entities,
                window.playersList,
                window.oyuncular,
                window.game?.entities,
                window.game?.playersList,
                window.scene?.players,
                window.scene?.entities,
                window.game?.scene?.players,
                window.game?.scene?.entities
            ];
            
            for (const kaynak of kaynaklar) {
                if (kaynak) {
                    if (Array.isArray(kaynak) && kaynak.length > 0) {
                        if (kaynak[0]?.x !== undefined || kaynak[0]?.position) return kaynak;
                    }
                    if (typeof kaynak === 'object') {
                        const degerler = Object.values(kaynak);
                        if (degerler.length > 0 && (degerler[0]?.x !== undefined || degerler[0]?.position)) {
                            return kaynak;
                        }
                    }
                }
            }
            
            const keys = Object.keys(window);
            for (const key of keys) {
                if (key.toLowerCase().includes('player') || key.toLowerCase().includes('entity') || key.toLowerCase().includes('user')) {
                    const val = window[key];
                    if (val && typeof val === 'object') {
                        const degerler = Array.isArray(val) ? val : Object.values(val);
                        if (degerler.length > 0 && degerler[0]?.x !== undefined) {
                            return val;
                        }
                    }
                }
            }
            return null;
        } catch(e) { return null; }
    }

    // ============================================
