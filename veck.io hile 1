    // ============================================
    // UÇMA (ULTRA GELİŞTİRİLMİŞ)
    // ============================================
    
    function flyCalistir() {
        if (!flyAktif) return;

        try {
            // Yerçekimini tamamen kaldır
            const gravityKaynaklari = [
                window.physics?.gravity,
                window.physics?.world?.gravity,
                window.game?.physics?.gravity,
                window.game?.physics?.world?.gravity,
                window.scene?.physics?.world?.gravity,
                window.scene?.physics?.gravity,
                window.game?.scene?.physics?.world?.gravity
            ];
            
            for (const g of gravityKaynaklari) {
                if (g) {
                    if (g.y !== undefined) g.y = 0;
                    if (g.x !== undefined) g.x = 0;
                }
            }

            // Oyuncuyu bul ve kontrol et
            const player = window.player || window.game?.player || window.me || window.localPlayer;
            if (player) {
                if (player.body) {
                    if (player.body.setGravity) player.body.setGravity(0, 0);
                    if (player.body.gravity !== undefined) player.body.gravity.y = 0;
                    if (player.body.allowGravity !== undefined) player.body.allowGravity = false;
                    if (player.body.setVelocity && (flyYon.x !== 0 || flyYon.y !== 0)) {
                        player.body.setVelocity(flyYon.x * 2, flyYon.y * 2);
                    }
                }
                if (player.x !== undefined && player.y !== undefined) {
                    player.x += flyYon.x;
                    player.y += flyYon.y;
                }
                if (player.position) {
                    player.position.x += flyYon.x;
                    player.position.y += flyYon.y;
                }
            }

            // Klavye kontrolü
            document.addEventListener('keydown', function flyControl(e) {
                if (!flyAktif) return;
                const key = e.key.toLowerCase();
                if (key === 'w' || key === 'arrowup') flyYon.y = -flyHiz;
                if (key === 's' || key === 'arrowdown') flyYon.y = flyHiz;
                if (key === 'a' || key === 'arrowleft') flyYon.x = -flyHiz;
                if (key === 'd' || key === 'arrowright') flyYon.x = flyHiz;
                if (key === ' ' || key === 'space') {
                    e.preventDefault();
                    const p = window.player || window.game?.player || window.me;
                    if (p) {
                        if (p.vy !== undefined) p.vy = -1.2;
                        if (p.body && p.body.setVelocity) p.body.setVelocity(0, -1.2);
                        if (p.position) p.position.y -= 2;
                        if (p.y !== undefined) p.y -= 2;
                    }
                }
                // Shift ile hızlanma
                if (key === 'shift') {
                    flyHiz = 1.2;
                }
            });
            
            document.addEventListener('keyup', function flyControlUp(e) {
                const key = e.key.toLowerCase();
                if (key === 'w' || key === 's' || key === 'arrowup' || key === 'arrowdown') flyYon.y = 0;
                if (key === 'a' || key === 'd' || key === 'arrowleft' || key === 'arrowright') flyYon.x = 0;
                if (key === 'shift') {
                    flyHiz = 0.4;
                }
            });

        } catch(e) {}
    }

    // ============================================
    // BULLET TRACK (ULTRA GELİŞTİRİLMİŞ)
    // ============================================
    
    function bulletTrackCalistir() {
        if (!bulletTrackAktif) return;

        try {
            const canvas = document.querySelector('canvas');
            if (!canvas) return;

            let mermiler = [];
            const mermiKaynaklari = [
                window.bullets,
                window.projectiles,
                window.game?.bullets,
                window.game?.projectiles,
                window.shots,
                window.game?.shots,
                window.scene?.bullets,
                window.scene?.projectiles,
                window.game?.scene?.bullets
            ];
            
            for (const kaynak of mermiKaynaklari) {
                if (kaynak) {
                    if (Array.isArray(kaynak)) {
                        mermiler = mermiler.concat(kaynak);
                    } else if (typeof kaynak === 'object') {
                        mermiler = mermiler.concat(Object.values(kaynak));
                    }
                }
            }

            if (!mermiler || mermiler.length === 0) {
                oncekiMermiler = [];
                return;
            }

            const ben = benimPozisyonum();
            if (!ben) return;

            for (const mermi of mermiler) {
                if (!mermi) continue;
                if (mermi === window.player || mermi === window.game?.player) continue;
                
                const pos = oyuncuPozisyonu(mermi);
                if (!pos) continue;
                
                const mesafe = mesafeHesapla(ben, pos);
                if (mesafe > 1200) continue;

                // Mermi hızı ve yönü
                let hiz = { x: 0, y: 0 };
                const hizKaynaklari = ['velocity', 'speed', 'direction', 'v', 'vel', 'movement', 'vector'];
                for (const key of hizKaynaklari) {
                    if (mermi[key]) {
                        if (typeof mermi[key] === 'object' && mermi[key].x !== undefined) {
                            hiz = { x: mermi[key].x || 0, y: mermi[key].y || 0 };
                            break;
                        }
                    }
                }
                if (hiz.x === 0 && hiz.y === 0) {
                    if (mermi.vx !== undefined && mermi.vy !== undefined) {
                        hiz = { x: mermi.vx || 0, y: mermi.vy || 0 };
                    }
                }
                
                const hizUzunluk = Math.sqrt(hiz.x*hiz.x + hiz.y*hiz.y);
                if (hizUzunluk < 0.1) continue;

                const hedefYon = { x: ben.x - pos.x, y: ben.y - pos.y };
                const hedefUzunluk = Math.sqrt(hedefYon.x*hedefYon.x + hedefYon.y*hedefYon.y);
                if (hedefUzunluk < 1) continue;
                
                const nokta = (hiz.x/hizUzunluk * hedefYon.x/hedefUzunluk) + (hiz.y/hizUzunluk * hedefYon.y/hedefUzunluk);
                if (nokta < 0.3) continue;

                const screenPos = worldToScreen(pos.x, pos.y);
                if (!screenPos) continue;
                
                if (screenPos.x < -150 || screenPos.x > window.innerWidth + 150) continue;
                if (screenPos.y < -150 || screenPos.y > window.innerHeight + 150) continue;

                // Mermi izi
                const mermiYonu = Math.atan2(hiz.y, hiz.x) * 180 / Math.PI;
                const izUzunluk = Math.min(100, 40 + mesafe / 15);
                const isYakın = mesafe < 350;
                
                const iz = document.createElement('div');
                iz.className = `veck-bullet-track ${isYakın ? 'danger' : ''}`;
                iz.style.left = screenPos.x + 'px';
                iz.style.top = screenPos.y + 'px';
                iz.style.width = izUzunluk + 'px';
                iz.style.transform = `rotate(${mermiYonu}deg)`;
                iz.style.transformOrigin = '0 0';
                if (isYakın) {
                    iz.style.borderColor = '#ff0044';
                    iz.style.boxShadow = '0 0 50px #ff0044, 0 0 100px rgba(255,0,68,0.2)';
                    iz.style.borderWidth = '4px';
                }
                document.body.appendChild(iz);
                bulletUyarilari.push(iz);
                setTimeout(() => iz.remove(), 500);

                // Yakın mermi uyarısı
                if (mesafe < 250) {
                    const uyari = document.createElement('div');
                    uyari.className = 'veck-bullet-warning';
                    uyari.textContent = '⚡ MERMİ GELİYOR!';
                    uyari.style.left = (screenPos.x - 60) + 'px';
                    uyari.style.top = (screenPos.y - 50) + 'px';
                    uyari.style.fontSize = '22px';
                    document.body.appendChild(uyari);
                    setTimeout(() => uyari.remove(), 500);
                }

                // Mermi kaynağına çizgi
                if (mermi.owner || mermi.shooter || mermi.source) {
                    const kaynak = mermi.owner || mermi.shooter || mermi.source;
                    const kaynakPos = oyuncuPozisyonu(kaynak);
                    if (kaynakPos) {
                        const kaynakScreen = worldToScreen(kaynakPos.x, kaynakPos.y);
                        if (kaynakScreen) {
                            const baglanti = document.createElement('div');
                            baglanti.style.cssText = `
                                position: fixed;
                                left: ${kaynakScreen.x}px;
                                top: ${kaynakScreen.y}px;
                                width: ${Math.sqrt(Math.pow(screenPos.x - kaynakScreen.x, 2) + Math.pow(screenPos.y - kaynakScreen.y, 2))}px;
                                height: 2px;
                                background: linear-gradient(90deg, rgba(255,0,255,0.05), rgba(255,0,255,0.25));
                                pointer-events: none;
                                z-index: 9995;
                                transform: rotate(${Math.atan2(screenPos.y - kaynakScreen.y, screenPos.x - kaynakScreen.x)}rad);
                                transform-origin: 0 0;
                                box-shadow: 0 0 20px rgba(255,0,255,0.05);
                            `;
                            document.body.appendChild(baglanti);
                            setTimeout(() => baglanti.remove(), 400);
                        }
                    }
                }
            }

            oncekiMermiler = mermiler;
        } catch(e) {}
    }

