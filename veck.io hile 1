                if (oyuncu.isPlayer === false) continue;
                if (oyuncu.type === 'bullet' || oyuncu.type === 'projectile') continue;
                
                const pos = oyuncuPozisyonu(oyuncu);
                if (!pos) continue;
                
                const mesafe = mesafeHesapla(ben, pos);
                if (mesafe > 1500) continue;
                
                let hp = 100;
                const hpKaynaklari = ['hp', 'health', 'life', 'HP'];
                for (const key of hpKaynaklari) {
                    if (oyuncu[key] !== undefined) {
                        const val = parseFloat(oyuncu[key]);
                        if (!isNaN(val)) { hp = val; break; }
                    }
                }
                
                // Düşük canlı hedefleri önceliklendir
                const oncelik = hp < 30 ? 0.3 : 1;
                const puan = mesafe * oncelik;
                
                if (puan < enYakinMesafe) {
                    enYakinMesafe = puan;
                    enYakin = oyuncu;
                    enDusukHp = hp;
                }
            }

            if (!enYakin) {
                magicHedef = null;
                return;
            }

            magicHedef = enYakin;
            const hedefPos = oyuncuPozisyonu(enYakin);
            if (!hedefPos) return;

            const screenPos = worldToScreen(hedefPos.x, hedefPos.y);
            if (!screenPos) return;

            const hedefIsim = enYakin.name || enYakin.username || 'Oyuncu';

            // PATLAMA EFERİ
            const patlama = document.createElement('div');
            patlama.className = 'veck-magic-bullet';
            patlama.style.left = (screenPos.x - 8) + 'px';
            patlama.style.top = (screenPos.y - 8) + 'px';
            patlama.style.width = '25px';
            patlama.style.height = '25px';
            patlama.style.background = 'radial-gradient(circle, #ff00ff, #8a2be2, #4a0080, #1a0028)';
            patlama.style.boxShadow = '0 0 100px #ff00ff, 0 0 200px rgba(255,0,255,0.3), 0 0 300px rgba(138,43,226,0.1)';
            document.body.appendChild(patlama);
            setTimeout(() => patlama.remove(), 700);

            // HASAR VER
            let hasarVerildi = false;
            const hasarMetotlari = ['receiveDamage', 'takeDamage', 'damage', 'hurt', 'applyDamage', 'dealDamage'];
            for (const metot of hasarMetotlari) {
                if (typeof enYakin[metot] === 'function') {
                    enYakin[metot](150, 1);
                    hasarVerildi = true;
                    break;
                }
            }
            
            if (!hasarVerildi) {
                const hpKaynaklari = ['hp', 'health', 'life', 'HP'];
                for (const key of hpKaynaklari) {
                    if (enYakin[key] !== undefined && typeof enYakin[key] === 'number') {
                        enYakin[key] = Math.max(0, enYakin[key] - 150);
                        hasarVerildi = true;
                        break;
                    }
                }
            }

            // IŞIN
            const benScreen = worldToScreen(ben.x, ben.y);
            if (benScreen) {
                const uzunluk = Math.sqrt(Math.pow(screenPos.x - benScreen.x, 2) + Math.pow(screenPos.y - benScreen.y, 2));
                const acı = Math.atan2(screenPos.y - benScreen.y, screenPos.x - benScreen.x);
                
                const line = document.createElement('div');
                line.className = 'veck-magic-line';
                line.style.left = benScreen.x + 'px';
                line.style.top = benScreen.y + 'px';
                line.style.width = uzunluk + 'px';
                line.style.transform = `rotate(${acı}rad)`;
                line.style.transformOrigin = '0 0';
                line.style.background = `linear-gradient(90deg, #ff00ff, #8a2be288, #4a008044, transparent)`;
                line.style.boxShadow = '0 0 50px #ff00ff, 0 0 100px rgba(255,0,255,0.1)';
                line.style.height = '4px';
                document.body.appendChild(line);
                setTimeout(() => line.remove(), 500);

                // HIT YAZISI
                const hit = document.createElement('div');
                hit.className = 'veck-magic-hit';
                hit.textContent = `💥 ${hedefIsim} -150 HP`;
                hit.style.left = (screenPos.x - 70) + 'px';
                hit.style.top = (screenPos.y - 50) + 'px';
                hit.style.fontSize = '28px';
                hit.style.color = '#ff00ff';
                hit.style.textShadow = '0 0 80px #ff00ff, 0 0 160px rgba(255,0,255,0.2)';
                document.body.appendChild(hit);
                setTimeout(() => hit.remove(), 700);

                // PARÇACIKLAR
                for (let i = 0; i < 20; i++) {
                    const acıRast = Math.random() * Math.PI * 2;
                    const uzaklıkRast = 40 + Math.random() * 80;
                    const parcacık = document.createElement('div');
                    parcacık.style.cssText = `
                        position: fixed;
                        left: ${screenPos.x + Math.cos(acıRast) * uzaklıkRast - 4}px;
                        top: ${screenPos.y + Math.sin(acıRast) * uzaklıkRast - 4}px;
                        width: ${4 + Math.random() * 8}px;
                        height: ${4 + Math.random() * 8}px;
                        background: radial-gradient(circle, ${['#ff00ff','#8a2be2','#4a0080','#ff66ff','#d9b3ff'][Math.floor(Math.random()*5)]}, transparent);
                        border-radius: 50%;
                        pointer-events: none;
                        z-index: 9996;
                        box-shadow: 0 0 ${20 + Math.random() * 40}px #ff00ff;
                        animation: magicPulse ${0.2 + Math.random() * 0.5}s ease-out forwards;
                    `;
                    document.body.appendChild(parcacık);
                    setTimeout(() => parcacık.remove(), 800);
                }

                magicKullanım++;
                if (hasarVerildi) {
                    showNotification(`✨ Magic Bullet isabet! ${hedefIsim} (-150 HP)`, 'success');
                }
            }
        } catch(e) {}
    }

    // ============================================
    // BİLDİRİM SİSTEMİ
    // ============================================
    
    function showNotification(message, type = 'info') {
        try {
            const existing = document.querySelector('.veck-notification');
            if (existing) existing.remove();
            
            const notif = document.createElement('div');
            notif.className = `veck-notification ${type}`;
            notif.textContent = message;
            document.body.appendChild(notif);
            
            setTimeout(() => {
                notif.style.opacity = '0';
                notif.style.transition = 'opacity 0.4s ease';
                setTimeout(() => {
                    if (notif.parentNode) notif.remove();
                }, 400);
            }, 3000);
        } catch(e) {}
    }

