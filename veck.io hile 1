    // BENİM POZİSYONUM
    // ============================================
    
    function benimPozisyonum() {
        try {
            const kaynaklar = [
                window.player,
                window.game?.player,
                window.me,
                window.localPlayer,
                window.self,
                window.game?.localPlayer,
                window.game?.self,
                window.game?.scene?.player
            ];
            
            for (const kaynak of kaynaklar) {
                if (kaynak) {
                    const pos = oyuncuPozisyonu(kaynak);
                    if (pos) return pos;
                }
            }
            return { x: 0, y: 0 };
        } catch(e) { return { x: 0, y: 0 }; }
    }

    // ============================================
    // WORLD TO SCREEN
    // ============================================
    
    function worldToScreen(worldX, worldY) {
        try {
            const canvas = document.querySelector('canvas');
            if (!canvas) return { x: worldX, y: worldY };
            
            const rect = canvas.getBoundingClientRect();
            let cameraX = 0, cameraY = 0, zoom = 1;
            
            const kameralar = [
                window.camera,
                window.game?.camera,
                window.scene?.camera,
                window.scene?.cameras?.main,
                window.scene?.cameras?.default,
                window.game?.scene?.camera,
                window.game?.scene?.cameras?.main
            ];
            
            for (const kamera of kameralar) {
                if (kamera) {
                    if (kamera.x !== undefined) cameraX = parseFloat(kamera.x);
                    if (kamera.y !== undefined) cameraY = parseFloat(kamera.y);
                    if (kamera.zoom !== undefined) zoom = parseFloat(kamera.zoom);
                    break;
                }
            }
            
            const w = rect.width || window.innerWidth;
            const h = rect.height || window.innerHeight;
            
            return {
                x: (worldX - cameraX) * zoom + w / 2 + rect.left,
                y: (worldY - cameraY) * zoom + h / 2 + rect.top
            };
        } catch(e) {
            return { x: worldX, y: worldY };
        }
    }

    // ============================================
    // MESAFE HESAPLA
    // ============================================
    
    function mesafeHesapla(pos1, pos2) {
        if (!pos1 || !pos2) return 0;
        const dx = (pos1.x || 0) - (pos2.x || 0);
        const dy = (pos1.y || 0) - (pos2.y || 0);
        return Math.sqrt(dx*dx + dy*dy);
    }

