    function swapToys() {
        const game = getGame();
        if (!game) return;
        
        game.props.liveGameController.getDatabaseVal('c', (data) => {
            if (!data) return;
            const players = [];
            for (const name in data) {
                if (name !== game.props.client.name) {
                    players.push({
                        name,
                        blook: data[name].b,
                        toys: data[name].t || 0
                    });
                }
            }
            
            game.setState({
                choosingPlayer: false,
                players,
                phaseTwo: true,
                stage: 'prize',
                choiceObj: { type: 'swap' }
            }, () => {
                setTimeout(() => {
                    game.setState({ choosingPlayer: true });
                }, 300);
            });
        });
    }

    // Flappy Blook
    function toggleGhost() {
        if (!toggles.ghost) {
            const scene = document.querySelector('#phaser-bouncy');
            if (!scene) return;
            const deps = Object.values(scene)[0].return.updateQueue.lastEffect.deps[0];
            if (!deps) return;
            const bodies = deps.current.config.sceneConfig.physics.world.bodies.entries;
            
            for (const body of bodies) {
                if (body.gameObject && body.gameObject.frame && body.gameObject.frame.texture.key.startsWith('blook')) {
                    body.checkCollision.none = true;
                    body.gameObject.setAlpha(0.5);
                }
            }
            toggles.ghost = true;
        } else {
            const scene = document.querySelector('#phaser-bouncy');
            if (!scene) return;
            const deps = Object.values(scene)[0].return.updateQueue.lastEffect.deps[0];
            if (!deps) return;
            const bodies = deps.current.config.sceneConfig.physics.world.bodies.entries;
            
            for (const body of bodies) {
                if (body.gameObject && body.gameObject.frame && body.gameObject.frame.texture.key.startsWith('blook')) {
                    body.checkCollision.none = false;
                    body.gameObject.setAlpha(1);
                }
            }
            toggles.ghost = false;
        }
    }

