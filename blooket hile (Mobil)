    // Crazy Kingdom
    function toggleChoiceESPKingdom() {
        if (!toggles.choiceESPKingdom) {
            toggles.choiceESPKingdom = setInterval(() => {
                try {
                    const game = getGame();
                    if (!game || game.state.phase !== 'choice') return;
                    
                    const statContainers = document.querySelectorAll('[class*=statContainer]');
                    const statMap = {};
                    const keys = ['materials', 'people', 'happiness', 'gold'];
                    for (let i = 0; i < statContainers.length && i < keys.length; i++) {
                        statMap[keys[i]] = statContainers[i];
                    }
                    
                    for (const label of document.querySelectorAll('.choiceESP')) {
                        label.remove();
                    }
                    
                    if (game.state.guest && game.state.guest.yes) {
                        for (const [key, value] of Object.entries(game.state.guest.yes)) {
                            if (statMap[key]) {
                                const label = document.createElement('div');
                                label.className = 'choiceESP';
                                label.style.cssText = 'font-size: 24px; color: rgb(75, 194, 46); font-weight: bolder;';
                                label.textContent = String(value);
                                statMap[key].appendChild(label);
                            }
                        }
                    }
                    
                    if (game.state.guest && game.state.guest.no) {
                        for (const [key, value] of Object.entries(game.state.guest.no)) {
                            if (statMap[key]) {
                                const label = document.createElement('div');
                                label.className = 'choiceESP';
                                label.style.cssText = 'font-size: 24px; color: darkred; font-weight: bolder;';
                                label.textContent = String(value);
                                statMap[key].appendChild(label);
                            }
                        }
                    }
                    
                    for (const btn of document.querySelectorAll('[class*=guestButton][role=button]')) {
                        btn.onclick = () => {
                            for (const label of document.querySelectorAll('.choiceESP')) {
                                label.remove();
                            }
                        };
                    }
                } catch (e) {}
            }, 50);
        } else {
            clearInterval(toggles.choiceESPKingdom);
            toggles.choiceESPKingdom = null;
            for (const label of document.querySelectorAll('.choiceESP')) {
                label.remove();
            }
        }
    }

