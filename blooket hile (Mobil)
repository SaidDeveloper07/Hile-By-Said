                try {
                    const game = getGame();
                    if (!game || game.state.stage !== 'prize') return;
                    
                    game.props.liveGameController.getDatabaseVal('c', (data) => {
                        try {
                            if (!data) return;
                            const players = Object.entries(data);
                            let maxGold = 0;
                            let bestIndex = -1;
                            
                            for (let i = 0; i < players.length; i++) {
                                if (players[i][0] !== game.props.client.name && players[i][1] > maxGold) {
                                    maxGold = players[i][1];
                                }
                            }
                            
                            let bestValue = -1;
                            for (let i = 0; i < game.state.choices.length; i++) {
                                const choice = game.state.choices[i];
                                let value = game.state.gold;
                                if (choice.type === 'gold') {
                                    value = game.state.gold + choice.val || game.state.gold;
                                } else if (choice.type === 'multiply' || choice.type === 'divide') {
                                    value = Math.round(game.state.gold * choice.val) || game.state.gold;
                                } else if (choice.type === 'swap') {
                                    value = maxGold || game.state.gold;
                                } else if (choice.type === 'take') {
                                    value = game.state.gold + maxGold * choice.val || game.state.gold;
                                }
                                if (value > bestValue) {
                                    bestValue = value;
                                    bestIndex = i + 1;
                                }
                            }
                            
                            const btn = document.querySelector(`div[class*='choice${bestIndex}']`);
                            if (btn) btn.click();
                        } catch (e) {}
                    });
                } catch (e) {}
            }, 50);
