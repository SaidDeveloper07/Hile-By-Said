    function toggleRockESP() {
        const superscripts = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
        const toSuperscript = (num) => {
            let result = '';
            while (num > 0) {
                result = superscripts[num % 10] + result;
                num = Math.floor(num / 10);
            }
            return result;
        };
        
        const fossils = [
            { type: 'fossil', val: 10, rate: 0.1, blook: 'Amber' },
            { type: 'fossil', val: 25, rate: 0.1, blook: 'Dino Egg' },
            { type: 'fossil', val: 50, rate: 0.175, blook: 'Dino Fossil' },
            { type: 'fossil', val: 75, rate: 0.175, blook: 'Stegosaurus' },
            { type: 'fossil', val: 100, rate: 0.15, blook: 'Velociraptor' },
            { type: 'fossil', val: 125, rate: 0.125, blook: 'Brontosaurus' },
            { type: 'fossil', val: 250, rate: 0.075, blook: 'Triceratops' },
            { type: 'fossil', val: 500, rate: 0.025, blook: 'Tyrannosaurus Rex' },
            { type: 'mult', val: 1.5, rate: 0.05 },
            { type: 'mult', val: 2, rate: 0.025 }
        ];
        
        function randChoices(count) {
            const result = [];
            while (result.length < count) {
                const r = Math.random();
                let cumulative = 0;
                let choice = null;
                for (const f of fossils) {
                    cumulative += f.rate;
                    if (cumulative >= r) {
                        choice = f;
                        break;
                    }
                }
                if (choice && !result.includes(choice)) {
                    result.push(choice);
                }
            }
            return result;
        }
        
        function formatNumber(num) {
            if (num < 1000) return num.toString();
            const units = ['', 'K', 'M', 'B', 'T'];
            const magnitude = Math.floor(Math.log10(num) / 3);
            if (magnitude < units.length) {
                let precision = 3;
                let formatted = (num / Math.pow(1000, magnitude)).toPrecision(precision);
                if (Number(formatted) % 1 !== 0) {
                    formatted = Number(formatted).toFixed(1);
                }
                return formatted + units[magnitude];
            } else {
                let n = num;
                let digits = 0;
                while (n >= 100) {
                    n = Math.floor(n / 10);
                    digits++;
                }
                return (n / 10) + ' × 10' + toSuperscript(digits + 1);
            }
        }
        
        if (!toggles.rockESP) {
            toggles.rockESP = setInterval(() => {
                try {
                    const game = getGame();
                    if (!game) return;
                    
                    const rockContainer = document.querySelector('[class*="rockButton"]');
                    if (!rockContainer) return;
                    const rocks = rockContainer.parentElement.children;
                    
