                }
            }
            yield* originalIterator.apply(this);
        };
        
        const game = getGame();
        if (game && game.constructor && game.constructor.prototype) {
            game.constructor.prototype.answerNext.call({
                nextReady: true,
                here: true,
                state: { correct: true },
                setState: function() {}
            });
        }
    }

