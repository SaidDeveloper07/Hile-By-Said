                    game.setState({
                        choices: randChoices(3)
                    }, () => {
                        for (let i = 0; i < rocks.length; i++) {
                            const choice = game.state.choices[i];
                            const rock = rocks[i];
                            const existing = rock.querySelector('div');
                            if (existing) existing.remove();
                            
                            const label = document.createElement('div');
                            label.style.cssText = `
                                color: white;
                                font-family: Macondo, sans-serif;
                                font-size: 1em;
                                display: flex;
                                justify-content: center;
                                transform: translateY(25px);
                            `;
                            
                            if (choice.type === 'fossil') {
                                const amount = Math.round(choice.val * game.state.fossilMult);
                                label.textContent = `+${formatNumber(amount)} Fosiller`;
                            } else {
                                label.textContent = `x${choice.val} Fosiller/Kazı`;
                            }
                            rock.appendChild(label);
                        }
                    });
                } catch (e) {}
            }, 50);
        } else {
            clearInterval(toggles.rockESP);
            toggles.rockESP = null;
            for (const label of document.querySelectorAll('[class*="rockButton"] > div')) {
                label.remove();
            }
        }
    }

