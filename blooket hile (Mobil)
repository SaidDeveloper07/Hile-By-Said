        }
        if (!game.data) {
            const orig = Object.keys;
            game.data = {};
            Object.keys = function(obj) {
                if (obj.Chick) {
                    game.data = obj;
                    Object.keys = orig;
                    return orig.apply(this, arguments);
                }
                return orig.apply(this, arguments);
            };
            game.render();
        }
        if (isLobby) {
            game.setState({ unlocks: Object.keys(game.data) });
        } else {
            const bd = {};
            const sets = [];
            for (const [key, val] of Object.entries(game.data)) {
                bd[key] = game.state.blookData[key] || 1;
                if (val.set && !sets.includes(val.set)) sets.push(val.set);
            }
            game.setState({ blookData: bd, allSets: sets });
        }
        showNotification('🌈 Herhangi bir blook kullanılabilir!', 'success');
    }

    function sellDuplicateBlooks() {
        if (!window.location.pathname.startsWith('/blooks')) {
            showNotification('❌ Bu sadece Blook sayfasında çalışır!', 'error');
            return;
        }
        if (!confirm('💰 Çift blookları satmak istediğinize emin misiniz?')) return;
        const game = getStateNode();
        if (!game) return;
        const results = {};
        const start = Date.now();
        (async function() {
            for (const blook in game.state.blookData) {
                if (game.state.blookData[blook] > 1) {
                    game.setState({ blook, numToSell: game.state.blookData[blook] - 1 });
                    const rarityEl = document.querySelector('[class*="highlightedRarity"]');
                    if (!rarityEl) continue;
                    const rarity = rarityEl.innerText.trim();
                    if (!['Uncommon', 'Rare', 'Epic'].includes(rarity)) continue;
                    results[blook] = game.state.blookData[blook] - 1;
                    await game.sellBlook({ preventDefault: () => {} }, true);
                }
            }
            let msg = `⏱️ (${Date.now() - start}ms) Sonuçlar:\n`;
            for (const [name, count] of Object.entries(results)) {
                msg += `    ${name} ${count}\n`;
            }
            alert(msg.trim() || 'Satılacak blook yok!');
            showNotification('💰 Çift blooklar satıldı!', 'success');
        })();
    }

