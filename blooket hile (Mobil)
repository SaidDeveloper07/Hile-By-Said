    function sendGlitch() {
        const glitches = {
            lb: 'Lunch Break',
            as: 'Ad Spam',
            e37: 'Error 37',
            nt: 'Night Time',
            lo: '#LOL',
            j: 'Jokester',
            sm: 'Slow Mo',
            dp: 'Dance Party',
            v: 'Vortex',
            r: 'Reverse',
            f: 'Flip',
            m: 'Micro'
        };
        const keys = Object.keys(glitches);
        const key = keys[Math.floor(Math.random() * keys.length)];
        const game = getGame();
        if (!game) return;
        game.safe = true;
        game.props.liveGameController.setVal({
            path: `c/${game.props.client.name}/tat`,
            val: key
        });
        alert(`${glitches[key]} glitch gönderildi!`);
    }

