        if (!game) return;
        for (const duck of game.ducks) {
            game.tiles[duck.y][duck.x] = 0;
        }
        game.ducks.length = 0;
    }

    function removeEnemies() {
        const game = getGame();
        if (game) {
            game.enemies = [];
            game.futureEnemies = [];
        }
    }

    function removeObstaclesDefense() {
        const game = getGame();
        if (game && game.tiles) {
            game.tiles = game.tiles.map(row => row.fill(0));
        }
    }

    function setDamage() {
        const damage = parseInt(prompt('Kaç hasar?')) || 0;
        const game = getGame();
        if (game) {
            game.dmg = damage;
        }
    }

