    // Toggle fonksiyonları
    function toggleAutoAnswer() {
        // Otomatik cevap toggle
        if (!toggles.autoAnswer) {
            toggles.autoAnswer = setInterval(() => {
                try {
                    const game = getGame();
                    if (!game) return;
                    const question = game.state.question || game.props.client.question;
                    if (!question) return;
                    
                    if (game.state.stage === 'feedback' || game.state.feedback) {
                        const feedback = document.querySelector('[class*="feedback"], [id*="feedback"]');
                        if (feedback && feedback.firstChild) feedback.firstChild.click();
                    } else if (question.qType === 'typing') {
                        const wrapper = document.querySelector('[class*="typingAnswerWrapper"]');
                        if (wrapper && wrapper.children && wrapper.children._owner) {
                            wrapper.children._owner.stateNode.sendAnswer(question.answers[0]);
                        }
                    } else {
                        let correctIndex = 0;
                        for (let i = 0; i < question.answers.length; i++) {
                            if (question.correctAnswers.includes(question.answers[i])) {
                                correctIndex = i;
                                break;
                            }
                        }
                        const containers = document.querySelectorAll('[class*="answerContainer"]');
                        if (containers[correctIndex]) containers[correctIndex].click();
                    }
                } catch (e) {}
            }, 50);
        } else {
            clearInterval(toggles.autoAnswer);
            toggles.autoAnswer = null;
        }
        // Buton rengini güncelle
        const btn = folders.global.content.querySelector('button');
        if (btn) btn.style.background = toggles.autoAnswer ? '#47A547' : '#6a1b8a';
    }

