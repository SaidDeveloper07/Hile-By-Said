    // Cafe
    function maxItems() {
        if (!window.location.pathname.startsWith('/cafe/shop')) {
            alert('Bu sadece mağaza sayfasında çalışır!');
            return;
        }
        const game = getGame();
        if (!game) return;
        const items = {};
        for (const key in game.state.items) {
            items[key] = 5;
        }
        game.setState({ items });
    }

    function removeCustomers() {
        const game = getGame();
        if (!game) return;
        for (let i = 0; i < game.state.customers.length; i++) {
            setTimeout(() => {
                if (game.state.customers[i] && game.state.customers[i].blook) {
                    game.removeCustomer(i, true);
                }
            }, 250 * i);
        }
    }

    function resetAbilities() {
        if (!window.location.pathname.startsWith('/cafe/shop')) {
            alert('Bu sadece mağaza sayfasında çalışır!');
            return;
        }
        const game = getGame();
        if (!game) return;
        const abilities = {};
        for (const key in game.state.abilities) {
            abilities[key] = 5;
        }
        game.setState({ abilities });
    }

    function setCash() {
        const amount = parseInt(prompt('Kaç nakit istersiniz?')) || 0;
        const game = getGame();
        if (game) {
            game.setState({ cafeCash: amount });
            game.props.liveGameController.setVal({
                path: `c/${game.props.client.name}/ca`,
                val: amount
            });
        }
    }

    function stockFood() {
        if (window.location.pathname.startsWith('/cafe/shop')) {
            alert('Bu mağazada çalışmaz!');
            return;
        }
        const game = getGame();
        if (!game) return;
        game.setState({
            foods: game.state.foods.map(food => ({
                ...food,
                stock: 99,
                level: 5
            }))
        });
    }

