        });
        
        const emptyTiles = [];
        for (let y = 0; y < game.tiles.length; y++) {
            for (let x = 0; x < game.tiles[y].length; x++) {
                if (game.tiles[y][x] === 3) {
                    game.tiles[y][x] = 0;
                } else if (game.tiles[y][x] === 0) {
                    emptyTiles.push({ x, y });
                }
            }
        }
        
        emptyTiles.sort(() => Math.random() - Math.random());
        
        for (const tower of game.towers) {
            const pos = emptyTiles.pop();
            if (pos) {
                tower.move(pos.x, pos.y, game.tileSize);
                game.tiles[pos.y][pos.x] = 3;
            }
        }
    }

