            const target = e.target;
            if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.tagName === 'SELECT')) return;
            e.preventDefault();
            panel.style.display = panel.style.display === 'none' ? '' : 'none';
