                } else {
                    if (onAction) onAction();
                    this.classList.remove('toggle-off');
                    this.classList.add('toggle-on');
                    this.querySelector('.btn-status').textContent = 'ON';
                    window.saidToggles[toggleKey] = true;
                    showNotification(`✅ ${name} aktif`, 'success');
                }
            } catch (err) {
                console.error('Toggle error:', err);
