    function percentAutoAnswer() {
        const goal = parseFloat(prompt('Hedef yüzde kaç? (0-100)'));
        if (isNaN(goal) || goal < 0 || goal > 100) return;
        const target = goal / 100;
        
        if (!toggles.percentAuto) {
            toggles.percentAuto = setInterval(() => {
                try {
                    const game = getGame();
                    if (!game) return;
                    
                    if (game.state.stage === 'feedback' || game.state.feedback) {
                        const feedback = document.querySelector('[class*="feedback"], [id*="feedback"]');
                        if (feedback && feedback.firstChild) feedback.firstChild.click();
                        return;
                    }
                    
                    const question = game.state.question || game.props.client.question;
                    if (!question) return;
                    
                    let correct = 0;
                    let incorrect = 0;
                    for (const key in game.corrects) correct += game.corrects[key];
                    for (const key in game.incorrects) incorrect += game.incorrects[key];
                    const total = correct + incorrect;
                    const currentRate = total === 0 ? 0 : correct / total;
                    
                    const shouldBeCorrect = Math.abs(currentRate - target) >= Math.abs((correct + 1) / (total + 1) - target);
                    
                    if (question.qType === 'typing') {
                        const wrapper = document.querySelector('[class*="typingAnswerWrapper"]');
                        if (wrapper && wrapper.children && wrapper.children._owner) {
                            wrapper.children._owner.stateNode.sendAnswer(shouldBeCorrect ? question.answers[0] : Math.random().toString(36).substring(2));
                        }
                    } else {
                        const containers = document.querySelectorAll('[class*="answerContainer"]');
                        for (let i = 0; i < containers.length; i++) {
                            if (shouldBeCorrect === question.correctAnswers.includes(question.answers[i])) {
                                containers[i].click();
                                return;
                            }
                        }
                        if (containers[0]) containers[0].click();
                    }
                } catch (e) {}
            }, 100);
        } else {
            clearInterval(toggles.percentAuto);
            toggles.percentAuto = null;
        }
    }

