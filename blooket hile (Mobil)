    function togglePercentAuto() {
        const target = prompt('🎯 Hedef yüzde kaç? (0-100)');
        if (target === null) return false;
        const goal = parseFloat(target);
        if (isNaN(goal) || goal < 0 || goal > 100) {
            showNotification('❌ Geçersiz değer!', 'error');
            return false;
        }
        const TARGET = goal / 100;
        
        if (!window.saidToggles.percentAuto) {
            window.saidToggles.percentAuto = setInterval(() => {
                try {
                    const game = getStateNode();
                    if (!game) return;
                    if (game.state.stage === 'feedback' || game.state.feedback) {
                        const fb = document.querySelector('[class*="feedback"], [id*="feedback"]');
                        if (fb && fb.firstChild) fb.firstChild.click();
                        return;
                    }
                    const q = game.state.question || game.props.client.question;
                    if (!q) return;
                    
                    let correct = 0, incorrect = 0;
                    for (const k in game.corrects) correct += game.corrects[k];
                    for (const k in game.incorrects) incorrect += game.incorrects[k];
                    const total = correct + incorrect;
                    const current = total === 0 ? 0 : correct / total;
                    const shouldBeCorrect = Math.abs(current - TARGET) >= Math.abs((correct + 1) / (total + 1) - TARGET);
                    
                    if (q.qType === 'typing') {
                        const w = document.querySelector('[class*="typingAnswerWrapper"]');
                        if (w && w.children && w.children._owner) {
                            w.children._owner.stateNode.sendAnswer(shouldBeCorrect ? q.answers[0] : Math.random().toString(36).substring(2));
                        }
                    } else {
                        const containers = document.querySelectorAll('[class*="answerContainer"]');
                        for (let i = 0; i < containers.length; i++) {
                            if (shouldBeCorrect === q.correctAnswers.includes(q.answers[i])) {
                                containers[i].click();
                                return;
                            }
                        }
                        if (containers[0]) containers[0].click();
                    }
                } catch (e) {}
            }, 100);
            return true;
        } else {
            clearInterval(window.saidToggles.percentAuto);
            window.saidToggles.percentAuto = false;
            return false;
        }
    }

