    // ----- KINGDOM (GÜNCELLENMİŞ) -----
    function toggleChoiceESPKingdom() {
        if (!window.saidToggles.choiceESPKingdom) {
            window.saidToggles.choiceESPKingdom = setInterval(() => {
                try {
                    const game = getStateNode();
                    if (!game || game.state.phase !== 'choice') return;
                    const containers = document.querySelectorAll('[class*=statContainer]');
                    const statMap = {};
                    const keys = ['materials','people','happiness','gold'];
                    for (let i = 0; i < containers.length && i < keys.length; i++) {
                        statMap[keys[i]] = containers[i];
                    }
                    for (const label of document.querySelectorAll('.choiceESP')) label.remove();
                    if (game.state.guest && game.state.guest.yes) {
                        for (const [key, val] of Object.entries(game.state.guest.yes)) {
                            if (statMap[key]) {
                                const label = document.createElement('div');
                                label.className = 'choiceESP';
                                label.style.cssText = 'font-size:24px;color:rgb(75,194,46);font-weight:bolder;text-shadow:0 0 20px rgba(75,194,46,0.5);';
                                label.textContent = '✅ +' + String(val);
                                statMap[key].appendChild(label);
                            }
                        }
                    }
                    if (game.state.guest && game.state.guest.no) {
                        for (const [key, val] of Object.entries(game.state.guest.no)) {
                            if (statMap[key]) {
                                const label = document.createElement('div');
                                label.className = 'choiceESP';
                                label.style.cssText = 'font-size:24px;color:#ff4444;font-weight:bolder;text-shadow:0 0 20px rgba(255,68,68,0.5);';
                                label.textContent = '❌ ' + String(val);
                                statMap[key].appendChild(label);
                            }
                        }
                    }
                    for (const btn of document.querySelectorAll('[class*=guestButton][role=button]')) {
                        btn.onclick = () => {
                            for (const label of document.querySelectorAll('.choiceESP')) label.remove();
                        };
                    }
                } catch (e) {}
            }, 50);
            return true;
        } else {
            clearInterval(window.saidToggles.choiceESPKingdom);
            window.saidToggles.choiceESPKingdom = false;
            for (const label of document.querySelectorAll('.choiceESP')) label.remove();
            return false;
        }
    }

