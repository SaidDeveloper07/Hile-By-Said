                return;
            }
            
            const count = Math.min(maxBoxes, parseInt(prompt('Kaç kasa açılsın?')) || 0);
            if (count <= 0) return;
            
            const showBlooks = confirm('Blookları göstersin mi?');
            const results = {};
            const startTime = Date.now();
            
            (async function openBoxes() {
                for (let i = 0; i < count; i++) {
                    await game.buyPack(true, formattedName);
                    results[game.state.unlockedBlook] = (results[game.state.unlockedBlook] || 0) + 1;
                    game.startOpening();
                    clearTimeout(game.openTimeout);
                    const rarity = game.state.purchasedBlookRarity;
                    game.setState({
                        canOpen: true,
                        currentPack: '',
