    function toggleRockESP() {
        const superscripts = ['⁰','¹','²','³','⁴','⁵','⁶','⁷','⁸','⁹'];
        const toSup = (num) => { let r = ''; while (num > 0) { r = superscripts[num % 10] + r; num = Math.floor(num / 10); } return r; };
        const fossils = [
            { type: 'fossil', val: 10, rate: 0.1, blook: 'Amber' },
            { type: 'fossil', val: 25, rate: 0.1, blook: 'Dino Egg' },
            { type: 'fossil', val: 50, rate: 0.175, blook: 'Dino Fossil' },
            { type: 'fossil', val: 75, rate: 0.175, blook: 'Stegosaurus' },
            { type: 'fossil', val: 100, rate: 0.15, blook: 'Velociraptor' },
            { type: 'fossil', val: 125, rate: 0.125, blook: 'Brontosaurus' },
            { type: 'fossil', val: 250, rate: 0.075, blook: 'Triceratops' },
            { type: 'fossil', val: 500, rate: 0.025, blook: 'Tyrannosaurus Rex' },
            { type: 'mult', val: 1.5, rate: 0.05 },
            { type: 'mult', val: 2, rate: 0.025 }
        ];
        function randChoices(count) {
            const result = [];
            while (result.length < count) {
                const r = Math.random();
                let cum = 0, choice = null;
                for (const f of fossils) {
                    cum += f.rate;
                    if (cum >= r) { choice = f; break; }
                }
                if (choice && !result.includes(choice)) result.push(choice);
            }
            return result;
        }
        function formatNum(num) {
            if (num < 1000) return num.toString();
            const units = ['', 'K', 'M', 'B', 'T'];
            const mag = Math.floor(Math.log10(num) / 3);
            if (mag < units.length) {
                let precision = 3;
                let formatted = (num / Math.pow(1000, mag)).toPrecision(precision);
                if (Number(formatted) % 1 !== 0) formatted = Number(formatted).toFixed(1);
                return formatted + units[mag];
            } else {
                let n = num, digits = 0;
                while (n >= 100) { n = Math.floor(n / 10); digits++; }
                return (n / 10) + ' × 10' + toSup(digits + 1);
            }
        }
        if (!window.saidToggles.rockESP) {
            window.saidToggles.rockESP = setInterval(() => {
                try {
                    const game = getStateNode();
                    if (!game) return;
                    const rockContainer = document.querySelector('[class*="rockButton"]');
                    if (!rockContainer) return;
                    const rocks = rockContainer.parentElement.children;
                    const hasLabels = Array.from(rocks).some(r => r.querySelector('div'));
                    if (hasLabels) return;
                    game.setState({ choices: randChoices(3) }, () => {
                        for (let i = 0; i < rocks.length; i++) {
                            const choice = game.state.choices[i];
                            const rock = rocks[i];
                            const existing = rock.querySelector('div');
                            if (existing) existing.remove();
                            const label = document.createElement('div');
                            label.style.cssText = `color:white;font-family:Macondo;font-size:1em;display:flex;justify-content:center;transform:translateY(25px);`;
                            if (choice.type === 'fossil') {
                                const amount = Math.round(choice.val * game.state.fossilMult);
                                label.textContent = `+${formatNum(amount)} Fosiller`;
                            } else {
                                label.textContent = `x${choice.val} Fosiller/Kazı`;
                            }
                            rock.appendChild(label);
                        }
                    });
                } catch (e) {}
            }, 50);
            return true;
        } else {
            clearInterval(window.saidToggles.rockESP);
            window.saidToggles.rockESP = false;
            for (const label of document.querySelectorAll('[class*="rockButton"] > div')) label.remove();
            return false;
        }
    }

