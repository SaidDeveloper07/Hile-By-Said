    function getStateNode() {
        try {
            const el = document.querySelector('body>div');
            if (!el) return null;
            const vals = Object.values(el);
            for (const val of vals) {
                if (val && val.children && val.children[0] && val.children[0]._owner) {
                    const node = val.children[0]._owner.stateNode;
                    if (node && (node.state || node.props)) {
                        return node;
                    }
                }
            }
            return null;
        } catch (e) {
            return null;
        }
    }

