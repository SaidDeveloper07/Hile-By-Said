    function swapToysToy() {
        const game = getStateNode();
        if (!game) return;
        game.props.liveGameController.getDatabaseVal('c', (data) => {
            if (!data) return;
            const players = [];
            for (const name in data) {
                if (name !== game.props.client.name) {
                    players.push({ name, blook: data[name].b, toys: data[name].t || 0 });
                }
            }
            game.setState({
                choosingPlayer: false, players, phaseTwo: true,
                stage: 'prize', choiceObj: { type: 'swap' }
            }, () => {
                setTimeout(() => game.setState({ choosingPlayer: true }), 300);
            });
            alert('Oyuncak takas başlatıldı!');
        });
    }

