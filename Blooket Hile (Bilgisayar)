    function toggleAutoChooseGold() {
        if (!window.saidToggles.autoChooseGold) {
            window.saidToggles.autoChooseGold = setInterval(async () => {
                try {
                    const game = getStateNode();
                    if (!game || game.state.stage !== 'prize') return;
                    game.props.liveGameController.getDatabaseVal('c', (data) => {
                        if (!data) return;
                        const players = Object.entries(data);
                        let maxGold = 0;
                        for (let i = 0; i < players.length; i++) {
                            if (players[i][0] !== game.props.client.name && players[i][1] > maxGold) {
                                maxGold = players[i][1];
                            }
                        }
                        let bestVal = -1, bestIdx = -1;
                        for (let i = 0; i < game.state.choices.length; i++) {
                            const c = game.state.choices[i];
                            let val = game.state.gold;
                            if (c.type === 'gold') val = game.state.gold + c.val || game.state.gold;
                            else if (c.type === 'multiply' || c.type === 'divide') val = Math.round(game.state.gold * c.val) || game.state.gold;
                            else if (c.type === 'swap') val = maxGold || game.state.gold;
                            else if (c.type === 'take') val = game.state.gold + maxGold * c.val || game.state.gold;
                            if (val > bestVal) { bestVal = val; bestIdx = i + 1; }
                        }
                        const btn = document.querySelector(`div[class*='choice${bestIdx}']`);
                        if (btn) btn.click();
                    });
                } catch (e) {}
            }, 50);
            return true;
        } else {
