            const deps = Object.values(scene)[0].return.updateQueue.lastEffect.deps[0];
            if (!deps) return false;
            const bodies = deps.current.config.sceneConfig.physics.world.bodies.entries;
            for (const body of bodies) {
                if (body.gameObject && body.gameObject.frame && body.gameObject.frame.texture.key.startsWith('blook')) {
                    body.checkCollision.none = true;
                    body.gameObject.setAlpha(0.5);
                }
            }
            window.saidToggles.ghostFlappy = true;
            return true;
        } else {
            const scene = document.querySelector('#phaser-bouncy');
