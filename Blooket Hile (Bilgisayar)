    function removeBadChoices() {
        const orig = Array.prototype[Symbol.iterator];
        Array.prototype[Symbol.iterator] = function*() {
            if (this[0] && this[0].type === 'gold') {
                for (let i = 0; i < this.length; i++) {
                    if (this[i].type === 'divide' || this[i].type === 'nothing') {
                        this.splice(i--, 1);
                    }
                }
            }
            yield* orig.apply(this);
        };
        const game = getStateNode();
        if (game && game.constructor && game.constructor.prototype) {
            game.constructor.prototype.answerNext.call({
                nextReady: true, here: true, state: { correct: true }, setState: function() {}
            });
        }
        alert('Kötü seçenekler kaldırıldı!');
    }

