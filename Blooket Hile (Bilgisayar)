    function spamBuyBlooks() {
        if (!window.location.pathname.startsWith('/market')) {
            alert('Bu sadece Market sayfasında çalışır!');
            return;
        }
        try {
            const game = getStateNode();
            if (!game) return;
            const packs = {};
            const wrappers = document.querySelectorAll('[class*="packsWrapper"] > div');
            for (const w of wrappers) {
                const img = w.querySelector('[class*="packImgContainer"] > img');
                if (img) {
                    const name = img.alt;
                    const bottom = w.querySelector('[class*="packBottom"]');
                    if (bottom) packs[name] = parseInt(bottom.textContent);
                }
            }
            const boxName = prompt('Hangi kasa açılsın?');
            if (!boxName) return;
            const formatted = boxName.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
            if (!packs[formatted]) { alert('Kasa bulunamadı!'); return; }
            const price = packs[formatted];
            const maxBoxes = Math.floor(game.state.tokens / price);
            if (maxBoxes <= 0) { alert('Yeterli token yok!'); return; }
            const count = Math.min(maxBoxes, parseInt(prompt('Kaç kasa açılsın?')) || 0);
            if (count <= 0) return;
            const show = confirm('Blookları göstersin mi?');
            const results = {};
            const start = Date.now();
            
            (async function() {
                for (let i = 0; i < count; i++) {
                    await game.buyPack(true, formatted);
                    results[game.state.unlockedBlook] = (results[game.state.unlockedBlook] || 0) + 1;
                    game.startOpening();
                    clearTimeout(game.openTimeout);
                    const rarity = game.state.purchasedBlookRarity;
                    game.setState({ canOpen: true, currentPack: '', opening: show, doneOpening: show, openPack: show });
                    clearTimeout(game.canOpenTimeout);
                    if (rarity === 'Chroma') break;
                }
                await new Promise(r => setTimeout(r, 100));
                let msg = `(${Date.now() - start}ms) Sonuçlar:\n`;
                for (const [name, count] of Object.entries(results)) {
                    msg += `    ${name} ${count}\n`;
                }
                alert(msg);
            })();
        } catch (e) {}
    }

