    function createCheatButton(name, action, icon = '▶', isToggle = false) {
        const btn = document.createElement('button');
        btn.className = `said-btn ${isToggle ? 'toggle-off' : ''}`;
        btn.innerHTML = `<span class="btn-icon">${icon}</span><span class="btn-label">${name}</span>`;
        if (isToggle) {
            btn.innerHTML += `<span class="btn-status">[OFF]</span>`;
        }
        btn.onclick = function(e) {
            e.stopPropagation();
            try {
                action.call(this);
            } catch (err) {
                console.error('Cheat error:', err);
            }
            if (isToggle) {
                const status = this.querySelector('.btn-status');
                if (status) {
                    const isOn = this.classList.contains('toggle-on');
                    status.textContent = isOn ? '[ON]' : '[OFF]';
                }
            }
        };
        return btn;
    }

    function createToggleButton(name, toggleKey, icon = '🔄', onAction, offAction) {
        const btn = document.createElement('button');
        btn.className = 'said-btn toggle-off';
        btn.innerHTML = `<span class="btn-icon">${icon}</span><span class="btn-label">${name}</span><span class="btn-status">[OFF]</span>`;
        
        btn.onclick = function(e) {
            e.stopPropagation();
            const isOn = this.classList.contains('toggle-on');
            
            try {
                if (isOn) {
                    if (offAction) offAction();
                    this.classList.remove('toggle-on');
                    this.classList.add('toggle-off');
                    this.querySelector('.btn-status').textContent = '[OFF]';
                    window.saidToggles[toggleKey] = false;
                } else {
                    if (onAction) onAction();
                    this.classList.remove('toggle-off');
                    this.classList.add('toggle-on');
                    this.querySelector('.btn-status').textContent = '[ON]';
                    window.saidToggles[toggleKey] = true;
                }
            } catch (err) {
                console.error('Toggle error:', err);
            }
        };
        return btn;
    }

